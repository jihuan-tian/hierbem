                              ky_map_from_local_to_full_dof_indices,
                              kx_dof_i2e_numbering,
                              ky_dof_i2e_numbering,
                              mappings,
                              material_id_to_mapping_index,
                              global_to_local_cell_index_map,
                              mapping_support_point_table,
                              scratch_data,
                              copy_data);

