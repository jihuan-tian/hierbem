                                              &material_id_to_mapping_index,
  const std::vector<types::global_cell_index> &global_to_local_cell_index_map,
  const Table<
    2,
    Point<spacedim,
          typename numbers::NumberTraits<KernelNumberType>::real_type>>
    &mapping_support_point_table,
  PairCellWiseScratchDataForHMatrixFarField<dim, spacedim, KernelNumberType>
                                         &scratch_data,
  PairCellWisePerTaskData<dim, spacedim> &copy_data)
{
  static_assert(is_number_larger_or_equal<RangeNumberType, KernelNumberType>());
  static_assert(
    std::is_same<
      typename numbers::NumberTraits<RangeNumberType>::real_type,
      typename numbers::NumberTraits<KernelNumberType>::real_type>::value);

