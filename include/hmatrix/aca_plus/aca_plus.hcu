              continue;
            }
          else
            {
              /**
               * When the extracted row vector is not zero-valued, it is a
               * valid choice. Hence, return the selected row index.
               */
              return next_ref_row_index;
            }
        }
      else
        {
          if (size(remaining_row_indices) == 1)
