#ifndef HIERBEM_INCLUDE_HELMHOLTZ_HELMHOLTZ_ACOUSTIC_BEM_PRIV_H_
#define HIERBEM_INCLUDE_HELMHOLTZ_HELMHOLTZ_ACOUSTIC_BEM_PRIV_H_

#include <deal.II/base/exceptions.h>
