#include <deal.II/numerics/data_out.h>
#include <deal.II/numerics/vector_tools.h>
#include <deal.II/numerics/vector_tools_interpolate.templates.h>

#include <algorithm>
#include <fstream>
#include <iostream>
#include <iterator>
#include <memory>
#include <set>
#include <string>
#include <type_traits>
#include <vector>

#include "bem/bem_bilinear_form.h"
#include "bem/bem_function_space.h"
#include "bem/bem_general.h"
#include "bem/bem_tools.h"
#include "bem/types.h"
#include "cad_mesh/gmsh_manipulation.h"
#include "cad_mesh/subdomain_topology.h"
#include "config.h"
#include "config_file/config_structs.h"
#include "cuda_complex.hcu"
#include "helmholtz_acoustic_bem.h"
#include "hmatrix/aca_plus/aca_plus.hcu"
#include "hmatrix/hblockmatrix_skew_symm.h"
#include "hmatrix/hmatrix.h"
#include "hmatrix/hmatrix_vmult_strategy.h"
#include "hmatrix/preconditioner/hblockmatrix_skew_symm_preconditioner.h"
#include "hmatrix/preconditioner/hmatrix_symm_preconditioner.h"
#include "linear_algebra/cu_table.hcu"
#include "linear_algebra/lapack_full_matrix_ext.h"
#include "mapping/mapping_info.h"
#include "platform_shared/helmholtz_acoustic_kernels.h"
#include "postprocessing/data_out_ext.h"
#include "preconditioners/preconditioner_for_helmholtz_acoustic_hyper_singular_bio.h"
#include "preconditioners/preconditioner_for_helmholtz_acoustic_single_layer_bio.h"
#include "preconditioners/preconditioner_type.h"
#include "solvers/solve_hblockmatrix_skew_symm.h"
#include "solvers/solver_bicgstab_general.h"
#include "solvers/solver_gmres_general.h"
#include "utilities/cu_profile.hcu"
#include "utilities/debug_tools.h"

HBEM_NS_OPEN

using namespace dealii;
using namespace HierBEM::PlatformShared::HelmholtzAcousticKernel;

template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
class HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::
  Priv
{
public:
  using real_type = typename numbers::NumberTraits<RangeNumberType>::real_type;
  // Here we define number types to be used on the device. When the original
  // number types are real values, they are the same on the device. When the
  // number types are complex values, we use our own complex type instead of
  // @p std::complex .
  using CUDAKernelNumberType =
    std::conditional_t<std::is_floating_point_v<KernelNumberType>,
                       KernelNumberType,
                       complex<real_type>>;
  using SearchableMaterialIdContainer =
    std::map<EntityTag, Function<spacedim, RangeNumberType> *>;

#pragma region ****Internal class ctor and dtor decls ****
  Priv(const ConfHelmholtzAcousticBEM &bem_params,
       const ConfSauterQuad           &sauter_quad_params,
       const ConfLinearSolver         &linear_solver_params);
  Priv(const ConfHelmholtzAcousticBEM   &bem_params,
       const ConfHMatrix                &hmat_params,
       const ConfHMatrix                &hmat_preconditioner_params,
       const ConfSauterQuad             &sauter_quad_params,
       const ConfSauterQuad             &sauter_quad_precond_params,
       const ConfLinearSolver           &linear_solver_params,
       const ConfOperatorPreconditioner &op_precond_params,
       const ConfParallelization        &parallel_params);
  ~Priv();

#pragma endregion

#pragma region ****Internal class public member function decls ****
  /*
  The actual implementations of HelmholtzAcousticBEM public member functions are
  placed here instead of in the HelmholtzAcousticBEM class itself, in order to
  prevent redudant indirect reference of private members through the private
  pointer.

  The corresponding public member functions in the HelmholtzAcousticBEM class
  are just wrappers to call the actual implementations in this class.
  */

  void
  extract_surface_triangulation(
    const Triangulation<dim + 1, spacedim> &volume_triangulation,
    Triangulation<dim, spacedim>          &&surf_tria,
    const bool                              debug = false);

  void
  setup_system();

  void
  assign_dirichlet_bc(Function<spacedim, RangeNumberType> &f,
                      const EntityTag                      surface_tag = -1);

  void
  assign_dirichlet_bc(Function<spacedim, RangeNumberType> &f,
                      const std::vector<EntityTag>        &surface_tags);

  void
  assign_neumann_bc(Function<spacedim, RangeNumberType> &f,
                    const EntityTag                      surface_tag = -1);

  void
  assign_neumann_bc(Function<spacedim, RangeNumberType> &f,
                    const std::vector<EntityTag>        &surface_tags);

  bool
  validate_subdomain_topology() const;

  void
  initialize_manifolds_from_manifold_description();

  void
  initialize_mappings();

  /**
   * Compute mapping support points and indices for active cells in the original
   * triangulation, which are used for assembling system matrices.
   */
  void
  compute_mapping_data_for_triangulation();

  /**
   * Release mapping support points and indices for active cells in the original
   * triangulation.
   */
  void
  release_mapping_data_for_triangulation();

  /**
   * Compute mapping support points and indices for active cells in the refined
   * triangulation, which are used for assembling operator preconditioners for
   * H-matrices.
   */
  void
  compute_mapping_data_for_refined_triangulation();

  /**
   * Release mapping support points and indices for active cells in the refined
   * triangulation.
   */
  void
  release_mapping_data_for_refined_triangulation();

  void
  interpolate_dirichlet_bc();

  void
  interpolate_neumann_bc();

  void
  assemble_full_matrix_system();

  void
  assemble_hmatrix_system();

  void
  assemble_hmatrix_preconditioner();

  void
  solve();

  void
  output_results() const;

  void
  output_results_on_target_tria(const std::string                  &vtk_file,
                                const Triangulation<dim, spacedim> &tria,
                                const unsigned int mapping_order) const;

  void
  output_results_on_target_tria(const std::string &vtk_file,
                                const Triangulation<dim + 1, spacedim> &tria,
                                const unsigned int mapping_order) const;

  void
  run();

  void
  print_memory_consumption_table(std::ostream &out) const;

#pragma endregion

private:
#pragma region ****Internal class private member function decls ****

  /**
   * Initialize the header string for each column.
   */
  void
  initialize_memory_consumption_table_headers();

  /**
   * Add a row to the memory consumption table.
   *
   * Memory consumption is measured in MB.
   *
   * @param name
   * @param obj
   */
  template <typename T>
  void
  add_memory_consumption_row(const std::string &name,
                             const T           &obj,
                             const std::string &comment = std::string(""));
#pragma endregion

#pragma region ****Internal class private member variable decls ****
  friend class HelmholtzAcousticBEM<dim,
                                    spacedim,
                                    RangeNumberType,
                                    KernelNumberType>;

  std::string project_name_;

  /**
   * Wave number
   */
  KernelNumberType kappa_;

  /**
   * Finite element order for the Dirichlet space.
   */
  unsigned int fe_order_for_dirichlet_space_;

  /**
   * Finite element order for the Neumann space.
   */
  unsigned int fe_order_for_neumann_space_;

  /**
   * Problem type to be solved.
   */
  ProblemType problem_type_;

  /**
   * Whether the problem is interior or exterior.
   */
  bool is_interior_problem_;

  /**
   * Triangulation for the surface mesh.
   */
  Triangulation<dim, spacedim> tria_;

  /**
   * Multigrid triangulation used in operator preconditioners.
   */
  Triangulation<dim, spacedim> mg_tria_for_preconditioner_;

  /**
   * A list of mapping objects from 1st to 3rd order.
   */
  std::vector<MappingInfo<dim, spacedim> *> mappings_;

  /**
   * Map surface entity tag to manifold id. At the moment, the material for
   * each surface is the same as the entity tag in Gmsh.
   */
  std::map<EntityTag, types::manifold_id> manifold_description_;

  /**
   * Map @p manifold_id to the pointer of a Manifold object.
   */
  std::map<types::manifold_id, Manifold<dim, spacedim> *> manifolds_;

  /**
   * Map @p manifold_id to mapping order.
   */
  std::map<types::manifold_id, unsigned int> manifold_id_to_mapping_order_;

  /**
   * Map @p material_id to mapping index.
   */
  std::map<types::material_id, unsigned int> material_id_to_mapping_index_;

  /**
   * A 2D table of mapping support points for all active cells on the highest
   * level in the triangulation. It is stored on the host.
   *
   * Dim1: cell index. Dim2: mapping support point index in a cell.
   */
  Table<2, Point<spacedim, real_type>> tria_mapping_support_points_cpu_;

  /**
   * A 2D table of mapping support points for all active cells on the highest
   * level in the triangulation. It is stored on the device.
   *
   * Dim1: cell index. Dim2: mapping support point index in a cell.
   */
  CUDAWrappers::CUDATable<2, Point<spacedim, real_type>>
    tria_mapping_support_points_gpu_;

  /**
   * A list of mapping indices for all active cells on the highest level in the
   * triangulation. It is stored on the host.
   */
  std::vector<unsigned int> tria_mapping_indices_cpu_;

  /**
   * A table of mapping indices for all active cells on the highest level in the
   * triangulation. It is stored on the device.
   */
  CUDAWrappers::CUDATable<1, unsigned int> tria_mapping_indices_gpu_;

  /**
   * A 2D table of mapping support points for all active cells on the highest
   * level in the multigrid triangulation. It is stored on the host.
   *
   * Dim1: cell index. Dim2: mapping support point index in a cell.
   */
  Table<2, Point<spacedim, real_type>> mg_tria_mapping_support_points_cpu_;

  /**
   * A 2D table of mapping support points for all active cells on the highest
   * level in the multigrid triangulation. It is stored on the device.
   *
   * Dim1: cell index. Dim2: mapping support point index in a cell.
   */
  CUDAWrappers::CUDATable<2, Point<spacedim, real_type>>
    mg_tria_mapping_support_points_gpu_;

  /**
   * A list of mapping indices for all active cells on the highest level in the
   * multigrid triangulation. It is stored on the host.
   */
  std::vector<unsigned int> mg_tria_mapping_indices_cpu_;

  /**
   * A table of mapping indices for all active cells on the highest level in the
   * multigrid triangulation. It is stored on the device.
   */
  CUDAWrappers::CUDATable<1, unsigned int> mg_tria_mapping_indices_gpu_;

  /**
   * Surface-to-volume and volume-to-surface relationship.
   */
  SubdomainTopology<dim, spacedim> subdomain_topology_;

  /**
   * Finite element \f$H^{\frac{1}{2}+s}\f$ for the Dirichlet space. At
   * present, it is implemented as a continuous Lagrange space.
   */
  FE_Q<dim, spacedim> fe_for_dirichlet_space_;
  /**
   * Finite element \f$H^{-\frac{1}{2}+s}\f$ for the Neumann space. At
   * present, it is implemented as a discontinuous Lagrange space.
   */
  FE_DGQ<dim, spacedim> fe_for_neumann_space_;

  /**
   * Definition of DoFHandlers for a series of combination of finite element
   * spaces and triangulations.
   */
  DoFHandler<dim, spacedim> dof_handler_for_dirichlet_space_;
  DoFHandler<dim, spacedim> dof_handler_for_neumann_space_;

  // Definition of smart pointers for BEM function spaces.
  std::unique_ptr<
    BEMFunctionSpace<dim, spacedim, SearchableMaterialIdContainer, real_type>>
    dirichlet_space_on_dirichlet_domain_;
  std::unique_ptr<
    BEMFunctionSpace<dim, spacedim, SearchableMaterialIdContainer, real_type>>
    dirichlet_space_on_neumann_domain_;
  std::unique_ptr<
    BEMFunctionSpace<dim, spacedim, SearchableMaterialIdContainer, real_type>>
    neumann_space_on_dirichlet_domain_;
  std::unique_ptr<
    BEMFunctionSpace<dim, spacedim, SearchableMaterialIdContainer, real_type>>
    neumann_space_on_neumann_domain_;

  // Definition of smart pointers for BEM bilinear forms.
  std::unique_ptr<BEMBilinearForm<dim,
                                  spacedim,
                                  SearchableMaterialIdContainer,
                                  SingleLayerKernel,
                                  RangeNumberType,
                                  KernelNumberType>>
    bV1_;
  std::unique_ptr<BEMBilinearForm<dim,
                                  spacedim,
                                  SearchableMaterialIdContainer,
                                  DoubleLayerKernel,
                                  RangeNumberType,
                                  KernelNumberType>>
    bK1_;
  std::unique_ptr<BEMBilinearForm<dim,
                                  spacedim,
                                  SearchableMaterialIdContainer,
                                  HyperSingularKernelRegular1,
                                  RangeNumberType,
                                  KernelNumberType>>
    bD1_part1_;
  std::unique_ptr<BEMBilinearForm<dim,
                                  spacedim,
                                  SearchableMaterialIdContainer,
                                  HyperSingularKernelRegular2,
                                  RangeNumberType,
                                  KernelNumberType>>
    bD1_part2_;
  std::unique_ptr<BEMBilinearForm<dim,
                                  spacedim,
                                  SearchableMaterialIdContainer,
                                  DoubleLayerKernel,
                                  RangeNumberType,
                                  KernelNumberType>>
    bI1K2_;
  std::unique_ptr<BEMBilinearForm<dim,
                                  spacedim,
                                  SearchableMaterialIdContainer,
                                  SingleLayerKernel,
                                  RangeNumberType,
                                  KernelNumberType>>
    bV2_;
  std::unique_ptr<BEMBilinearForm<dim,
                                  spacedim,
                                  SearchableMaterialIdContainer,
                                  HyperSingularKernelRegular1,
                                  RangeNumberType,
                                  KernelNumberType>>
    bD2_part1_;
  std::unique_ptr<BEMBilinearForm<dim,
                                  spacedim,
                                  SearchableMaterialIdContainer,
                                  HyperSingularKernelRegular2,
                                  RangeNumberType,
                                  KernelNumberType>>
    bD2_part2_;
  std::unique_ptr<BEMBilinearForm<dim,
                                  spacedim,
                                  SearchableMaterialIdContainer,
                                  AdjointDoubleLayerKernel,
                                  RangeNumberType,
                                  KernelNumberType>>
    bI2K_prime2_;

  /**
   * Full matrices for verification purpose.
   */
  LAPACKFullMatrixExt<RangeNumberType> V1_mat_;
  LAPACKFullMatrixExt<RangeNumberType> D1_mat_;
  LAPACKFullMatrixExt<RangeNumberType> D1_part2_mat_;
  LAPACKFullMatrixExt<RangeNumberType> I1K2_mat_;
  LAPACKFullMatrixExt<RangeNumberType> I2K_prime2_mat_;

  /**
   * Whether \hmatrix is used.
   */
  bool use_hmat_;

  /**
   * Whether run in a single thread on CPU.
   */
  bool cpu_serial_;

  /**
   * \hmatrices corresponding to discretized bilinear forms in the
   * mixed boundary value problem, which contain all possible cases.
   */
  std::unique_ptr<HMatrix<spacedim, RangeNumberType>> V1_hmat_;
  std::unique_ptr<HMatrix<spacedim, RangeNumberType>> K1_hmat_;
  std::unique_ptr<HMatrix<spacedim, RangeNumberType>> D1_hmat_;
  std::unique_ptr<HMatrix<spacedim, RangeNumberType>> D1_part2_hmat_;
  std::unique_ptr<HMatrix<spacedim, RangeNumberType>> V2_hmat_;
  std::unique_ptr<HMatrix<spacedim, RangeNumberType>> I1K2_hmat_;
  std::unique_ptr<HMatrix<spacedim, RangeNumberType>> I2K_prime2_hmat_;
  std::unique_ptr<HMatrix<spacedim, RangeNumberType>> D2_hmat_;
  std::unique_ptr<HMatrix<spacedim, RangeNumberType>> D2_part2_hmat_;
  std::unique_ptr<HBlockMatrixSkewSymm<spacedim, RangeNumberType>> M_hmat_;

  /**
   * H-matrix factorization based preconditioners.
   */
  HMatrixSymmPreconditioner<spacedim, RangeNumberType> V1_hmat_preconditioner_;
  HMatrixSymmPreconditioner<spacedim, RangeNumberType> D1_hmat_preconditioner_;
  HMatrixSymmPreconditioner<spacedim, RangeNumberType> M11_in_preconditioner_;
  HMatrix<spacedim, RangeNumberType>                   M12_in_preconditioner_;
  HMatrixSymmPreconditioner<spacedim, RangeNumberType> M22_in_preconditioner_;
  std::unique_ptr<HBlockMatrixSkewSymmPreconditioner<spacedim, RangeNumberType>>
    M_hmat_preconditioner_;

  ConfHMatrix                hmat_params_;
  ConfHMatrix                hmat_preconditioner_params_;
  ConfSauterQuad             sauter_quad_params_;
  ConfSauterQuad             sauter_quad_precond_params_;
  ConfLinearSolver           linear_solver_params_;
  ConfOperatorPreconditioner op_precond_params_;
  ConfParallelization        parallel_params_;

  /**
   * Map surface entity tag to Neumann boundary condition.
   */
  std::map<EntityTag, Function<spacedim, RangeNumberType> *>
    neumann_bc_definition_;

  /**
   * Neumann boundary condition data on all DoFs in the associated DoF
   * handler. When in the \hmat version, they are in the external DoF
   * numbering.
   */
  Vector<RangeNumberType> neumann_bc_;
  Vector<RangeNumberType> neumann_bc_on_selected_dofs_;
  /**
   * Neumann boundary condition data on all DoFs in the associated DoF handler
   * in the internal DoF numbering. Only used in the \hmat version.
   */
  Vector<RangeNumberType> neumann_bc_internal_dof_numbering_;

  /**
   * Map surface entity tag to Dirichlet boundary condition.
   */
  std::map<EntityTag, Function<spacedim, RangeNumberType> *>
    dirichlet_bc_definition_;

  /**
   * Dirichlet boundary condition data on all DoFs in the associated DoF
   * handler.
   */
  Vector<RangeNumberType> dirichlet_bc_;
  /**
   * Dirichlet boundary condition data on those selected DoFs in the
   * associated DoF handler. When in the \hmat version, they are in the
   * external DoF numbering.
   */
  Vector<RangeNumberType> dirichlet_bc_on_selected_dofs_;
  /**
   * Dirichlet boundary condition data on those selected DoFs in the
   * associated DoF handler in the internal DoF numbering. Only used in the
   * \hmat version.
   */
  Vector<RangeNumberType> dirichlet_bc_internal_dof_numbering_;

  /**
   * Right hand side vector on the Dirichlet domain. When in the \hmat
   * version, it is in the internal DoF numbering.
   */
  Vector<RangeNumberType> system_rhs_on_dirichlet_domain_;
  /**
   * Right hand side vector on the Neumann domain. When in the \hmat version,
   * it is in the internal DoF numbering.
   */
  Vector<RangeNumberType> system_rhs_on_neumann_domain_;
  /**
   * Right hand side vector on both the Dirichlet domain and Neumann domain.
   * Only used in the mixed boundary value problem and H-matrix factorization
   * based preconditioner is used.
   */
  Vector<RangeNumberType> system_rhs_on_combined_domain_;

  /**
   * Numerical solution on the Dirichlet domain for full matrix version or in
   * the external DoF numbering for the \hmat version.
   */
  Vector<RangeNumberType> neumann_data_;
  /**
   * Numerical solution on the Dirichlet domain in the internal DoF numbering.
   * Only used in the \hmat version.
   */
  Vector<RangeNumberType>
    neumann_data_on_dirichlet_domain_internal_dof_numbering_;
  /**
   * Numerical solution on the Neumann domain on all DoFs in the associated
   * DoF handler.
   */
  Vector<RangeNumberType> dirichlet_data_;
  /**
   * Numerical solution on the Neumann domain only on those selected DoFs in
   * the associated DoF handler. When in the \hmat version, they are in the
   * external DoF numbering.
   */
  Vector<RangeNumberType> dirichlet_data_on_neumann_domain_;
  Vector<RangeNumberType> neumann_data_on_dirichlet_domain_;
  /**
   * Numerical solution on the Neumann domain only on those selected DoFs in
   * the associated DoF handler in the internal DoF numbering. Only used in
   * the \hmat version.
   */
  Vector<RangeNumberType>
    dirichlet_data_on_neumann_domain_internal_dof_numbering_;
  /**
   * Solution vector on both the Dirichlet domain and Neumann domain. Only
   * used in the mixed boundary value problem and in the \hmat version.
   */
  Vector<RangeNumberType> solution_on_combined_domain_internal_dof_numbering_;

  /**
   * H-matrix vmult method used by iterative solvers.
   */
  IterativeSolverVmultType vmult_type_;

  /**
   * Type of the preconditioner.
   */
  PreconditionerType preconditioner_type_;

  /**
   * Operator preconditioner for the single layer potential boundary integral
   * operator, either on the whole domain or a subdomain.
   */
  std::unique_ptr<HelmholtzAcousticSingleLayerPreconditioner<dim,
                                                             spacedim,
                                                             RangeNumberType,
                                                             KernelNumberType>>
    op_precond_for_slp_;

  /**
   * Operator preconditioner for the hyper singular boundary integral operator,
   * either on the whole domain or a subdomain.
   */
  std::unique_ptr<
    HelmholtzAcousticHyperSingularPreconditioner<dim,
                                                 spacedim,
                                                 RangeNumberType,
                                                 KernelNumberType>>
    op_precond_for_hyper_singular_;

  /**
   * Memory consumption table
   */
  TableHandler memory_consumption_table_;
#pragma endregion

#pragma region ****Internal class friend function decls ****
  template <int dim1,
            int spacedim1,
            typename RangeNumberType1,
            typename MatrixType>
  friend void
  assemble_fem_scaled_mass_matrix(
    const DoFHandler<dim1, spacedim1> &dof_handler_for_test_space,
    const DoFHandler<dim1, spacedim1> &dof_handler_for_trial_space,
    const RangeNumberType1             factor,
    const Quadrature<dim1>            &quad_rule,
    MatrixType                        &target_full_matrix);

  template <int dim1,
            int spacedim1,
            typename RangeNumberType1,
            typename MatrixType>
  friend void
  assemble_fem_scaled_mass_matrix_serial(
    const DoFHandler<dim1, spacedim1> &dof_handler_for_test_space,
    const DoFHandler<dim1, spacedim1> &dof_handler_for_trial_space,
    const RangeNumberType1             factor,
    const Quadrature<dim1>            &quad_rule,
    MatrixType                        &target_full_matrix);

  template <int dim1,
            int spacedim1,
            template <int, typename>
            typename KernelFunctionType,
            typename KernelNumberType1,
            typename SurfaceNormalDetector,
            typename MatrixType>
  friend void
  assemble_bem_full_matrix(
    const KernelFunctionType<spacedim1, KernelNumberType1> &kernel,
    const KernelNumberType1                                 factor,
    const DoFHandler<dim1, spacedim1> &dof_handler_for_test_space,
    const DoFHandler<dim1, spacedim1> &dof_handler_for_trial_space,
    const std::vector<MappingInfo<dim1, spacedim1> *> &mappings,
    const std::map<types::material_id, unsigned int>
                                                &material_id_to_mapping_index,
    const Table<2, Point<spacedim1, real_type>> &mapping_support_point_table,
    const std::vector<unsigned int>             &mapping_indices,
    const SurfaceNormalDetector                 &normal_detector,
    const SauterQuadratureRule<dim1>            &sauter_quad_rule,
    MatrixType                                  &target_full_matrix);

  template <int dim1,
            int spacedim1,
            template <int, typename>
            typename KernelFunctionType,
            typename KernelNumberType1,
            typename SurfaceNormalDetector,
            typename MatrixType>
  friend void
  assemble_bem_full_matrix_serial(
    const KernelFunctionType<spacedim1, KernelNumberType1> &kernel,
    const KernelNumberType1                                 factor,
    const DoFHandler<dim1, spacedim1> &dof_handler_for_test_space,
    const DoFHandler<dim1, spacedim1> &dof_handler_for_trial_space,
    const std::vector<MappingInfo<dim1, spacedim1> *> &mappings,
    const std::map<types::material_id, unsigned int>
                                                &material_id_to_mapping_index,
    const Table<2, Point<spacedim1, real_type>> &mapping_support_point_table,
    const std::vector<unsigned int>             &mapping_indices,
    const SurfaceNormalDetector                 &normal_detector,
    const SauterQuadratureRule<dim1>            &sauter_quad_rule,
    MatrixType                                  &target_full_matrix);
#pragma endregion
};

#pragma region ****Internal ctor and dtor impls ****

template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  Priv(const ConfHelmholtzAcousticBEM &bem_params,
       const ConfSauterQuad           &sauter_quad_params,
       const ConfLinearSolver         &linear_solver_params)
  : project_name_("default")
  , kappa_(bem_params.kappa)
  , fe_order_for_dirichlet_space_(bem_params.fe_order_for_dirichlet_space)
  , fe_order_for_neumann_space_(bem_params.fe_order_for_neumann_space)
  , problem_type_(bem_params.problem_type)
  , is_interior_problem_(bem_params.is_interior_problem)
  , fe_for_dirichlet_space_(bem_params.fe_order_for_dirichlet_space)
  , fe_for_neumann_space_(bem_params.fe_order_for_neumann_space)
  , use_hmat_(false)
  , cpu_serial_(false)
  , sauter_quad_params_(sauter_quad_params)
  , linear_solver_params_(linear_solver_params)
{}

template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  Priv(const ConfHelmholtzAcousticBEM   &bem_params,
       const ConfHMatrix                &hmat_params,
       const ConfHMatrix                &hmat_preconditioner_params,
       const ConfSauterQuad             &sauter_quad_params,
       const ConfSauterQuad             &sauter_quad_precond_params,
       const ConfLinearSolver           &linear_solver_params,
       const ConfOperatorPreconditioner &op_precond_params,
       const ConfParallelization        &parallel_params)
  : project_name_("default")
  , kappa_(bem_params.kappa)
  , fe_order_for_dirichlet_space_(bem_params.fe_order_for_dirichlet_space)
  , fe_order_for_neumann_space_(bem_params.fe_order_for_neumann_space)
  , problem_type_(bem_params.problem_type)
  , is_interior_problem_(bem_params.is_interior_problem)
  , tria_(Triangulation<dim, spacedim>::MeshSmoothing::
            limit_level_difference_at_vertices) // This option is mandatory for
                                                // the operator preconditioner
                                                // built on the refined mesh.
  , mg_tria_for_preconditioner_(Triangulation<dim, spacedim>::MeshSmoothing::
                                  limit_level_difference_at_vertices)
  , fe_for_dirichlet_space_(bem_params.fe_order_for_dirichlet_space)
  , fe_for_neumann_space_(bem_params.fe_order_for_neumann_space)
  , use_hmat_(true)
  , cpu_serial_(false)
  , hmat_params_(hmat_params)
  , hmat_preconditioner_params_(hmat_preconditioner_params)
  , sauter_quad_params_(sauter_quad_params)
  , sauter_quad_precond_params_(sauter_quad_precond_params)
  , linear_solver_params_(linear_solver_params)
  , op_precond_params_(op_precond_params)
  , parallel_params_(parallel_params)
  , vmult_type_(IterativeSolverVmultType::SerialRecursive)
  , preconditioner_type_(PreconditionerType::OperatorPreconditioning)
{}

template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  ~Priv()
{
  // Release manifold objects.
  for (auto &m : manifolds_)
    delete m.second;

  // Release mapping objects and data.
  for (auto m : mappings_)
    delete m;
}

#pragma endregion
#pragma region ****Internal private member function impls ****

template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  initialize_memory_consumption_table_headers()
{
  memory_consumption_table_.declare_column("Object");
  memory_consumption_table_.declare_column("Memory (MB)");
  memory_consumption_table_.declare_column("Comment");
}

template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
template <typename T>
void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  add_memory_consumption_row(const std::string &name,
                             const T           &obj,
                             const std::string &comment)
{
  memory_consumption_table_.start_new_row();
  memory_consumption_table_.add_value("Object", name);
  memory_consumption_table_.add_value(
    "Memory (MB)",
    MemoryConsumption::memory_consumption(obj) / 1024.0 / 1024.0);

  memory_consumption_table_.add_value("Comment", comment);
}

#pragma endregion
#pragma region ****Internal public member function impls ****

template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  extract_surface_triangulation(
    const Triangulation<dim + 1, spacedim> &volume_triangulation,
    Triangulation<dim, spacedim>          &&surf_tria,
    const bool                              debug)
{
  tria_ = std::move(surf_tria);

  GridGenerator::extract_boundary_mesh(volume_triangulation, tria_);

  if (debug)
    {
      std::cout << "=== Surface mesh information ===" << std::endl;
      print_mesh_info(std::cout, tria_);
    }

  add_memory_consumption_row("Surface mesh", tria_);
}


template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  setup_system()
{
  LogStream::Prefix prefix_string("setup_system");
#if ENABLE_NVTX == 1
  HierBEM::CUDAWrappers::NVTXRange nvtx_range("setup_system");
#endif

  Timer timer;
  timer.stop();

  initialize_manifolds_from_manifold_description();
  initialize_mappings();
  timer.start();
  compute_mapping_data_for_triangulation();
  timer.stop();
  print_wall_time(deallog, timer, "compute mapping data for tria");

  switch (problem_type_)
    {
        case DirichletBCProblem: {
          dof_handler_for_dirichlet_space_.reinit(tria_);
          dof_handler_for_dirichlet_space_.distribute_dofs(
            fe_for_dirichlet_space_);
          dof_handler_for_neumann_space_.reinit(tria_);
          dof_handler_for_neumann_space_.distribute_dofs(fe_for_neumann_space_);

          const types::global_dof_index n_dofs_for_dirichlet_space =
            dof_handler_for_dirichlet_space_.n_dofs();
          const types::global_dof_index n_dofs_for_neumann_space =
            dof_handler_for_neumann_space_.n_dofs();

          std::cout << "=== DoF information ===" << std::endl;
          std::cout << "Number of DoFs in Dirichlet space: "
                    << n_dofs_for_dirichlet_space << "\n";
          std::cout << "Number of DoFs in Neumann space: "
                    << n_dofs_for_neumann_space << std::endl;

          if (!use_hmat_)
            {
              // Full matrix version is only for verification purpose.
              V1_mat_.reinit(n_dofs_for_neumann_space,
                             n_dofs_for_neumann_space);
              I1K2_mat_.reinit(n_dofs_for_neumann_space,
                               n_dofs_for_dirichlet_space);

              add_memory_consumption_row("V1 full matrix", V1_mat_);
              add_memory_consumption_row("I1K2 matrix", I1K2_mat_);
            }
          else
            {
              // Create function spaces.
              timer.start();
              dirichlet_space_on_dirichlet_domain_ =
                std::make_unique<BEMFunctionSpace<dim,
                                                  spacedim,
                                                  SearchableMaterialIdContainer,
                                                  real_type>>(
                  dof_handler_for_dirichlet_space_,
                  static_cast<unsigned int>(hmat_params_.n_min_for_ct),
                  static_cast<unsigned int>(hmat_params_.cutoff_level_ct));
              neumann_space_on_dirichlet_domain_ =
                std::make_unique<BEMFunctionSpace<dim,
                                                  spacedim,
                                                  SearchableMaterialIdContainer,
                                                  real_type>>(
                  dof_handler_for_neumann_space_,
                  static_cast<unsigned int>(hmat_params_.n_min_for_ct),
                  static_cast<unsigned int>(hmat_params_.cutoff_level_ct));
              timer.stop();
              print_wall_time(deallog, timer, "create function spaces");

              add_memory_consumption_row(
                "Cluster tree for Dirichlet space on Dirichlet domain",
                dirichlet_space_on_dirichlet_domain_->get_cluster_tree());
              add_memory_consumption_row(
                "Cluster tree for Neumann space on Dirichlet domain",
                neumann_space_on_dirichlet_domain_->get_cluster_tree());

              // Create bilinear forms, set kernel function wave number and
              // build block cluster trees.
              bV1_ =
                std::make_unique<BEMBilinearForm<dim,
                                                 spacedim,
                                                 SearchableMaterialIdContainer,
                                                 SingleLayerKernel,
                                                 RangeNumberType,
                                                 KernelNumberType>>(
                  *neumann_space_on_dirichlet_domain_,
                  *neumann_space_on_dirichlet_domain_);
              bV1_->get_kernel().set_kappa(
                CUDAKernelNumberType(kappa_.real(), kappa_.imag()));
              bI1K2_ =
                std::make_unique<BEMBilinearForm<dim,
                                                 spacedim,
                                                 SearchableMaterialIdContainer,
                                                 DoubleLayerKernel,
                                                 RangeNumberType,
                                                 KernelNumberType>>(
                  *dirichlet_space_on_dirichlet_domain_,
                  *neumann_space_on_dirichlet_domain_);
              bI1K2_->get_kernel().set_kappa(
                CUDAKernelNumberType(kappa_.real(), kappa_.imag()));

              timer.start();
              bV1_->build_block_cluster_tree(
                static_cast<real_type>(hmat_params_.eta),
                static_cast<unsigned int>(hmat_params_.n_min_for_bct),
                static_cast<unsigned int>(hmat_params_.cutoff_level_bct));
              bI1K2_->build_block_cluster_tree(
                static_cast<real_type>(hmat_params_.eta),
                static_cast<unsigned int>(hmat_params_.n_min_for_bct),
                static_cast<unsigned int>(hmat_params_.cutoff_level_bct));
              timer.stop();
              print_wall_time(deallog, timer, "build block cluster trees");

              add_memory_consumption_row("Block cluster tree for V1",
                                         bV1_->get_block_cluster_tree());
              add_memory_consumption_row("Block cluster tree for I1K2",
                                         bI1K2_->get_block_cluster_tree());
            }

          // Interpolate the Dirichlet boundary data.
          timer.start();
          interpolate_dirichlet_bc();
          dirichlet_data_ = dirichlet_bc_;

          if (use_hmat_)
            {
              dirichlet_bc_internal_dof_numbering_.reinit(
                n_dofs_for_dirichlet_space);
              dirichlet_space_on_dirichlet_domain_->convert_vector_e2i(
                dirichlet_bc_, dirichlet_bc_internal_dof_numbering_);
            }

          timer.stop();
          print_wall_time(deallog, timer, "interpolate boundary condition");

          // Allocate memory for the right-hand-side vector and solution vector.
          system_rhs_on_dirichlet_domain_.reinit(n_dofs_for_neumann_space);
          neumann_data_.reinit(n_dofs_for_neumann_space);

          if (use_hmat_)
            {
              // Solution vector in the internal numbering.
              neumann_data_on_dirichlet_domain_internal_dof_numbering_.reinit(
                n_dofs_for_neumann_space);
            }

          break;
        }
        case NeumannBCProblem: {
          dof_handler_for_dirichlet_space_.reinit(tria_);
          dof_handler_for_dirichlet_space_.distribute_dofs(
            fe_for_dirichlet_space_);
          dof_handler_for_neumann_space_.reinit(tria_);
          dof_handler_for_neumann_space_.distribute_dofs(fe_for_neumann_space_);

          const types::global_dof_index n_dofs_for_dirichlet_space =
            dof_handler_for_dirichlet_space_.n_dofs();
          const types::global_dof_index n_dofs_for_neumann_space =
            dof_handler_for_neumann_space_.n_dofs();

          std::cout << "=== DoF information ===" << std::endl;
          std::cout << "Number of DoFs in Dirichlet space: "
                    << n_dofs_for_dirichlet_space << "\n";
          std::cout << "Number of DoFs in Neumann space: "
                    << n_dofs_for_neumann_space << std::endl;

          if (!use_hmat_)
            {
              /**
               * If full matrices are used for verification purpose,
               * allocate memory for them here.
               */
              D1_mat_.reinit(n_dofs_for_dirichlet_space,
                             n_dofs_for_dirichlet_space);
              D1_part2_mat_.reinit(n_dofs_for_dirichlet_space,
                                   n_dofs_for_dirichlet_space);
              I2K_prime2_mat_.reinit(n_dofs_for_dirichlet_space,
                                     n_dofs_for_neumann_space);

              add_memory_consumption_row("D1 full matrix", D1_mat_);
              add_memory_consumption_row("D1 part2 full matrix", D1_part2_mat_);
              add_memory_consumption_row("I2K'2", I2K_prime2_mat_);
            }
          else
            {
              // Create function spaces.
              timer.start();
              dirichlet_space_on_neumann_domain_ =
                std::make_unique<BEMFunctionSpace<dim,
                                                  spacedim,
                                                  SearchableMaterialIdContainer,
                                                  real_type>>(
                  dof_handler_for_dirichlet_space_,
                  static_cast<unsigned int>(hmat_params_.n_min_for_ct),
                  static_cast<unsigned int>(hmat_params_.cutoff_level_ct));
              neumann_space_on_neumann_domain_ =
                std::make_unique<BEMFunctionSpace<dim,
                                                  spacedim,
                                                  SearchableMaterialIdContainer,
                                                  real_type>>(
                  dof_handler_for_neumann_space_,
                  static_cast<unsigned int>(hmat_params_.n_min_for_ct),
                  static_cast<unsigned int>(hmat_params_.cutoff_level_ct));
              timer.stop();
              print_wall_time(deallog, timer, "create function spaces");

              add_memory_consumption_row(
                "Cluster tree for Dirichlet space on Neumann domain",
                dirichlet_space_on_neumann_domain_->get_cluster_tree());
              add_memory_consumption_row(
                "Cluster tree for Neumann space on Neumann domain",
                neumann_space_on_neumann_domain_->get_cluster_tree());

              // Create bilinear forms, set kernel function wave number and
              // build block cluster trees.
              bD1_part1_ =
                std::make_unique<BEMBilinearForm<dim,
                                                 spacedim,
                                                 SearchableMaterialIdContainer,
                                                 HyperSingularKernelRegular1,
                                                 RangeNumberType,
                                                 KernelNumberType>>(
                  *dirichlet_space_on_neumann_domain_,
                  *dirichlet_space_on_neumann_domain_);
              bD1_part1_->get_kernel().set_kappa(
                CUDAKernelNumberType(kappa_.real(), kappa_.imag()));
              bD1_part2_ =
                std::make_unique<BEMBilinearForm<dim,
                                                 spacedim,
                                                 SearchableMaterialIdContainer,
                                                 HyperSingularKernelRegular2,
                                                 RangeNumberType,
                                                 KernelNumberType>>(
                  *dirichlet_space_on_neumann_domain_,
                  *dirichlet_space_on_neumann_domain_);
              bD1_part2_->get_kernel().set_kappa(
                CUDAKernelNumberType(kappa_.real(), kappa_.imag()));
              bI2K_prime2_ =
                std::make_unique<BEMBilinearForm<dim,
                                                 spacedim,
                                                 SearchableMaterialIdContainer,
                                                 AdjointDoubleLayerKernel,
                                                 RangeNumberType,
                                                 KernelNumberType>>(
                  *neumann_space_on_neumann_domain_,
                  *dirichlet_space_on_neumann_domain_);
              bI2K_prime2_->get_kernel().set_kappa(
                CUDAKernelNumberType(kappa_.real(), kappa_.imag()));

              timer.start();
              bD1_part1_->build_block_cluster_tree(
                static_cast<real_type>(hmat_params_.eta),
                static_cast<unsigned int>(hmat_params_.n_min_for_bct),
                static_cast<unsigned int>(hmat_params_.cutoff_level_bct));
              bD1_part2_->build_block_cluster_tree(
                static_cast<real_type>(hmat_params_.eta),
                static_cast<unsigned int>(hmat_params_.n_min_for_bct),
                static_cast<unsigned int>(hmat_params_.cutoff_level_bct));
              bI2K_prime2_->build_block_cluster_tree(
                static_cast<real_type>(hmat_params_.eta),
                static_cast<unsigned int>(hmat_params_.n_min_for_bct),
                static_cast<unsigned int>(hmat_params_.cutoff_level_bct));
              timer.stop();
              print_wall_time(deallog, timer, "build block cluster trees");

              add_memory_consumption_row("Block cluster tree for D1 part1",
                                         bD1_part1_->get_block_cluster_tree());
              add_memory_consumption_row("Block cluster tree for D1 part2",
                                         bD1_part2_->get_block_cluster_tree());
              add_memory_consumption_row(
                "Block cluster tree for I2K'2",
                bI2K_prime2_->get_block_cluster_tree());
            }

          // Interpolate the Neumann boundary data.
          timer.start();
          interpolate_neumann_bc();
          neumann_data_ = neumann_bc_;

          if (use_hmat_)
            {
              neumann_bc_internal_dof_numbering_.reinit(
                n_dofs_for_neumann_space);
              neumann_space_on_neumann_domain_->convert_vector_e2i(
                neumann_bc_, neumann_bc_internal_dof_numbering_);
            }

          timer.stop();
          print_wall_time(deallog, timer, "interpolate boundary condition");

          /**
           * Allocate memory for the right-hand-side vector and solution
           * vector.
           */
          system_rhs_on_neumann_domain_.reinit(n_dofs_for_dirichlet_space);
          dirichlet_data_.reinit(n_dofs_for_dirichlet_space);

          if (use_hmat_)
            {
              // Solution vector in the internal numbering
              dirichlet_data_on_neumann_domain_internal_dof_numbering_.reinit(
                n_dofs_for_dirichlet_space);
            }

          break;
        }
        case MixedBCProblem: {
          Assert(use_hmat_, ExcInternalError());

          dof_handler_for_dirichlet_space_.reinit(tria_);
          dof_handler_for_dirichlet_space_.distribute_dofs(
            fe_for_dirichlet_space_);
          dof_handler_for_neumann_space_.reinit(tria_);
          dof_handler_for_neumann_space_.distribute_dofs(fe_for_neumann_space_);

          // Create function spaces.
          timer.start();
          dirichlet_space_on_dirichlet_domain_ =
            std::make_unique<BEMFunctionSpace<dim,
                                              spacedim,
                                              SearchableMaterialIdContainer,
                                              real_type>>(
              dof_handler_for_dirichlet_space_,
              dirichlet_bc_definition_,
              static_cast<unsigned int>(hmat_params_.n_min_for_ct),
              static_cast<unsigned int>(hmat_params_.cutoff_level_ct),
              true,
              false);
          dirichlet_space_on_neumann_domain_ =
            std::make_unique<BEMFunctionSpace<dim,
                                              spacedim,
                                              SearchableMaterialIdContainer,
                                              real_type>>(
              dof_handler_for_dirichlet_space_,
              neumann_bc_definition_,
              static_cast<unsigned int>(hmat_params_.n_min_for_ct),
              static_cast<unsigned int>(hmat_params_.cutoff_level_ct),
              false,
              false);
          neumann_space_on_dirichlet_domain_ =
            std::make_unique<BEMFunctionSpace<dim,
                                              spacedim,
                                              SearchableMaterialIdContainer,
                                              real_type>>(
              dof_handler_for_neumann_space_,
              dirichlet_bc_definition_,
              static_cast<unsigned int>(hmat_params_.n_min_for_ct),
              static_cast<unsigned int>(hmat_params_.cutoff_level_ct),
              true,
              false);
          neumann_space_on_neumann_domain_ =
            std::make_unique<BEMFunctionSpace<dim,
                                              spacedim,
                                              SearchableMaterialIdContainer,
                                              real_type>>(
              dof_handler_for_neumann_space_,
              neumann_bc_definition_,
              static_cast<unsigned int>(hmat_params_.n_min_for_ct),
              static_cast<unsigned int>(hmat_params_.cutoff_level_ct),
              true,
              false);
          timer.stop();
          print_wall_time(deallog, timer, "create function spaces");

          // Get the number of effective DoF number for each DoF handler.
          types::global_dof_index
            n_dofs_for_dirichlet_space_on_dirichlet_domain =
              dirichlet_space_on_dirichlet_domain_->get_n_dofs();
          types::global_dof_index n_dofs_for_dirichlet_space_on_neumann_domain =
            dirichlet_space_on_neumann_domain_->get_n_dofs();
          types::global_dof_index n_dofs_for_neumann_space_on_dirichlet_domain =
            neumann_space_on_dirichlet_domain_->get_n_dofs();
          types::global_dof_index n_dofs_for_neumann_space_on_neumann_domain =
            neumann_space_on_neumann_domain_->get_n_dofs();

          std::cout << "=== DoF information ===" << std::endl;
          std::cout << "Number of DoFs in Dirichlet space on Dirichlet domain: "
                    << n_dofs_for_dirichlet_space_on_dirichlet_domain << "\n";
          std::cout << "Number of DoFs in Dirichlet space on Neumann domain: "
                    << n_dofs_for_dirichlet_space_on_neumann_domain << "\n";
          std::cout << "Number of DoFs in Neumann space on Dirichlet domain: "
                    << n_dofs_for_neumann_space_on_dirichlet_domain << "\n";
          std::cout << "Number of DoFs in Neumann space on Neumann domain: "
                    << n_dofs_for_neumann_space_on_neumann_domain << std::endl;

          add_memory_consumption_row(
            "Cluster tree for Dirichlet space on Dirichlet domain",
            dirichlet_space_on_dirichlet_domain_->get_cluster_tree());
          add_memory_consumption_row(
            "Cluster tree for Dirichlet space on Neumann domain",
            dirichlet_space_on_neumann_domain_->get_cluster_tree());
          add_memory_consumption_row(
            "Cluster tree for Neumann space on Dirichlet domain",
            neumann_space_on_dirichlet_domain_->get_cluster_tree());
          add_memory_consumption_row(
            "Cluster tree for Neumann space on Neumann domain",
            neumann_space_on_neumann_domain_->get_cluster_tree());

          // Create bilinear forms.
          bV1_ = std::make_unique<BEMBilinearForm<dim,
                                                  spacedim,
                                                  SearchableMaterialIdContainer,
                                                  SingleLayerKernel,
                                                  RangeNumberType,
                                                  KernelNumberType>>(
            *neumann_space_on_dirichlet_domain_,
            *neumann_space_on_dirichlet_domain_);
          bV1_->get_kernel().set_kappa(
            CUDAKernelNumberType(kappa_.real(), kappa_.imag()));
          bK1_ = std::make_unique<BEMBilinearForm<dim,
                                                  spacedim,
                                                  SearchableMaterialIdContainer,
                                                  DoubleLayerKernel,
                                                  RangeNumberType,
                                                  KernelNumberType>>(
            *dirichlet_space_on_neumann_domain_,
            *neumann_space_on_dirichlet_domain_);
          bK1_->get_kernel().set_kappa(
            CUDAKernelNumberType(kappa_.real(), kappa_.imag()));
          bD1_part1_ =
            std::make_unique<BEMBilinearForm<dim,
                                             spacedim,
                                             SearchableMaterialIdContainer,
                                             HyperSingularKernelRegular1,
                                             RangeNumberType,
                                             KernelNumberType>>(
              *dirichlet_space_on_neumann_domain_,
              *dirichlet_space_on_neumann_domain_);
          bD1_part1_->get_kernel().set_kappa(
            CUDAKernelNumberType(kappa_.real(), kappa_.imag()));
          bD1_part2_ =
            std::make_unique<BEMBilinearForm<dim,
                                             spacedim,
                                             SearchableMaterialIdContainer,
                                             HyperSingularKernelRegular2,
                                             RangeNumberType,
                                             KernelNumberType>>(
              *dirichlet_space_on_neumann_domain_,
              *dirichlet_space_on_neumann_domain_);
          bD1_part2_->get_kernel().set_kappa(
            CUDAKernelNumberType(kappa_.real(), kappa_.imag()));
          bI1K2_ =
            std::make_unique<BEMBilinearForm<dim,
                                             spacedim,
                                             SearchableMaterialIdContainer,
                                             DoubleLayerKernel,
                                             RangeNumberType,
                                             KernelNumberType>>(
              *dirichlet_space_on_dirichlet_domain_,
              *neumann_space_on_dirichlet_domain_);
          bI1K2_->get_kernel().set_kappa(
            CUDAKernelNumberType(kappa_.real(), kappa_.imag()));
          bV2_ = std::make_unique<BEMBilinearForm<dim,
                                                  spacedim,
                                                  SearchableMaterialIdContainer,
                                                  SingleLayerKernel,
                                                  RangeNumberType,
                                                  KernelNumberType>>(
            *neumann_space_on_neumann_domain_,
            *neumann_space_on_dirichlet_domain_);
          bV2_->get_kernel().set_kappa(
            CUDAKernelNumberType(kappa_.real(), kappa_.imag()));
          bD2_part1_ =
            std::make_unique<BEMBilinearForm<dim,
                                             spacedim,
                                             SearchableMaterialIdContainer,
                                             HyperSingularKernelRegular1,
                                             RangeNumberType,
                                             KernelNumberType>>(
              *dirichlet_space_on_dirichlet_domain_,
              *dirichlet_space_on_neumann_domain_);
          bD2_part1_->get_kernel().set_kappa(
            CUDAKernelNumberType(kappa_.real(), kappa_.imag()));
          bD2_part2_ =
            std::make_unique<BEMBilinearForm<dim,
                                             spacedim,
                                             SearchableMaterialIdContainer,
                                             HyperSingularKernelRegular2,
                                             RangeNumberType,
                                             KernelNumberType>>(
              *dirichlet_space_on_dirichlet_domain_,
              *dirichlet_space_on_neumann_domain_);
          bD2_part2_->get_kernel().set_kappa(
            CUDAKernelNumberType(kappa_.real(), kappa_.imag()));
          bI2K_prime2_ =
            std::make_unique<BEMBilinearForm<dim,
                                             spacedim,
                                             SearchableMaterialIdContainer,
                                             AdjointDoubleLayerKernel,
                                             RangeNumberType,
                                             KernelNumberType>>(
              *neumann_space_on_neumann_domain_,
              *dirichlet_space_on_neumann_domain_);
          bI2K_prime2_->get_kernel().set_kappa(
            CUDAKernelNumberType(kappa_.real(), kappa_.imag()));

          // Create the block cluster trees.
          timer.start();
          bV1_->build_block_cluster_tree(
            static_cast<real_type>(hmat_params_.eta),
            static_cast<unsigned int>(hmat_params_.n_min_for_bct),
            static_cast<unsigned int>(hmat_params_.cutoff_level_bct));
          bK1_->build_block_cluster_tree(
            static_cast<real_type>(hmat_params_.eta),
            static_cast<unsigned int>(hmat_params_.n_min_for_bct),
            static_cast<unsigned int>(hmat_params_.cutoff_level_bct));
          bD1_part1_->build_block_cluster_tree(
            static_cast<real_type>(hmat_params_.eta),
            static_cast<unsigned int>(hmat_params_.n_min_for_bct),
            static_cast<unsigned int>(hmat_params_.cutoff_level_bct));
          bD1_part2_->build_block_cluster_tree(
            static_cast<real_type>(hmat_params_.eta),
            static_cast<unsigned int>(hmat_params_.n_min_for_bct),
            static_cast<unsigned int>(hmat_params_.cutoff_level_bct));
          bI1K2_->build_block_cluster_tree(
            static_cast<real_type>(hmat_params_.eta),
            static_cast<unsigned int>(hmat_params_.n_min_for_bct),
            static_cast<unsigned int>(hmat_params_.cutoff_level_bct));
          bV2_->build_block_cluster_tree(
            static_cast<real_type>(hmat_params_.eta),
            static_cast<unsigned int>(hmat_params_.n_min_for_bct),
            static_cast<unsigned int>(hmat_params_.cutoff_level_bct));
          bD2_part1_->build_block_cluster_tree(
            static_cast<real_type>(hmat_params_.eta),
            static_cast<unsigned int>(hmat_params_.n_min_for_bct),
            static_cast<unsigned int>(hmat_params_.cutoff_level_bct));
          bD2_part2_->build_block_cluster_tree(
            static_cast<real_type>(hmat_params_.eta),
            static_cast<unsigned int>(hmat_params_.n_min_for_bct),
            static_cast<unsigned int>(hmat_params_.cutoff_level_bct));
          bI2K_prime2_->build_block_cluster_tree(
            static_cast<real_type>(hmat_params_.eta),
            static_cast<unsigned int>(hmat_params_.n_min_for_bct),
            static_cast<unsigned int>(hmat_params_.cutoff_level_bct));
          timer.stop();
          print_wall_time(deallog, timer, "build block cluster trees");

          add_memory_consumption_row("Block cluster tree for V1",
                                     bV1_->get_block_cluster_tree());
          add_memory_consumption_row("Block cluster tree for K1",
                                     bK1_->get_block_cluster_tree());
          add_memory_consumption_row("Block cluster tree for D1 part1",
                                     bD1_part1_->get_block_cluster_tree());
          add_memory_consumption_row("Block cluster tree for D1 part2",
                                     bD1_part2_->get_block_cluster_tree());
          add_memory_consumption_row("Block cluster tree for I1K2",
                                     bI1K2_->get_block_cluster_tree());
          add_memory_consumption_row("Block cluster tree for V2",
                                     bV2_->get_block_cluster_tree());
          add_memory_consumption_row("Block cluster tree for D2 part1",
                                     bD2_part1_->get_block_cluster_tree());
          add_memory_consumption_row("Block cluster tree for D2 part2",
                                     bD2_part2_->get_block_cluster_tree());
          add_memory_consumption_row("Block cluster tree for I2K'2",
                                     bI2K_prime2_->get_block_cluster_tree());

          // Interpolate the Dirichlet boundary data on the extended Dirichlet
          // domain and set those unselected DoFs to be zero.
          timer.start();

          interpolate_dirichlet_bc();
          dirichlet_bc_on_selected_dofs_.reinit(
            n_dofs_for_dirichlet_space_on_dirichlet_domain);
          dirichlet_space_on_dirichlet_domain_->extract_selected_dofs(
            dirichlet_bc_, dirichlet_bc_on_selected_dofs_);
          dirichlet_bc_internal_dof_numbering_.reinit(
            n_dofs_for_dirichlet_space_on_dirichlet_domain);
          dirichlet_space_on_dirichlet_domain_->convert_vector_e2i(
            dirichlet_bc_on_selected_dofs_,
            dirichlet_bc_internal_dof_numbering_);

          interpolate_neumann_bc();
          neumann_bc_on_selected_dofs_.reinit(
            n_dofs_for_neumann_space_on_neumann_domain);
          neumann_space_on_neumann_domain_->extract_selected_dofs(
            neumann_bc_, neumann_bc_on_selected_dofs_);
          neumann_bc_internal_dof_numbering_.reinit(
            n_dofs_for_neumann_space_on_neumann_domain);
          neumann_space_on_neumann_domain_->convert_vector_e2i(
            neumann_bc_on_selected_dofs_, neumann_bc_internal_dof_numbering_);

          timer.stop();
          print_wall_time(deallog, timer, "interpolate boundary condition");

          // Allocate memory for the right-hand-side vectors and solution
          // vectors.
          system_rhs_on_dirichlet_domain_.reinit(
            n_dofs_for_neumann_space_on_dirichlet_domain);
          system_rhs_on_neumann_domain_.reinit(
            n_dofs_for_dirichlet_space_on_neumann_domain);

          // When H-LU factorization is used for preconditioning, the 2x2 block
          // matrix in mixed boundary condition should be solved as a whole, so
          // the two RHS vectors should be combined into a single vector.
          if (preconditioner_type_ == PreconditionerType::HMatrixFactorization)
            system_rhs_on_combined_domain_.reinit(
              n_dofs_for_neumann_space_on_dirichlet_domain +
              n_dofs_for_dirichlet_space_on_neumann_domain);

          // N.B. This is the solution vector on all DoFs in the associated
          // DoF handler.
          dirichlet_data_.reinit(dof_handler_for_dirichlet_space_.n_dofs());
          neumann_data_.reinit(dof_handler_for_neumann_space_.n_dofs());

          // N.B. This is the solution vector on selected DoFs in the
          // associated DoF handler in the external DoF numbering.
          dirichlet_data_on_neumann_domain_.reinit(
            n_dofs_for_dirichlet_space_on_neumann_domain);
          neumann_data_on_dirichlet_domain_.reinit(
            n_dofs_for_neumann_space_on_dirichlet_domain);

          // N.B. This is the solution vector on the selected DoFs in the
          // associated DoF handler in the internal DoF numbering.
          dirichlet_data_on_neumann_domain_internal_dof_numbering_.reinit(
            n_dofs_for_dirichlet_space_on_neumann_domain);
          neumann_data_on_dirichlet_domain_internal_dof_numbering_.reinit(
            n_dofs_for_neumann_space_on_dirichlet_domain);
          solution_on_combined_domain_internal_dof_numbering_.reinit(
            n_dofs_for_neumann_space_on_dirichlet_domain +
            n_dofs_for_dirichlet_space_on_neumann_domain);

          break;
        }
        default: {
          Assert(false, ExcInternalError());
          break;
        }
    }
}


template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  assign_dirichlet_bc(Function<spacedim, RangeNumberType> &f,
                      const EntityTag                      surface_tag)
{
  if (surface_tag == -1)
    for (const auto &record : subdomain_topology_.get_surface_to_subdomain())
      dirichlet_bc_definition_[record.first] = &f;
  else
    dirichlet_bc_definition_[surface_tag] = &f;
}


template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  assign_dirichlet_bc(Function<spacedim, RangeNumberType> &f,
                      const std::vector<EntityTag>        &surface_tags)
{
  for (const auto t : surface_tags)
    dirichlet_bc_definition_[t] = &f;
}


template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  assign_neumann_bc(Function<spacedim, RangeNumberType> &f,
                    const EntityTag                      surface_tag)
{
  if (surface_tag == -1)
    for (const auto &record : subdomain_topology_.get_surface_to_subdomain())
      neumann_bc_definition_[record.first] = &f;
  else
    neumann_bc_definition_[surface_tag] = &f;
}


template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  assign_neumann_bc(Function<spacedim, RangeNumberType> &f,
                    const std::vector<EntityTag>        &surface_tags)
{
  for (const auto t : surface_tags)
    neumann_bc_definition_[t] = &f;
}


template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
bool
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  validate_subdomain_topology() const
{
  auto &subdomain_to_surface = subdomain_topology_.get_subdomain_to_surface();
  const unsigned int n_subdomains = subdomain_to_surface.size();

  // There should be at least one subdomain.
  if (n_subdomains > 0)
    {
      if (n_subdomains > 1)
        {
          // When there are more than 1 subdomains, they should be disjoint.
          for (auto iter1 = subdomain_to_surface.begin();
               iter1 != subdomain_to_surface.end();
               iter1++)
            {
              for (auto iter2 = std::next(iter1);
                   iter2 != subdomain_to_surface.end();
                   iter2++)
                {
                  std::vector<EntityTag> surface_tag_intersection;
                  std::set_intersection(iter1->second.begin(),
                                        iter1->second.end(),
                                        iter2->second.begin(),
                                        iter2->second.end(),
                                        std::back_inserter(
                                          surface_tag_intersection));

                  if (!surface_tag_intersection.empty())
                    return false;
                }
            }

          return true;
        }
      else
        return true;
    }
  else
    return false;
}


template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  initialize_manifolds_from_manifold_description()
{
  // Assign manifold ids to all cells in the triangulation.
  for (auto &cell : tria_.active_cell_iterators())
    {
      cell->set_all_manifold_ids(manifold_description_[cell->material_id()]);
    }

  // Associate manifold objects with manifold ids in the triangulation.
  for (const auto &m : manifolds_)
    {
      tria_.set_manifold(m.first, *m.second);
    }
}


template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  initialize_mappings()
{
  // Create different orders of mapping.
  mappings_.reserve(max_mapping_order);
  for (unsigned int i = 1; i <= max_mapping_order; i++)
    {
      mappings_.push_back(new MappingInfo<dim, spacedim>(i));
    }

  // Construct the map from material ids to mapping indices.
  for (const auto &m : manifold_description_)
    {
      material_id_to_mapping_index_[m.first] =
        manifold_id_to_mapping_order_[m.second] - 1;
    }
}


template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  compute_mapping_data_for_triangulation()
{
  // Compute mapping data on the host and copy them to the device.
  BEMTools::compute_mapping_support_points_and_indices_for_tria(
    tria_,
    mappings_,
    material_id_to_mapping_index_,
    tria_mapping_support_points_cpu_,
    tria_mapping_indices_cpu_);

  // When H-matrix is used, the mapping data should be copied to the device.
  if (use_hmat_)
    {
      tria_mapping_support_points_gpu_.allocate(
        tria_mapping_support_points_cpu_.size());
      tria_mapping_support_points_gpu_.assign_from_host(
        tria_mapping_support_points_cpu_);

      tria_mapping_indices_gpu_.allocate(
        TableIndices<1>(tria_mapping_indices_cpu_.size()));
      tria_mapping_indices_gpu_.assign_from_host(tria_mapping_indices_cpu_);
    }
}


template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  release_mapping_data_for_triangulation()
{
  tria_mapping_support_points_cpu_.clear();
  tria_mapping_indices_cpu_.clear();

  if (use_hmat_)
    {
      tria_mapping_support_points_gpu_.release();
      tria_mapping_indices_gpu_.release();
    }
}


template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  compute_mapping_data_for_refined_triangulation()
{
  Assert(use_hmat_ &&
           preconditioner_type_ == PreconditionerType::OperatorPreconditioning,
         ExcInternalError());

  // Compute mapping data on the host and copy them to the device.
  BEMTools::compute_mapping_support_points_and_indices_for_tria(
    mg_tria_for_preconditioner_,
    mappings_,
    material_id_to_mapping_index_,
    mg_tria_mapping_support_points_cpu_,
    mg_tria_mapping_indices_cpu_);

  mg_tria_mapping_support_points_gpu_.allocate(
    mg_tria_mapping_support_points_cpu_.size());
  mg_tria_mapping_support_points_gpu_.assign_from_host(
    mg_tria_mapping_support_points_cpu_);

  mg_tria_mapping_indices_gpu_.allocate(
    TableIndices<1>(mg_tria_mapping_indices_cpu_.size()));
  mg_tria_mapping_indices_gpu_.assign_from_host(mg_tria_mapping_indices_cpu_);
}


template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  release_mapping_data_for_refined_triangulation()
{
  Assert(use_hmat_ &&
           preconditioner_type_ == PreconditionerType::OperatorPreconditioning,
         ExcInternalError());

  mg_tria_mapping_support_points_cpu_.clear();
  mg_tria_mapping_indices_cpu_.clear();
  mg_tria_mapping_support_points_gpu_.release();
  mg_tria_mapping_indices_gpu_.release();
}


template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  interpolate_dirichlet_bc()
{
  dirichlet_bc_.reinit(dof_handler_for_dirichlet_space_.n_dofs());

  // Because each surface may be assigned a different mapping object, here we
  // interpolate the Dirichlet boundary condition vector surface by surface.
  //
  // \mynote{Even though, a high order mapping is adopted, the fitted curved
  // surface is still not identifical to the orignal CAD model. This makes the
  // actually applied boundary condition function deviates from the
  // theoretical version, when we want to apply an analytical function. Even
  // when a manifold conforming mapping is adopted, which is realized in the
  // deal.ii class MappingManifold, the finite element space will produce
  // additional error when approximating the analytical function. This means
  // no matter how accurately we assemble the matrix and solve the linear
  // system, the solution vector will not be identical with the analytical
  // solution.}
  for (const auto &bc : dirichlet_bc_definition_)
    {
      std::map<types::material_id, const Function<spacedim, RangeNumberType> *>
        single_pair_map;
      single_pair_map[static_cast<types::material_id>(bc.first)] = bc.second;

      VectorTools::interpolate_based_on_material_id(
        mappings_[material_id_to_mapping_index_[bc.first]]->get_mapping(),
        dof_handler_for_dirichlet_space_,
        single_pair_map,
        dirichlet_bc_);
    }
}


template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  interpolate_neumann_bc()
{
  neumann_bc_.reinit(dof_handler_for_neumann_space_.n_dofs());

  // Because each surface may be assigned a different mapping object, here we
  // interpolate the Neumann boundary condition vector surface by surface.
  for (const auto &bc : neumann_bc_definition_)
    {
      std::map<types::material_id, const Function<spacedim, RangeNumberType> *>
        single_pair_map;
      single_pair_map[static_cast<types::material_id>(bc.first)] = bc.second;

      VectorTools::interpolate_based_on_material_id(
        mappings_[material_id_to_mapping_index_[bc.first]]->get_mapping(),
        dof_handler_for_neumann_space_,
        single_pair_map,
        neumann_bc_);
    }
}


template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  assemble_full_matrix_system()
{
  // Define kernel functions on the host, i.e. the number type is
  // <tt>KernelNumberType</tt>.
  SingleLayerKernel<spacedim, KernelNumberType> single_layer_kernel(kappa_);
  DoubleLayerKernel<spacedim, KernelNumberType> double_layer_kernel(kappa_);
  AdjointDoubleLayerKernel<spacedim, KernelNumberType>
    adjoint_double_layer_kernel(kappa_);
  HyperSingularKernelRegular1<spacedim, KernelNumberType>
    hyper_singular_kernel1(kappa_);
  HyperSingularKernelRegular2<spacedim, KernelNumberType>
    hyper_singular_kernel2(kappa_);

  LogStream::Prefix prefix_string("assemble_full_matrix");

  switch (problem_type_)
    {
        case DirichletBCProblem: {
#if ENABLE_MATRIX_EXPORT == 1
          // Output stream for matrices and vectors.
          std::ofstream out_mat;
#endif

          // Assemble the FEM scaled mass matrix, which is stored into the full
          // matrix for \f$K_2\f$.
          //
          // \mynote{The polynomial order specified for the Gauss-Legendre
          // quadrature rule for FEM integration is accurate for the integration
          // of \f$2N-1\f$-th polynomial, where \f$N\f is the number of
          // quadrature points in 1D.}
          std::cout << "=== Assemble scaled mass matrix ===" << std::endl;


          // For the interior problem, \f$\frac{1}{2}I\f$ is assembled, while
          // for the exterior problem, \f$-\frac{1}{2}I\f$ is assembled. It is
          // also assumed that the potential reference \f$u_0\f$ is zero when
          // \f$\abs{x} \rightarrow \infty\f$.
          Timer timer;
          if (is_interior_problem_)
            {
              if (cpu_serial_)
                {
                  assemble_fem_scaled_mass_matrix_serial<
                    dim,
                    spacedim,
                    real_type,
                    LAPACKFullMatrixExt<RangeNumberType>>(
                    dof_handler_for_neumann_space_,
                    dof_handler_for_dirichlet_space_,
                    0.5,
                    QGauss<dim>(fe_for_dirichlet_space_.degree + 1),
                    I1K2_mat_);
                }
              else
                {
                  assemble_fem_scaled_mass_matrix<
                    dim,
                    spacedim,
                    real_type,
                    LAPACKFullMatrixExt<RangeNumberType>>(
                    dof_handler_for_neumann_space_,
                    dof_handler_for_dirichlet_space_,
                    0.5,
                    QGauss<dim>(fe_for_dirichlet_space_.degree + 1),
                    I1K2_mat_);
                }
            }
          else
            {
              if (cpu_serial_)
                {
                  assemble_fem_scaled_mass_matrix_serial<
                    dim,
                    spacedim,
                    real_type,
                    LAPACKFullMatrixExt<RangeNumberType>>(
                    dof_handler_for_neumann_space_,
                    dof_handler_for_dirichlet_space_,
                    -0.5,
                    QGauss<dim>(fe_for_dirichlet_space_.degree + 1),
                    I1K2_mat_);
                }
              else
                {
                  assemble_fem_scaled_mass_matrix<
                    dim,
                    spacedim,
                    real_type,
                    LAPACKFullMatrixExt<RangeNumberType>>(
                    dof_handler_for_neumann_space_,
                    dof_handler_for_dirichlet_space_,
                    -0.5,
                    QGauss<dim>(fe_for_dirichlet_space_.degree + 1),
                    I1K2_mat_);
                }
            }
          timer.stop();
          print_wall_time(deallog, timer, "assemble mass matrix I");


          // Assemble the DLP matrix, which is added with the previous scaled
          // FEM mass matrix.
          std::cout << "=== Assemble DLP matrix ===" << std::endl;

          timer.start();
          if (cpu_serial_)
            {
              assemble_bem_full_matrix_serial<
                dim,
                spacedim,
                DoubleLayerKernel,
                KernelNumberType,
                SurfaceNormalDetector<dim, spacedim>,
                LAPACKFullMatrixExt<RangeNumberType>>(
                double_layer_kernel,
                1.0,
                dof_handler_for_neumann_space_,
                dof_handler_for_dirichlet_space_,
                mappings_,
                material_id_to_mapping_index_,
                tria_mapping_support_points_cpu_,
                tria_mapping_indices_cpu_,
                SurfaceNormalDetector<dim, spacedim>(subdomain_topology_),
                SauterQuadratureRule<dim>(sauter_quad_params_.dlp_order),
                I1K2_mat_);
            }
          else
            {
              assemble_bem_full_matrix<dim,
                                       spacedim,
                                       DoubleLayerKernel,
                                       KernelNumberType,
                                       SurfaceNormalDetector<dim, spacedim>,
                                       LAPACKFullMatrixExt<RangeNumberType>>(
                double_layer_kernel,
                1.0,
                dof_handler_for_neumann_space_,
                dof_handler_for_dirichlet_space_,
                mappings_,
                material_id_to_mapping_index_,
                tria_mapping_support_points_cpu_,
                tria_mapping_indices_cpu_,
                SurfaceNormalDetector<dim, spacedim>(subdomain_topology_),
                SauterQuadratureRule<dim>(sauter_quad_params_.dlp_order),
                I1K2_mat_);
            }
          timer.stop();
          print_wall_time(deallog, timer, "assemble K");

#if ENABLE_MATRIX_EXPORT == 1
          out_mat.open("matrices.dat");
          I1K2_mat_.print_formatted_to_mat(out_mat, "I1K2", 15, true, 25);
#endif

          // Calculate the RHS vector.
          timer.start();
          I1K2_mat_.vmult(system_rhs_on_dirichlet_domain_, dirichlet_bc_);
          timer.stop();
          print_wall_time(deallog, timer, "assemble RHS vector");

#if ENABLE_MATRIX_EXPORT == 1
          print_vector_to_mat(out_mat,
                              "system_rhs",
                              system_rhs_on_dirichlet_domain_,
                              false,
                              15,
                              25);
#endif

          // Release the RHS matrix.
          std::cout << "=== Release the RHS matrix ===" << std::endl;
          I1K2_mat_.clear();

          // Assemble the SLP matrix.
          std::cout << "=== Assemble SLP matrix ===" << std::endl;

          timer.start();
          if (cpu_serial_)
            {
              assemble_bem_full_matrix_serial<
                dim,
                spacedim,
                SingleLayerKernel,
                KernelNumberType,
                SurfaceNormalDetector<dim, spacedim>,
                LAPACKFullMatrixExt<RangeNumberType>>(
                single_layer_kernel,
                1.0,
                dof_handler_for_neumann_space_,
                dof_handler_for_neumann_space_,
                mappings_,
                material_id_to_mapping_index_,
                tria_mapping_support_points_cpu_,
                tria_mapping_indices_cpu_,
                SurfaceNormalDetector<dim, spacedim>(subdomain_topology_),
                SauterQuadratureRule<dim>(sauter_quad_params_.slp_order),
                V1_mat_);
            }
          else
            {
              assemble_bem_full_matrix<dim,
                                       spacedim,
                                       SingleLayerKernel,
                                       KernelNumberType,
                                       SurfaceNormalDetector<dim, spacedim>,
                                       LAPACKFullMatrixExt<RangeNumberType>>(
                single_layer_kernel,
                1.0,
                dof_handler_for_neumann_space_,
                dof_handler_for_neumann_space_,
                mappings_,
                material_id_to_mapping_index_,
                tria_mapping_support_points_cpu_,
                tria_mapping_indices_cpu_,
                SurfaceNormalDetector<dim, spacedim>(subdomain_topology_),
                SauterQuadratureRule<dim>(sauter_quad_params_.slp_order),
                V1_mat_);
            }
          timer.stop();
          print_wall_time(deallog, timer, "assemble V");

#if ENABLE_MATRIX_EXPORT == 1
          V1_mat_.print_formatted_to_mat(out_mat, "V1", 15, true, 25);
          out_mat.close();
#endif

          break;
        }
        case NeumannBCProblem: {
#if ENABLE_MATRIX_EXPORT == 1
          // Output stream for matrices and vectors.
          std::ofstream out_mat;
#endif

          std::cout << "=== Assemble scaled mass matrix ===" << std::endl;

          // For the interior problem, \f$\frac{1}{2}I\f$ is assembled, while
          // for the exterior problem, \f$-\frac{1}{2}I\f$ is assembled.
          Timer timer;
          if (is_interior_problem_)
            {
              if (cpu_serial_)
                {
                  assemble_fem_scaled_mass_matrix_serial<
                    dim,
                    spacedim,
                    real_type,
                    LAPACKFullMatrixExt<RangeNumberType>>(
                    dof_handler_for_dirichlet_space_,
                    dof_handler_for_neumann_space_,
                    0.5,
                    QGauss<dim>(fe_for_dirichlet_space_.degree + 1),
                    I2K_prime2_mat_);
                }
              else
                {
                  assemble_fem_scaled_mass_matrix<
                    dim,
                    spacedim,
                    real_type,
                    LAPACKFullMatrixExt<RangeNumberType>>(
                    dof_handler_for_dirichlet_space_,
                    dof_handler_for_neumann_space_,
                    0.5,
                    QGauss<dim>(fe_for_dirichlet_space_.degree + 1),
                    I2K_prime2_mat_);
                }
            }
          else
            {
              if (cpu_serial_)
                {
                  assemble_fem_scaled_mass_matrix_serial<
                    dim,
                    spacedim,
                    real_type,
                    LAPACKFullMatrixExt<RangeNumberType>>(
                    dof_handler_for_dirichlet_space_,
                    dof_handler_for_neumann_space_,
                    -0.5,
                    QGauss<dim>(fe_for_dirichlet_space_.degree + 1),
                    I2K_prime2_mat_);
                }
              else
                {
                  assemble_fem_scaled_mass_matrix<
                    dim,
                    spacedim,
                    real_type,
                    LAPACKFullMatrixExt<RangeNumberType>>(
                    dof_handler_for_dirichlet_space_,
                    dof_handler_for_neumann_space_,
                    -0.5,
                    QGauss<dim>(fe_for_dirichlet_space_.degree + 1),
                    I2K_prime2_mat_);
                }
            }
          timer.stop();
          print_wall_time(deallog, timer, "assemble mass matrix I");


          // Assemble the ADLP matrix, which is added with the previous scaled
          // FEM mass matrix.
          std::cout << "=== Assemble ADLP matrix ===" << std::endl;

          timer.start();
          if (cpu_serial_)
            {
              assemble_bem_full_matrix_serial<
                dim,
                spacedim,
                AdjointDoubleLayerKernel,
                KernelNumberType,
                SurfaceNormalDetector<dim, spacedim>,
                LAPACKFullMatrixExt<RangeNumberType>>(
                adjoint_double_layer_kernel,
                -1.0,
                dof_handler_for_dirichlet_space_,
                dof_handler_for_neumann_space_,
                mappings_,
                material_id_to_mapping_index_,
                tria_mapping_support_points_cpu_,
                tria_mapping_indices_cpu_,
                SurfaceNormalDetector<dim, spacedim>(subdomain_topology_),
                SauterQuadratureRule<dim>(sauter_quad_params_.adlp_order),
                I2K_prime2_mat_);
            }
          else
            {
              assemble_bem_full_matrix<dim,
                                       spacedim,
                                       AdjointDoubleLayerKernel,
                                       KernelNumberType,
                                       SurfaceNormalDetector<dim, spacedim>,
                                       LAPACKFullMatrixExt<RangeNumberType>>(
                adjoint_double_layer_kernel,
                -1.0,
                dof_handler_for_dirichlet_space_,
                dof_handler_for_neumann_space_,
                mappings_,
                material_id_to_mapping_index_,
                tria_mapping_support_points_cpu_,
                tria_mapping_indices_cpu_,
                SurfaceNormalDetector<dim, spacedim>(subdomain_topology_),
                SauterQuadratureRule<dim>(sauter_quad_params_.adlp_order),
                I2K_prime2_mat_);
            }
          timer.stop();
          print_wall_time(deallog, timer, "assemble K'");

#if ENABLE_MATRIX_EXPORT == 1
          out_mat.open("matrices.dat");
          I2K_prime2_mat_.print_formatted_to_mat(
            out_mat, "I2K'2", 15, true, 25);
#endif

          // Calculate the RHS vector.
          timer.start();
          I2K_prime2_mat_.vmult(system_rhs_on_neumann_domain_, neumann_bc_);
          timer.stop();
          print_wall_time(deallog, timer, "assemble RHS vector");

#if ENABLE_MATRIX_EXPORT == 1
          print_vector_to_mat(out_mat,
                              "system_rhs",
                              system_rhs_on_neumann_domain_,
                              false,
                              15,
                              25);
#endif

          // Release the RHS matrix.
          std::cout << "=== Release the RHS matrix ===" << std::endl;
          I2K_prime2_mat_.clear();

          // Assemble the matrix for the hyper singular operator, where the
          // stabilization method is adopted.
          std::cout << "=== Assemble D matrix ===" << std::endl;

          timer.start();
          if (cpu_serial_)
            {
              assemble_bem_full_matrix_serial<
                dim,
                spacedim,
                HyperSingularKernelRegular1,
                KernelNumberType,
                SurfaceNormalDetector<dim, spacedim>,
                LAPACKFullMatrixExt<RangeNumberType>>(
                hyper_singular_kernel1,
                1.0,
                dof_handler_for_dirichlet_space_,
                dof_handler_for_dirichlet_space_,
                mappings_,
                material_id_to_mapping_index_,
                tria_mapping_support_points_cpu_,
                tria_mapping_indices_cpu_,
                SurfaceNormalDetector<dim, spacedim>(subdomain_topology_),
                SauterQuadratureRule<dim>(
                  sauter_quad_params_.hyper_singular_order),
                D1_mat_);

              assemble_bem_full_matrix_serial<
                dim,
                spacedim,
                HyperSingularKernelRegular2,
                KernelNumberType,
                SurfaceNormalDetector<dim, spacedim>,
                LAPACKFullMatrixExt<RangeNumberType>>(
                hyper_singular_kernel2,
                1.0,
                dof_handler_for_dirichlet_space_,
                dof_handler_for_dirichlet_space_,
                mappings_,
                material_id_to_mapping_index_,
                tria_mapping_support_points_cpu_,
                tria_mapping_indices_cpu_,
                SurfaceNormalDetector<dim, spacedim>(subdomain_topology_),
                SauterQuadratureRule<dim>(sauter_quad_params_.slp_order),
                D1_part2_mat_);
            }
          else
            {
              assemble_bem_full_matrix<dim,
                                       spacedim,
                                       HyperSingularKernelRegular1,
                                       KernelNumberType,
                                       SurfaceNormalDetector<dim, spacedim>,
                                       LAPACKFullMatrixExt<RangeNumberType>>(
                hyper_singular_kernel1,
                1.0,
                dof_handler_for_dirichlet_space_,
                dof_handler_for_dirichlet_space_,
                mappings_,
                material_id_to_mapping_index_,
                tria_mapping_support_points_cpu_,
                tria_mapping_indices_cpu_,
                SurfaceNormalDetector<dim, spacedim>(subdomain_topology_),
                SauterQuadratureRule<dim>(
                  sauter_quad_params_.hyper_singular_order),
                D1_mat_);

              assemble_bem_full_matrix<dim,
                                       spacedim,
                                       HyperSingularKernelRegular2,
                                       KernelNumberType,
                                       SurfaceNormalDetector<dim, spacedim>,
                                       LAPACKFullMatrixExt<RangeNumberType>>(
                hyper_singular_kernel2,
                1.0,
                dof_handler_for_dirichlet_space_,
                dof_handler_for_dirichlet_space_,
                mappings_,
                material_id_to_mapping_index_,
                tria_mapping_support_points_cpu_,
                tria_mapping_indices_cpu_,
                SurfaceNormalDetector<dim, spacedim>(subdomain_topology_),
                SauterQuadratureRule<dim>(sauter_quad_params_.slp_order),
                D1_part2_mat_);
            }

          D1_mat_.add(D1_part2_mat_);
          timer.stop();
          print_wall_time(deallog, timer, "assemble D");

#if ENABLE_MATRIX_EXPORT == 1
          D1_mat_.print_formatted_to_mat(out_mat, "D1", 15, true, 25);
          out_mat.close();
#endif

          break;
        }
        case MixedBCProblem: {
          Assert(false, ExcNotImplemented());
          break;
        }
        default: {
          Assert(false, ExcInternalError());
          break;
        }
    }

  release_mapping_data_for_triangulation();
}


template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  assemble_hmatrix_system()
{
  LogStream::Prefix prefix_string("assemble_hmatrix_system");
#if ENABLE_NVTX == 1
  HierBEM::CUDAWrappers::NVTXRange nvtx_range("assemble_hmatrix_system");
#endif

  Timer timer;
  switch (problem_type_)
    {
        case DirichletBCProblem: {
#if ENABLE_MATRIX_EXPORT == 1
          // Output stream for matrices and vectors.
          std::ofstream out_mat;
          // Output stream for block cluster trees.
          std::ofstream out_bct;
#endif

#if ENABLE_NVTX == 1
          nvtxRangePush("assemble_I1K2");
#endif
          if (is_interior_problem_)
            {
              std::cout << "=== Assemble sigma*I1+K2 ===" << std::endl;
              I1K2_hmat_ = bI1K2_->build_hmatrix_with_mass_matrix(
                hmat_params_,
                sauter_quad_params_.near_field,
                sauter_quad_params_.far_field,
                parallel_params_,
                CUDAKernelNumberType(1.0),
                real_type(0.5),
                SauterQuadratureRule<dim>(sauter_quad_params_.dlp_order),
                QGauss<dim>(fe_order_for_dirichlet_space_ + 1),
                mappings_,
                material_id_to_mapping_index_,
                tria_mapping_support_points_cpu_,
                tria_mapping_support_points_gpu_,
                tria_mapping_indices_gpu_,
                subdomain_topology_);
              timer.stop();
              print_wall_time(deallog, timer, "assemble sigma*I1+K2");
            }
          else
            {
              std::cout << "=== Assemble (sigma-1)*I1+K2 ===" << std::endl;
              I1K2_hmat_ = bI1K2_->build_hmatrix_with_mass_matrix(
                hmat_params_,
                sauter_quad_params_.near_field,
                sauter_quad_params_.far_field,
                parallel_params_,
                CUDAKernelNumberType(1.0),
                real_type(-0.5),
                SauterQuadratureRule<dim>(sauter_quad_params_.dlp_order),
                QGauss<dim>(fe_order_for_dirichlet_space_ + 1),
                mappings_,
                material_id_to_mapping_index_,
                tria_mapping_support_points_cpu_,
                tria_mapping_support_points_gpu_,
                tria_mapping_indices_gpu_,
                subdomain_topology_);
              timer.stop();
              print_wall_time(deallog, timer, "assemble (sigma-1)*I1+K2");
            }
#if ENABLE_NVTX == 1
          nvtxRangePop(); // NVTX range: assemble_I1K2
#endif
          add_memory_consumption_row("I1K2", *I1K2_hmat_, "After assembly");
          std::cout << "=== Leaf set information of I1K2 ===" << std::endl;
          I1K2_hmat_->print_leaf_set_info(std::cout);

#if ENABLE_MATRIX_EXPORT == 1
          out_mat.open("matrices.dat");
          I1K2_hmat_->print_as_formatted_full_matrix(
            out_mat, "I1K2", 15, true, 25);
          print_vector_to_mat(
            out_mat,
            "I1K2_row_i2e",
            bI1K2_->get_test_space().get_internal_to_external_dof_numbering());
          print_vector_to_mat(
            out_mat,
            "I1K2_col_i2e",
            bI1K2_->get_trial_space().get_internal_to_external_dof_numbering());

          out_bct.open("I1K2_bct.dat");
          I1K2_hmat_->write_leaf_set_by_iteration(out_bct, 1e-12);
          out_bct.close();
#endif

          std::cout << "=== Assemble the RHS vector ===" << std::endl;
          timer.start();
          I1K2_hmat_->vmult(system_rhs_on_dirichlet_domain_,
                            dirichlet_bc_internal_dof_numbering_);
          timer.stop();
          print_wall_time(deallog, timer, "assemble RHS vector");

#if ENABLE_MATRIX_EXPORT == 1
          print_vector_to_mat(out_mat,
                              "system_rhs",
                              system_rhs_on_dirichlet_domain_,
                              false,
                              15,
                              25);
#endif

          // Release the RHS matrix.
          std::cout << "=== Release the RHS matrix ===" << std::endl;
          I1K2_hmat_->release();

          {
#if ENABLE_NVTX == 1
            HierBEM::CUDAWrappers::NVTXRange nvtx_range("assemble_V1");
#endif

            std::cout << "=== Assemble V1 ===" << std::endl;
            timer.start();
            V1_hmat_ = bV1_->build_hmatrix(hmat_params_,
                                           sauter_quad_params_.near_field,
                                           sauter_quad_params_.far_field,
                                           parallel_params_,
                                           CUDAKernelNumberType(1.0),
                                           SauterQuadratureRule<dim>(
                                             sauter_quad_params_.slp_order),
                                           mappings_,
                                           material_id_to_mapping_index_,
                                           tria_mapping_support_points_cpu_,
                                           tria_mapping_support_points_gpu_,
                                           tria_mapping_indices_gpu_,
                                           subdomain_topology_);
            timer.stop();
            print_wall_time(deallog, timer, "assemble V1");
          }
          add_memory_consumption_row("V1", *V1_hmat_, "After assembly");
          std::cout << "=== Leaf set information of V1 ===" << std::endl;
          V1_hmat_->print_leaf_set_info(std::cout);

#if ENABLE_MATRIX_EXPORT == 1
          V1_hmat_->print_as_formatted_full_matrix(out_mat, "V1", 15, true, 25);
          print_vector_to_mat(
            out_mat,
            "V1_row_i2e",
            bV1_->get_test_space().get_internal_to_external_dof_numbering());
          print_vector_to_mat(
            out_mat,
            "V1_col_i2e",
            bV1_->get_trial_space().get_internal_to_external_dof_numbering());

          out_bct.open("V1_bct.dat");
          V1_hmat_->write_leaf_set_by_iteration(out_bct, 1e-12);
          out_bct.close();
          out_mat.close();
#endif

          break;
        }
        case NeumannBCProblem: {
#if ENABLE_MATRIX_EXPORT == 1
          // Output stream for matrices and vectors.
          std::ofstream out_mat;
          // Output stream for block cluster trees.
          std::ofstream out_bct;
#endif

#if ENABLE_NVTX == 1
          nvtxRangePush("assemble_I2Kprime2");
#endif
          if (is_interior_problem_)
            {
              std::cout << "=== Assemble (1-sigma)*I2-K'2 ===" << std::endl;
              I2K_prime2_hmat_ = bI2K_prime2_->build_hmatrix_with_mass_matrix(
                hmat_params_,
                sauter_quad_params_.near_field,
                sauter_quad_params_.far_field,
                parallel_params_,
                CUDAKernelNumberType(-1.0),
                real_type(0.5),
                SauterQuadratureRule<dim>(sauter_quad_params_.adlp_order),
                QGauss<dim>(fe_order_for_dirichlet_space_ + 1),
                mappings_,
                material_id_to_mapping_index_,
                tria_mapping_support_points_cpu_,
                tria_mapping_support_points_gpu_,
                tria_mapping_indices_gpu_,
                subdomain_topology_);
              timer.stop();
              print_wall_time(deallog, timer, "assemble (1-sigma)*I2-K'2");
            }
          else
            {
              std::cout << "=== Assemble -sigma*I2-K'2 ===" << std::endl;
              I2K_prime2_hmat_ = bI2K_prime2_->build_hmatrix_with_mass_matrix(
                hmat_params_,
                sauter_quad_params_.near_field,
                sauter_quad_params_.far_field,
                parallel_params_,
                CUDAKernelNumberType(-1.0),
                real_type(-0.5),
                SauterQuadratureRule<dim>(sauter_quad_params_.adlp_order),
                QGauss<dim>(fe_order_for_dirichlet_space_ + 1),
                mappings_,
                material_id_to_mapping_index_,
                tria_mapping_support_points_cpu_,
                tria_mapping_support_points_gpu_,
                tria_mapping_indices_gpu_,
                subdomain_topology_);
              timer.stop();
              print_wall_time(deallog, timer, "assemble -sigma*I2-K'2");
            }
#if ENABLE_NVTX == 1
          nvtxRangePop(); // NVTX range: assemble_I2Kprime2
#endif
          add_memory_consumption_row("I2K'2",
                                     *I2K_prime2_hmat_,
                                     "After assembly");
          std::cout << "=== Leaf set information of I2K'2 ===" << std::endl;
          I2K_prime2_hmat_->print_leaf_set_info(std::cout);

#if ENABLE_MATRIX_EXPORT == 1
          out_mat.open("matrices.dat");
          I2K_prime2_hmat_->print_as_formatted_full_matrix(
            out_mat, "I2K_prime2", 15, true, 25);
          print_vector_to_mat(out_mat,
                              "I2K_prime2_row_i2e",
                              bI2K_prime2_->get_test_space()
                                .get_internal_to_external_dof_numbering());
          print_vector_to_mat(out_mat,
                              "I2K_prime2_col_i2e",
                              bI2K_prime2_->get_trial_space()
                                .get_internal_to_external_dof_numbering());

          out_bct.open("I2K_prime2_bct.dat");
          I2K_prime2_hmat_->write_leaf_set_by_iteration(out_bct, 1e-12);
          out_bct.close();
#endif

          std::cout << "=== Assemble the RHS vector ===" << std::endl;
          timer.start();
          I2K_prime2_hmat_->vmult(system_rhs_on_neumann_domain_,
                                  neumann_bc_internal_dof_numbering_);
          timer.stop();
          print_wall_time(deallog, timer, "assemble RHS vector");

#if ENABLE_MATRIX_EXPORT == 1
          print_vector_to_mat(out_mat,
                              "system_rhs",
                              system_rhs_on_neumann_domain_,
                              false,
                              15,
                              25);
#endif

          std::cout << "=== Release I2K'2 ===" << std::endl;
          I2K_prime2_hmat_->release();

          // Assemble H-matrix for the regularized bilinear form for the
          // hyper-singular operator along with the stabilization term.
          std::cout << "=== Assemble D1 ===" << std::endl;
          timer.start();
#if ENABLE_NVTX == 1
          nvtxRangePush("assemble_D1");
#endif
          D1_hmat_ = bD1_part1_->build_hmatrix_with_regularization(
            hmat_params_,
            sauter_quad_params_.near_field,
            sauter_quad_params_.far_field,
            parallel_params_,
            CUDAKernelNumberType(1.0),
            {},
            KernelNumberType(0.),
            SauterQuadratureRule<dim>(sauter_quad_params_.hyper_singular_order),
            mappings_,
            material_id_to_mapping_index_,
            tria_mapping_support_points_cpu_,
            tria_mapping_support_points_gpu_,
            tria_mapping_indices_gpu_,
            subdomain_topology_);
          D1_part2_hmat_ =
            bD1_part2_->build_hmatrix(hmat_params_,
                                      sauter_quad_params_.near_field,
                                      sauter_quad_params_.far_field,
                                      parallel_params_,
                                      CUDAKernelNumberType(1.0),
                                      SauterQuadratureRule<dim>(
                                        sauter_quad_params_.slp_order),
                                      mappings_,
                                      material_id_to_mapping_index_,
                                      tria_mapping_support_points_cpu_,
                                      tria_mapping_support_points_gpu_,
                                      tria_mapping_indices_gpu_,
                                      subdomain_topology_);
          D1_hmat_->add(*D1_part2_hmat_,
                        static_cast<unsigned int>(hmat_params_.max_rank) * 2);
          D1_part2_hmat_->release();
          timer.stop();
          print_wall_time(deallog, timer, "assemble D1");
#if ENABLE_NVTX == 1
          nvtxRangePop(); // NVTX range: assemble_D1
#endif
          add_memory_consumption_row("D1", *D1_hmat_, "After assembly");
          std::cout << "=== Leaf set information of D1 ===" << std::endl;
          D1_hmat_->print_leaf_set_info(std::cout);

#if ENABLE_MATRIX_EXPORT == 1
          D1_hmat_->print_as_formatted_full_matrix(out_mat, "D1", 15, true, 25);
          print_vector_to_mat(out_mat,
                              "D1_row_i2e",
                              bD1_part1_->get_test_space()
                                .get_internal_to_external_dof_numbering());
          print_vector_to_mat(out_mat,
                              "D1_col_i2e",
                              bD1_part1_->get_trial_space()
                                .get_internal_to_external_dof_numbering());

          out_bct.open("D1_bct.dat");
          D1_hmat_->write_leaf_set_by_iteration(out_bct, 1e-12);
          out_bct.close();
          out_mat.close();
#endif

          break;
        }
        case MixedBCProblem: {
          // For the mixed boundary condition, we firstly assemble the right
          // hand side matrices and vectors. Then after releasing these matrices
          // for saving the memory, we continue to assemble the left hand side
          // matrices, i.e. stiff matrices.
#if ENABLE_MATRIX_EXPORT == 1
          // Output stream for matrices and vectors.
          std::ofstream out_mat;
          // Output stream for block cluster trees.
          std::ofstream out_bct;
#endif

          if (is_interior_problem_)
            {
              std::cout << "=== Assemble sigma*I1+K2 ===" << std::endl;
              I1K2_hmat_ = bI1K2_->build_hmatrix_with_mass_matrix(
                hmat_params_,
                sauter_quad_params_.near_field,
                sauter_quad_params_.far_field,
                parallel_params_,
                CUDAKernelNumberType(1.0),
                real_type(0.5),
                SauterQuadratureRule<dim>(sauter_quad_params_.dlp_order),
                QGauss<dim>(fe_order_for_dirichlet_space_ + 1),
                mappings_,
                material_id_to_mapping_index_,
                tria_mapping_support_points_cpu_,
                tria_mapping_support_points_gpu_,
                tria_mapping_indices_gpu_,
                subdomain_topology_);
              timer.stop();
              print_wall_time(deallog, timer, "assemble sigma*I1+K2");

              std::cout << "=== Assemble (1-sigma)*I2-K'2 ===" << std::endl;
              timer.start();
              I2K_prime2_hmat_ = bI2K_prime2_->build_hmatrix_with_mass_matrix(
                hmat_params_,
                sauter_quad_params_.near_field,
                sauter_quad_params_.far_field,
                parallel_params_,
                CUDAKernelNumberType(-1.0),
                real_type(0.5),
                SauterQuadratureRule<dim>(sauter_quad_params_.adlp_order),
                QGauss<dim>(fe_order_for_dirichlet_space_ + 1),
                mappings_,
                material_id_to_mapping_index_,
                tria_mapping_support_points_cpu_,
                tria_mapping_support_points_gpu_,
                tria_mapping_indices_gpu_,
                subdomain_topology_);
              timer.stop();
              print_wall_time(deallog, timer, "assemble (1-sigma)*I2-K'2");
            }
          else
            {
              std::cout << "=== Assemble (sigma-1)*I1+K2 ===" << std::endl;
              I1K2_hmat_ = bI1K2_->build_hmatrix_with_mass_matrix(
                hmat_params_,
                sauter_quad_params_.near_field,
                sauter_quad_params_.far_field,
                parallel_params_,
                CUDAKernelNumberType(1.0),
                real_type(-0.5),
                SauterQuadratureRule<dim>(sauter_quad_params_.dlp_order),
                QGauss<dim>(fe_order_for_dirichlet_space_ + 1),
                mappings_,
                material_id_to_mapping_index_,
                tria_mapping_support_points_cpu_,
                tria_mapping_support_points_gpu_,
                tria_mapping_indices_gpu_,
                subdomain_topology_);
              timer.stop();
              print_wall_time(deallog, timer, "assemble (sigma-1)*I1+K2");

              std::cout << "=== Assemble -sigma*I2-K'2 ===" << std::endl;
              timer.start();
              I2K_prime2_hmat_ = bI2K_prime2_->build_hmatrix_with_mass_matrix(
                hmat_params_,
                sauter_quad_params_.near_field,
                sauter_quad_params_.far_field,
                parallel_params_,
                CUDAKernelNumberType(-1.0),
                real_type(-0.5),
                SauterQuadratureRule<dim>(sauter_quad_params_.adlp_order),
                QGauss<dim>(fe_order_for_dirichlet_space_ + 1),
                mappings_,
                material_id_to_mapping_index_,
                tria_mapping_support_points_cpu_,
                tria_mapping_support_points_gpu_,
                tria_mapping_indices_gpu_,
                subdomain_topology_);
              timer.stop();
              print_wall_time(deallog, timer, "assemble -sigma*I2-K'2");
            }
          add_memory_consumption_row("I1K2", *I1K2_hmat_, "After assembly");
          add_memory_consumption_row("I2K'2",
                                     *I2K_prime2_hmat_,
                                     "After assembly");
          std::cout << "=== Leaf set information of I1K2 ===" << std::endl;
          I1K2_hmat_->print_leaf_set_info(std::cout);
          std::cout << "=== Leaf set information of I2K'2 ===" << std::endl;
          I2K_prime2_hmat_->print_leaf_set_info(std::cout);

          std::cout << "=== Assemble -V2 ===" << std::endl;
          timer.start();
          V2_hmat_ = bV2_->build_hmatrix(hmat_params_,
                                         sauter_quad_params_.near_field,
                                         sauter_quad_params_.far_field,
                                         parallel_params_,
                                         CUDAKernelNumberType(-1.0),
                                         SauterQuadratureRule<dim>(
                                           sauter_quad_params_.slp_order),
                                         mappings_,
                                         material_id_to_mapping_index_,
                                         tria_mapping_support_points_cpu_,
                                         tria_mapping_support_points_gpu_,
                                         tria_mapping_indices_gpu_,
                                         subdomain_topology_);
          timer.stop();
          print_wall_time(deallog, timer, "assemble -V2");
          add_memory_consumption_row("V2", *V2_hmat_, "After assembly");
          std::cout << "=== Leaf set information of V2 ===" << std::endl;
          V2_hmat_->print_leaf_set_info(std::cout);

          std::cout << "=== Assemble -D2 ===" << std::endl;
          timer.start();
          D2_hmat_ = bD2_part1_->build_hmatrix_with_regularization(
            hmat_params_,
            sauter_quad_params_.near_field,
            sauter_quad_params_.far_field,
            parallel_params_,
            CUDAKernelNumberType(-1.0),
            {},
            KernelNumberType(0.),
            SauterQuadratureRule<dim>(sauter_quad_params_.hyper_singular_order),
            mappings_,
            material_id_to_mapping_index_,
            tria_mapping_support_points_cpu_,
            tria_mapping_support_points_gpu_,
            tria_mapping_indices_gpu_,
            subdomain_topology_);
          D2_part2_hmat_ =
            bD2_part2_->build_hmatrix(hmat_params_,
                                      sauter_quad_params_.near_field,
                                      sauter_quad_params_.far_field,
                                      parallel_params_,
                                      CUDAKernelNumberType(-1.0),
                                      SauterQuadratureRule<dim>(
                                        sauter_quad_params_.slp_order),
                                      mappings_,
                                      material_id_to_mapping_index_,
                                      tria_mapping_support_points_cpu_,
                                      tria_mapping_support_points_gpu_,
                                      tria_mapping_indices_gpu_,
                                      subdomain_topology_);
          D2_hmat_->add(*D2_part2_hmat_,
                        static_cast<unsigned int>(hmat_params_.max_rank) * 2);
          D2_part2_hmat_->release();
          timer.stop();
          print_wall_time(deallog, timer, "assemble -D2");
          add_memory_consumption_row("D2", *D2_hmat_, "After assembly");
          std::cout << "=== Leaf set information of D2 ===" << std::endl;
          D2_hmat_->print_leaf_set_info(std::cout);

#if ENABLE_MATRIX_EXPORT == 1
          out_mat.open("matrices.dat");
          I1K2_hmat_->print_as_formatted_full_matrix(
            out_mat, "I1K2", 15, true, 25);
          print_vector_to_mat(
            out_mat,
            "I1K2_row_i2e",
            bI1K2_->get_test_space().get_internal_to_external_dof_numbering());
          print_vector_to_mat(
            out_mat,
            "I1K2_col_i2e",
            bI1K2_->get_trial_space().get_internal_to_external_dof_numbering());

          I2K_prime2_hmat_->print_as_formatted_full_matrix(
            out_mat, "I2K_prime2", 15, true, 25);
          print_vector_to_mat(out_mat,
                              "I2K_prime2_row_i2e",
                              bI2K_prime2_->get_test_space()
                                .get_internal_to_external_dof_numbering());
          print_vector_to_mat(out_mat,
                              "I2K_prime2_col_i2e",
                              bI2K_prime2_->get_trial_space()
                                .get_internal_to_external_dof_numbering());

          V2_hmat_->print_as_formatted_full_matrix(out_mat, "V2", 15, true, 25);
          print_vector_to_mat(
            out_mat,
            "V2_row_i2e",
            bV2_->get_test_space().get_internal_to_external_dof_numbering());
          print_vector_to_mat(
            out_mat,
            "V2_col_i2e",
            bV2_->get_trial_space().get_internal_to_external_dof_numbering());

          D2_hmat_->print_as_formatted_full_matrix(out_mat, "D2", 15, true, 25);
          print_vector_to_mat(out_mat,
                              "D2_row_i2e",
                              bD2_part1_->get_test_space()
                                .get_internal_to_external_dof_numbering());
          print_vector_to_mat(out_mat,
                              "D2_col_i2e",
                              bD2_part1_->get_trial_space()
                                .get_internal_to_external_dof_numbering());

          out_bct.open("I1K2_bct.dat");
          I1K2_hmat_->write_leaf_set_by_iteration(out_bct, 1e-12);
          out_bct.close();
          out_bct.open("I2K_prime2_bct.dat");
          I2K_prime2_hmat_->write_leaf_set_by_iteration(out_bct, 1e-12);
          out_bct.close();
          out_bct.open("V2_bct.dat");
          V2_hmat_->write_leaf_set_by_iteration(out_bct, 1e-12);
          out_bct.close();
          out_bct.open("D2_bct.dat");
          D2_hmat_->write_leaf_set_by_iteration(out_bct, 1e-12);
          out_bct.close();
#endif

          // Calculate the RHS vectors in the mixed boundary value problem.
          std::cout << "=== Assemble RHS vectors ===" << std::endl;
          timer.start();
          I1K2_hmat_->vmult(system_rhs_on_dirichlet_domain_,
                            dirichlet_bc_internal_dof_numbering_);
          V2_hmat_->vmult_add(system_rhs_on_dirichlet_domain_,
                              neumann_bc_internal_dof_numbering_);
          timer.stop();
          print_wall_time(deallog,
                          timer,
                          "assemble RHS vector on Dirichlet domain");

          timer.start();
          D2_hmat_->vmult(system_rhs_on_neumann_domain_,
                          dirichlet_bc_internal_dof_numbering_);
          I2K_prime2_hmat_->vmult_add(system_rhs_on_neumann_domain_,
                                      neumann_bc_internal_dof_numbering_);
          timer.stop();
          print_wall_time(deallog,
                          timer,
                          "assemble RHS vector on Neumann domain");

          // Combine the two parts of RHS vectors.
          if (preconditioner_type_ == PreconditionerType::HMatrixFactorization)
            {
              copy_vector(system_rhs_on_combined_domain_,
                          0,
                          system_rhs_on_dirichlet_domain_,
                          0,
                          system_rhs_on_dirichlet_domain_.size());
              copy_vector(system_rhs_on_combined_domain_,
                          system_rhs_on_dirichlet_domain_.size(),
                          system_rhs_on_neumann_domain_,
                          0,
                          system_rhs_on_neumann_domain_.size());
            }

#if ENABLE_MATRIX_EXPORT == 1
          if (preconditioner_type_ == PreconditionerType::HMatrixFactorization)
            {
              print_vector_to_mat(out_mat,
                                  "system_rhs_on_combined_domain",
                                  system_rhs_on_combined_domain_,
                                  false,
                                  15,
                                  25);
            }

          print_vector_to_mat(out_mat,
                              "system_rhs_on_dirichlet_domain",
                              system_rhs_on_dirichlet_domain_,
                              false,
                              15,
                              25);
          print_vector_to_mat(out_mat,
                              "system_rhs_on_neumann_domain",
                              system_rhs_on_neumann_domain_,
                              false,
                              15,
                              25);
#endif

          // Release the RHS matrices.
          std::cout << "=== Release RHS matrices ===" << std::endl;
          I1K2_hmat_->release();
          I2K_prime2_hmat_->release();
          V2_hmat_->release();
          D2_hmat_->release();

          std::cout << "=== Assemble V1 ===" << std::endl;
          timer.start();
          V1_hmat_ = bV1_->build_hmatrix(hmat_params_,
                                         sauter_quad_params_.near_field,
                                         sauter_quad_params_.far_field,
                                         parallel_params_,
                                         CUDAKernelNumberType(1.0),
                                         SauterQuadratureRule<dim>(
                                           sauter_quad_params_.slp_order),
                                         mappings_,
                                         material_id_to_mapping_index_,
                                         tria_mapping_support_points_cpu_,
                                         tria_mapping_support_points_gpu_,
                                         tria_mapping_indices_gpu_,
                                         subdomain_topology_);
          timer.stop();
          print_wall_time(deallog, timer, "assemble V1");
          add_memory_consumption_row("V1", *V1_hmat_, "After assembly");
          std::cout << "=== Leaf set information of V1 ===" << std::endl;
          V1_hmat_->print_leaf_set_info(std::cout);

          std::cout << "=== Assemble -K1 ===" << std::endl;
          timer.start();
          K1_hmat_ = bK1_->build_hmatrix(hmat_params_,
                                         sauter_quad_params_.near_field,
                                         sauter_quad_params_.far_field,
                                         parallel_params_,
                                         CUDAKernelNumberType(-1.0),
                                         SauterQuadratureRule<dim>(
                                           sauter_quad_params_.dlp_order),
                                         mappings_,
                                         material_id_to_mapping_index_,
                                         tria_mapping_support_points_cpu_,
                                         tria_mapping_support_points_gpu_,
                                         tria_mapping_indices_gpu_,
                                         subdomain_topology_);
          timer.stop();
          print_wall_time(deallog, timer, "assemble -K1");
          add_memory_consumption_row("K1", *K1_hmat_, "After assembly");
          std::cout << "=== Leaf set information of K1 ===" << std::endl;
          K1_hmat_->print_leaf_set_info(std::cout);

          std::cout << "=== Assemble D1 ===" << std::endl;
          timer.start();
          D1_hmat_ = bD1_part1_->build_hmatrix_with_regularization(
            hmat_params_,
            sauter_quad_params_.near_field,
            sauter_quad_params_.far_field,
            parallel_params_,
            CUDAKernelNumberType(1.0),
            {},
            KernelNumberType(0.),
            SauterQuadratureRule<dim>(sauter_quad_params_.hyper_singular_order),
            mappings_,
            material_id_to_mapping_index_,
            tria_mapping_support_points_cpu_,
            tria_mapping_support_points_gpu_,
            tria_mapping_indices_gpu_,
            subdomain_topology_);
          D1_part2_hmat_ =
            bD1_part2_->build_hmatrix(hmat_params_,
                                      sauter_quad_params_.near_field,
                                      sauter_quad_params_.far_field,
                                      parallel_params_,
                                      CUDAKernelNumberType(1.0),
                                      SauterQuadratureRule<dim>(
                                        sauter_quad_params_.slp_order),
                                      mappings_,
                                      material_id_to_mapping_index_,
                                      tria_mapping_support_points_cpu_,
                                      tria_mapping_support_points_gpu_,
                                      tria_mapping_indices_gpu_,
                                      subdomain_topology_);
          D1_hmat_->add(*D1_part2_hmat_,
                        static_cast<unsigned int>(hmat_params_.max_rank) * 2);
          timer.stop();
          print_wall_time(deallog, timer, "assemble D1");
          add_memory_consumption_row("D1", *D1_hmat_, "After assembly");
          std::cout << "=== Leaf set information of D1 ===" << std::endl;
          D1_hmat_->print_leaf_set_info(std::cout);

          // Assemble the block matrix.
          std::cout << "=== Assemble system block matrix ===" << std::endl;
          M_hmat_ =
            std::make_unique<HBlockMatrixSkewSymm<spacedim, RangeNumberType>>(
              *V1_hmat_, *K1_hmat_, *D1_hmat_);

#if ENABLE_MATRIX_EXPORT == 1
          V1_hmat_->print_as_formatted_full_matrix(out_mat, "V1", 15, true, 25);
          print_vector_to_mat(
            out_mat,
            "V1_row_i2e",
            bV1_->get_test_space().get_internal_to_external_dof_numbering());
          print_vector_to_mat(
            out_mat,
            "V1_col_i2e",
            bV1_->get_trial_space().get_internal_to_external_dof_numbering());

          K1_hmat_->print_as_formatted_full_matrix(out_mat, "K1", 15, true, 25);
          print_vector_to_mat(
            out_mat,
            "K1_row_i2e",
            bK1_->get_test_space().get_internal_to_external_dof_numbering());
          print_vector_to_mat(
            out_mat,
            "K1_col_i2e",
            bK1_->get_trial_space().get_internal_to_external_dof_numbering());

          D1_hmat_->print_as_formatted_full_matrix(out_mat, "D1", 15, true, 25);
          print_vector_to_mat(out_mat,
                              "D1_row_i2e",
                              bD1_part1_->get_test_space()
                                .get_internal_to_external_dof_numbering());
          print_vector_to_mat(out_mat,
                              "D1_col_i2e",
                              bD1_part1_->get_trial_space()
                                .get_internal_to_external_dof_numbering());

          out_bct.open("V1_bct.dat");
          V1_hmat_->write_leaf_set_by_iteration(out_bct, 1e-12);
          out_bct.close();
          out_bct.open("K1_bct.dat");
          K1_hmat_->write_leaf_set_by_iteration(out_bct, 1e-12);
          out_bct.close();
          out_bct.open("D1_bct.dat");
          D1_hmat_->write_leaf_set_by_iteration(out_bct, 1e-12);
          out_bct.close();
          out_mat.close();
#endif

          break;
        }
        default: {
          Assert(false, ExcInternalError());
          break;
        }
    }

  release_mapping_data_for_triangulation();
}


template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  assemble_hmatrix_preconditioner()
{
  LogStream::Prefix prefix_string("assemble_hmatrix_preconditioner");
  Timer             timer;
  timer.stop();

  // Prepare triangulation and mapping data for operator preconditioning.
  if (preconditioner_type_ == PreconditionerType::OperatorPreconditioning)
    {
      // When the operator preconditioning is used, an H-matrix assembler must
      // be adopted.
      Assert(use_hmat_, ExcInternalError());

      // Generate the refined mesh.
      mg_tria_for_preconditioner_.copy_triangulation(tria_);
      mg_tria_for_preconditioner_.refine_global();

      // Compute mapping data.
      timer.start();
      compute_mapping_data_for_refined_triangulation();
      timer.stop();
      print_wall_time(deallog, timer, "compute mapping data for refined tria");
    }

  timer.start();
  switch (problem_type_)
    {
        case DirichletBCProblem: {
          std::cout << "=== Assemble preconditioner for V1 ===" << std::endl;

          switch (preconditioner_type_)
            {
                case PreconditionerType::HMatrixFactorization: {
                  // Directly make a copy of the existing \hmat and then
                  // truncate its rank.
                  V1_hmat_preconditioner_ = *V1_hmat_;
                  V1_hmat_preconditioner_.set_spd(false);

                  // Only when the \hmat actually has a hierarchical
                  // structure, the SPD preserving rank truncation will be
                  // performed. This excludes
                  // the case when @p V1 has a single root node, which is a full
                  // matrix.
                  if (V1_hmat_preconditioner_.get_type() ==
                      HMatrixType::HierarchicalMatrixType)
                    {
                      V1_hmat_preconditioner_
                        .truncate_to_rank_preserve_positive_definite(
                          hmat_preconditioner_params_.max_rank);
                    }
                  timer.stop();
                  print_wall_time(deallog, timer, "truncate V1");
                  add_memory_consumption_row("V1 H-matrix preconditioner",
                                             V1_hmat_preconditioner_,
                                             "After assembly");

                  // Perform LU factorization of the preconditioner.
                  std::cout
                    << "=== LU factorization of the preconditioner for V ==="
                    << std::endl;
                  timer.start();
                  // Only when the \hmat actually has a hierarchical
                  // structure, the task parallel Cholesky factorization will
                  // be performed. This excludes the case when @p V1 has a
                  // single root node, which is a full matrix.
                  if (V1_hmat_preconditioner_.get_type() ==
                      HMatrixType::HierarchicalMatrixType)
                    {
                      V1_hmat_preconditioner_
                        .compute_lu_factorization_task_parallel(
                          hmat_preconditioner_params_.max_rank);
                    }
                  else
                    {
                      V1_hmat_preconditioner_.compute_lu_factorization(
                        hmat_preconditioner_params_.max_rank);
                    }
                  timer.stop();
                  print_wall_time(deallog, timer, "H-LU factorization of V1");

                  break;
                }
                case PreconditionerType::OperatorPreconditioning: {
                  op_precond_for_slp_ =
                    std::make_unique<HelmholtzAcousticSingleLayerPreconditioner<
                      dim,
                      spacedim,
                      RangeNumberType,
                      KernelNumberType>>(
                      fe_for_neumann_space_,
                      fe_for_dirichlet_space_,
                      mg_tria_for_preconditioner_,
                      neumann_space_on_dirichlet_domain_
                        ->get_internal_to_external_dof_numbering(),
                      neumann_space_on_dirichlet_domain_
                        ->get_external_to_internal_dof_numbering(),
                      op_precond_params_);

                  op_precond_for_slp_->setup_preconditioner(
                    hmat_preconditioner_params_,
                    sauter_quad_precond_params_.near_field,
                    sauter_quad_precond_params_.far_field,
                    parallel_params_,
                    subdomain_topology_,
                    mappings_,
                    material_id_to_mapping_index_,
                    mg_tria_mapping_support_points_cpu_,
                    mg_tria_mapping_support_points_gpu_,
                    mg_tria_mapping_indices_gpu_,
                    SurfaceNormalDetector<dim, spacedim>(subdomain_topology_),
                    SauterQuadratureRule<dim>(
                      sauter_quad_precond_params_.hyper_singular_order),
                    SauterQuadratureRule<dim>(
                      sauter_quad_precond_params_.slp_order),
                    QGauss<dim>(fe_for_dirichlet_space_.degree + 1));

                  timer.stop();
                  print_wall_time(deallog,
                                  timer,
                                  "build V1 operator preconditioner");

                  break;
                }
                case PreconditionerType::Identity: {
                  break;
                }
                case PreconditionerType::Jacobi: {
                  // TODO
                  Assert(false, ExcNotImplemented());

                  timer.stop();
                  print_wall_time(deallog,
                                  timer,
                                  "build V1 Jacobi preconditioner");

                  break;
                }
                default: {
                  Assert(false, ExcInternalError());
                  break;
                }
            }

          break;
        }
        case NeumannBCProblem: {
          std::cout << "=== Assemble preconditioner for D1 ===" << std::endl;
          switch (preconditioner_type_)
            {
                case PreconditionerType::HMatrixFactorization: {
                  // Directly make a copy of the existing \hmat and then
                  // truncate its rank.
                  D1_hmat_preconditioner_ = *D1_hmat_;
                  D1_hmat_preconditioner_.set_spd(false);

                  // Only when the \hmat actually has a hierarchical structure,
                  // the SPD preserving rank truncation will be performed. This
                  // excludes the case when @p D1 has a single root node, which
                  // is a full matrix.
                  if (D1_hmat_preconditioner_.get_type() ==
                      HMatrixType::HierarchicalMatrixType)
                    {
                      D1_hmat_preconditioner_
                        .truncate_to_rank_preserve_positive_definite(
                          hmat_preconditioner_params_.max_rank);
                    }
                  timer.stop();
                  print_wall_time(deallog, timer, "truncate D1");
                  add_memory_consumption_row("D1 H-matrix preconditioner",
                                             D1_hmat_preconditioner_,
                                             "After assembly");

                  // Perform H-LU factorization of the preconditioner.
                  std::cout << "=== H-LU factorization of D ===" << std::endl;
                  timer.start();
                  // Only when the \hmat actually has a hierarchical structure,
                  // the task parallel Cholesky factorization will be performed.
                  // This excludes the case when @p D1 has a single root node,
                  // which is a full matrix.
                  if (D1_hmat_preconditioner_.get_type() ==
                      HMatrixType::HierarchicalMatrixType)
                    {
                      D1_hmat_preconditioner_
                        .compute_lu_factorization_task_parallel(
                          hmat_preconditioner_params_.max_rank);
                    }
                  else
                    {
                      D1_hmat_preconditioner_.compute_lu_factorization(
                        hmat_preconditioner_params_.max_rank);
                    }
                  timer.stop();
                  print_wall_time(deallog, timer, "H-LU factorization of D1");

                  break;
                }
                case PreconditionerType::OperatorPreconditioning: {
                  op_precond_for_hyper_singular_ = std::make_unique<
                    HelmholtzAcousticHyperSingularPreconditioner<
                      dim,
                      spacedim,
                      RangeNumberType,
                      KernelNumberType>>(
                    fe_for_dirichlet_space_,
                    fe_for_neumann_space_,
                    mg_tria_for_preconditioner_,
                    dirichlet_space_on_neumann_domain_
                      ->get_internal_to_external_dof_numbering(),
                    dirichlet_space_on_neumann_domain_
                      ->get_external_to_internal_dof_numbering(),
                    op_precond_params_);

                  op_precond_for_hyper_singular_->setup_preconditioner(
                    hmat_preconditioner_params_,
                    sauter_quad_precond_params_.near_field,
                    sauter_quad_precond_params_.far_field,
                    parallel_params_,
                    subdomain_topology_,
                    mappings_,
                    material_id_to_mapping_index_,
                    mg_tria_mapping_support_points_cpu_,
                    mg_tria_mapping_support_points_gpu_,
                    mg_tria_mapping_indices_gpu_,
                    SurfaceNormalDetector<dim, spacedim>(subdomain_topology_),
                    SauterQuadratureRule<dim>(
                      sauter_quad_precond_params_.slp_order),
                    QGauss<dim>(fe_for_dirichlet_space_.degree + 1));

                  timer.stop();
                  print_wall_time(deallog,
                                  timer,
                                  "build D1 operator preconditioner");

                  break;
                }
                case PreconditionerType::Identity: {
                  break;
                }
                case PreconditionerType::Jacobi: {
                  // TODO
                  Assert(false, ExcNotImplemented());

                  timer.stop();
                  print_wall_time(deallog,
                                  timer,
                                  "build D1 Jacobi preconditioner");

                  break;
                }
                default: {
                  Assert(false, ExcInternalError());
                  break;
                }
            }

          break;
        }
        case MixedBCProblem: {
          // Assemble preconditioners for the mixed boundary value problem.
          std::cout
            << "=== Assemble preconditioner for the system block matrix ==="
            << std::endl;
          switch (preconditioner_type_)
            {
                case PreconditionerType::HMatrixFactorization: {
                  // Directly make copies of existing \hmatrices and then
                  // truncate their ranks.
                  M11_in_preconditioner_ = *V1_hmat_;
                  M11_in_preconditioner_.set_spd(false);
                  M12_in_preconditioner_ = *K1_hmat_;
                  M22_in_preconditioner_ = *D1_hmat_;
                  M22_in_preconditioner_.set_spd(false);

                  // Only when the \hmat actually has a hierarchical structure,
                  // the SPD preserving rank truncation will be performed. This
                  // excludes the case when @p M11 has a single root node, which
                  // is a full matrix.
                  if (M11_in_preconditioner_.get_type() ==
                      HMatrixType::HierarchicalMatrixType)
                    {
                      M11_in_preconditioner_
                        .truncate_to_rank_preserve_positive_definite(
                          hmat_preconditioner_params_.max_rank);
                    }
                  timer.stop();
                  print_wall_time(deallog, timer, "truncate M11(V1)");
                  add_memory_consumption_row("M11(V1) H-matrix preconditioner",
                                             M11_in_preconditioner_,
                                             "After assembly");

                  timer.start();
                  // Only when the \hmat actually has a hierarchical structure,
                  // the rank truncation will be performed. This excludes
                  // the case when @p M12 has a single root node, which is a full
                  // matrix.
                  if (M12_in_preconditioner_.get_type() ==
                      HMatrixType::HierarchicalMatrixType)
                    {
                      M12_in_preconditioner_.truncate_to_rank(
                        hmat_preconditioner_params_.max_rank);
                    }
                  timer.stop();
                  print_wall_time(deallog, timer, "truncate M12(K1)");
                  add_memory_consumption_row("M12(K1) H-matrix preconditioner",
                                             M12_in_preconditioner_,
                                             "After assembly");

                  timer.start();
                  // Only when the \hmat actually has a hierarchical structure,
                  // the SPD preserving rank truncation will be performed. This
                  // excludes the case when @p M22 has a single root node, which
                  // is a full matrix.
                  if (M22_in_preconditioner_.get_type() ==
                      HMatrixType::HierarchicalMatrixType)
                    {
                      M22_in_preconditioner_
                        .truncate_to_rank_preserve_positive_definite(
                          hmat_preconditioner_params_.max_rank);
                    }
                  timer.stop();
                  print_wall_time(deallog, timer, "truncate M22(D1)");
                  add_memory_consumption_row("M22(D1) H-matrix preconditioner",
                                             M22_in_preconditioner_,
                                             "After assembly");

                  M_hmat_preconditioner_ = std::make_unique<
                    HBlockMatrixSkewSymmPreconditioner<spacedim,
                                                       RangeNumberType>>(
                    M11_in_preconditioner_,
                    M12_in_preconditioner_,
                    M22_in_preconditioner_);

                  // Perform \hmat-LU factorization to the block preconditioner.
                  std::cout
                    << "=== H-LU factorization of system block matrix ==="
                    << std::endl;
                  timer.start();
                  M_hmat_preconditioner_->compute_lu_factorization(
                    hmat_preconditioner_params_.max_rank);
                  timer.stop();
                  print_wall_time(deallog, timer, "H-LU factorization of M");

                  break;
                }
                case PreconditionerType::OperatorPreconditioning: {
                  // Collect material ids into sets.
                  std::set<types::material_id> dirichlet_domain_material_ids;
                  for (const auto &bc : dirichlet_bc_definition_)
                    dirichlet_domain_material_ids.insert(bc.first);

                  op_precond_for_slp_ =
                    std::make_unique<HelmholtzAcousticSingleLayerPreconditioner<
                      dim,
                      spacedim,
                      RangeNumberType,
                      KernelNumberType>>(
                      fe_for_neumann_space_,
                      fe_for_dirichlet_space_,
                      mg_tria_for_preconditioner_,
                      neumann_space_on_dirichlet_domain_
                        ->get_internal_to_external_dof_numbering(),
                      neumann_space_on_dirichlet_domain_
                        ->get_external_to_internal_dof_numbering(),
                      dirichlet_domain_material_ids,
                      op_precond_params_);

                  op_precond_for_slp_->setup_preconditioner(
                    hmat_preconditioner_params_,
                    sauter_quad_precond_params_.near_field,
                    sauter_quad_precond_params_.far_field,
                    parallel_params_,
                    subdomain_topology_,
                    mappings_,
                    material_id_to_mapping_index_,
                    mg_tria_mapping_support_points_cpu_,
                    mg_tria_mapping_support_points_gpu_,
                    mg_tria_mapping_indices_gpu_,
                    SurfaceNormalDetector<dim, spacedim>(subdomain_topology_),
                    SauterQuadratureRule<dim>(
                      sauter_quad_precond_params_.hyper_singular_order),
                    SauterQuadratureRule<dim>(
                      sauter_quad_precond_params_.slp_order),
                    QGauss<dim>(fe_for_dirichlet_space_.degree + 1));

                  timer.stop();
                  print_wall_time(deallog,
                                  timer,
                                  "build V1 operator preconditioner");

                  timer.start();
                  std::set<types::material_id> neumann_domain_material_ids;
                  for (const auto &bc : neumann_bc_definition_)
                    neumann_domain_material_ids.insert(bc.first);

                  op_precond_for_hyper_singular_ = std::make_unique<
                    HelmholtzAcousticHyperSingularPreconditioner<
                      dim,
                      spacedim,
                      RangeNumberType,
                      KernelNumberType>>(
                    fe_for_dirichlet_space_,
                    fe_for_neumann_space_,
                    mg_tria_for_preconditioner_,
                    dirichlet_space_on_neumann_domain_
                      ->get_internal_to_external_dof_numbering(),
                    dirichlet_space_on_neumann_domain_
                      ->get_external_to_internal_dof_numbering(),
                    neumann_domain_material_ids,
                    op_precond_params_);

                  op_precond_for_hyper_singular_->setup_preconditioner(
                    hmat_preconditioner_params_,
                    sauter_quad_precond_params_.near_field,
                    sauter_quad_precond_params_.far_field,
                    parallel_params_,
                    subdomain_topology_,
                    mappings_,
                    material_id_to_mapping_index_,
                    mg_tria_mapping_support_points_cpu_,
                    mg_tria_mapping_support_points_gpu_,
                    mg_tria_mapping_indices_gpu_,
                    SurfaceNormalDetector<dim, spacedim>(subdomain_topology_),
                    SauterQuadratureRule<dim>(
                      sauter_quad_precond_params_.slp_order),
                    QGauss<dim>(fe_for_dirichlet_space_.degree + 1));

                  timer.stop();
                  print_wall_time(deallog,
                                  timer,
                                  "build D1 operator preconditioner");

                  break;
                }
                case PreconditionerType::Identity: {
                  break;
                }
                case PreconditionerType::Jacobi: {
                  Assert(false, ExcNotImplemented());

                  // TODO: Build V1 Jacobi preconditioner
                  timer.stop();
                  print_wall_time(deallog,
                                  timer,
                                  "build V1 Jacobi preconditioner");

                  timer.start();
                  // TODO: Build D1 Jacobi preconditioner
                  timer.stop();
                  print_wall_time(deallog,
                                  timer,
                                  "build D1 Jacobi preconditioner");

                  break;
                }
                default: {
                  Assert(false, ExcInternalError());
                  break;
                }
            }

          break;
        }
        default: {
          Assert(false, ExcInternalError());
          break;
        }
    }

  if (preconditioner_type_ == PreconditionerType::OperatorPreconditioning)
    release_mapping_data_for_refined_triangulation();
}


template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  solve()
{
#if ENABLE_NVTX == 1
  HierBEM::CUDAWrappers::NVTXRange nvtx_range("solve");
#endif

  std::cout << "=== Solve problem ===" << std::endl;

  if (!use_hmat_)
    {
      switch (problem_type_)
        {
            case DirichletBCProblem: {
              SolverControl solver_control(linear_solver_params_.max_iter,
                                           linear_solver_params_.abs_tol,
                                           linear_solver_params_.log_history,
                                           linear_solver_params_.log_result);
              SolverDQGMRES<Vector<RangeNumberType>> solver(solver_control);

              solver.solve(V1_mat_,
                           neumann_data_,
                           system_rhs_on_dirichlet_domain_,
                           PreconditionIdentity());

              break;
            }
            case NeumannBCProblem: {
              SolverControl solver_control(linear_solver_params_.max_iter,
                                           linear_solver_params_.abs_tol,
                                           linear_solver_params_.log_history,
                                           linear_solver_params_.log_result);
              SolverDQGMRES<Vector<RangeNumberType>> solver(solver_control);

              solver.solve(D1_mat_,
                           dirichlet_data_,
                           system_rhs_on_neumann_domain_,
                           PreconditionIdentity());

              break;
            }
            case MixedBCProblem: {
              Assert(false, ExcNotImplemented());
              break;
            }
            default: {
              Assert(false, ExcInternalError());
              break;
            }
        }
    }
  else
    {
      switch (problem_type_)
        {
            case DirichletBCProblem: {
              SolverControl solver_control(linear_solver_params_.max_iter,
                                           linear_solver_params_.abs_tol,
                                           linear_solver_params_.log_history,
                                           linear_solver_params_.log_result);
              SolverDQGMRES<Vector<RangeNumberType>> solver(solver_control);

              set_hmatrix_vmult_strategy_for_iterative_solver(*V1_hmat_,
                                                              vmult_type_,
                                                              true,
                                                              true);
              switch (preconditioner_type_)
                {
                    case PreconditionerType::HMatrixFactorization: {
                      solver.solve(
                        *V1_hmat_,
                        neumann_data_on_dirichlet_domain_internal_dof_numbering_,
                        system_rhs_on_dirichlet_domain_,
                        V1_hmat_preconditioner_);

                      break;
                    }
                    case PreconditionerType::OperatorPreconditioning: {
                      set_hmatrix_vmult_strategy_for_iterative_solver(
                        op_precond_for_slp_->get_preconditioner_hmatrix(),
                        vmult_type_,
                        true,
                        true);
                      solver.solve(
                        *V1_hmat_,
                        neumann_data_on_dirichlet_domain_internal_dof_numbering_,
                        system_rhs_on_dirichlet_domain_,
                        *op_precond_for_slp_);

                      mg_tria_for_preconditioner_.clear();
                      op_precond_for_slp_ = nullptr;

                      break;
                    }
                    case PreconditionerType::Identity: {
                      solver.solve(
                        *V1_hmat_,
                        neumann_data_on_dirichlet_domain_internal_dof_numbering_,
                        system_rhs_on_dirichlet_domain_,
                        PreconditionIdentity());

                      break;
                    }
                    case PreconditionerType::Jacobi: {
                      // TODO
                      Assert(false, ExcNotImplemented());
                      break;
                    }
                    default: {
                      Assert(false, ExcInternalError());
                      break;
                    }
                }

              neumann_space_on_dirichlet_domain_->convert_vector_i2e(
                neumann_data_on_dirichlet_domain_internal_dof_numbering_,
                neumann_data_);

              break;
            }
            case NeumannBCProblem: {
              SolverControl solver_control(linear_solver_params_.max_iter,
                                           linear_solver_params_.abs_tol,
                                           linear_solver_params_.log_history,
                                           linear_solver_params_.log_result);
              SolverDQGMRES<Vector<RangeNumberType>> solver(solver_control);

              set_hmatrix_vmult_strategy_for_iterative_solver(*D1_hmat_,
                                                              vmult_type_,
                                                              true,
                                                              true);
              switch (preconditioner_type_)
                {
                    case PreconditionerType::HMatrixFactorization: {
                      solver.solve(
                        *D1_hmat_,
                        dirichlet_data_on_neumann_domain_internal_dof_numbering_,
                        system_rhs_on_neumann_domain_,
                        D1_hmat_preconditioner_);

                      break;
                    }
                    case PreconditionerType::OperatorPreconditioning: {
                      set_hmatrix_vmult_strategy_for_iterative_solver(
                        op_precond_for_hyper_singular_
                          ->get_preconditioner_hmatrix(),
                        vmult_type_,
                        true,
                        true);
                      solver.solve(
                        *D1_hmat_,
                        dirichlet_data_on_neumann_domain_internal_dof_numbering_,
                        system_rhs_on_neumann_domain_,
                        *op_precond_for_hyper_singular_);

                      mg_tria_for_preconditioner_.clear();
                      op_precond_for_hyper_singular_ = nullptr;

                      break;
                    }
                    case PreconditionerType::Identity: {
                      solver.solve(
                        *D1_hmat_,
                        dirichlet_data_on_neumann_domain_internal_dof_numbering_,
                        system_rhs_on_neumann_domain_,
                        PreconditionIdentity());

                      break;
                    }
                    case PreconditionerType::Jacobi: {
                      // TODO
                      Assert(false, ExcNotImplemented());
                      break;
                    }
                    default: {
                      Assert(false, ExcInternalError());
                      break;
                    }
                }

              dirichlet_space_on_neumann_domain_->convert_vector_i2e(
                dirichlet_data_on_neumann_domain_internal_dof_numbering_,
                dirichlet_data_);

              break;
            }
            case MixedBCProblem: {
              // Solve the system of equations and obtain the solution in two
              // block vectors in the internal DoF numbering.
              set_hmatrix_vmult_strategy_for_iterative_solver(
                M_hmat_->get_M11(), vmult_type_, true, true);
              set_hmatrix_vmult_strategy_for_iterative_solver(
                M_hmat_->get_M12(), vmult_type_, true, true);
              set_hmatrix_vmult_strategy_for_iterative_solver(
                M_hmat_->get_M22(), vmult_type_, true, true);
              switch (preconditioner_type_)
                {
                    case PreconditionerType::HMatrixFactorization: {
                      SolverControl solver_control(
                        linear_solver_params_.max_iter,
                        linear_solver_params_.abs_tol,
                        linear_solver_params_.log_history,
                        linear_solver_params_.log_result);
                      SolverBicgstabGeneral<Vector<RangeNumberType>> solver(
                        solver_control);

                      // In this case, H-LU for skew symmetric block H-matrix is
                      // adopted to solve the system of equations.
                      solver.solve(
                        *M_hmat_,
                        solution_on_combined_domain_internal_dof_numbering_,
                        system_rhs_on_combined_domain_,
                        *M_hmat_preconditioner_);

                      // Split the solution vector into two parts.
                      copy_vector(
                        neumann_data_on_dirichlet_domain_internal_dof_numbering_,
                        0,
                        solution_on_combined_domain_internal_dof_numbering_,
                        0,
                        neumann_data_on_dirichlet_domain_internal_dof_numbering_
                          .size());
                      copy_vector(
                        dirichlet_data_on_neumann_domain_internal_dof_numbering_,
                        0,
                        solution_on_combined_domain_internal_dof_numbering_,
                        neumann_data_on_dirichlet_domain_internal_dof_numbering_
                          .size(),
                        dirichlet_data_on_neumann_domain_internal_dof_numbering_
                          .size());

                      break;
                    }
                    case PreconditionerType::OperatorPreconditioning: {
                      // In this case, Schur complement method is adopted to
                      // solve the system of equations, which is different from
                      // using the H-matrix factorization method.
                      set_hmatrix_vmult_strategy_for_iterative_solver(
                        op_precond_for_slp_->get_preconditioner_hmatrix(),
                        vmult_type_,
                        true,
                        true);
                      set_hmatrix_vmult_strategy_for_iterative_solver(
                        op_precond_for_hyper_singular_
                          ->get_preconditioner_hmatrix(),
                        vmult_type_,
                        true,
                        true);
                      solve_hblockmatrix_skew_symm_using_schur_complement(
                        *M_hmat_,
                        neumann_data_on_dirichlet_domain_internal_dof_numbering_,
                        dirichlet_data_on_neumann_domain_internal_dof_numbering_,
                        system_rhs_on_dirichlet_domain_,
                        system_rhs_on_neumann_domain_,
                        *op_precond_for_slp_,
                        *op_precond_for_hyper_singular_,
                        linear_solver_params_);

                      mg_tria_for_preconditioner_.clear();
                      op_precond_for_slp_            = nullptr;
                      op_precond_for_hyper_singular_ = nullptr;

                      // Combine the two block vectors into one vector.
                      copy_vector(
                        solution_on_combined_domain_internal_dof_numbering_,
                        0,
                        neumann_data_on_dirichlet_domain_internal_dof_numbering_,
                        0,
                        neumann_data_on_dirichlet_domain_internal_dof_numbering_
                          .size());
                      copy_vector(
                        solution_on_combined_domain_internal_dof_numbering_,
                        neumann_data_on_dirichlet_domain_internal_dof_numbering_
                          .size(),
                        dirichlet_data_on_neumann_domain_internal_dof_numbering_,
                        0,
                        dirichlet_data_on_neumann_domain_internal_dof_numbering_
                          .size());

                      break;
                    }
                    case PreconditionerType::Identity: {
                      // In this case, Schur complement method is adopted to
                      // solve the system of equations.
                      solve_hblockmatrix_skew_symm_using_schur_complement(
                        *M_hmat_,
                        neumann_data_on_dirichlet_domain_internal_dof_numbering_,
                        dirichlet_data_on_neumann_domain_internal_dof_numbering_,
                        system_rhs_on_dirichlet_domain_,
                        system_rhs_on_neumann_domain_,
                        PreconditionIdentity(),
                        PreconditionIdentity(),
                        linear_solver_params_);

                      // Combine the two block vectors in the internal DoF
                      // numbering into one vector.
                      copy_vector(
                        solution_on_combined_domain_internal_dof_numbering_,
                        0,
                        neumann_data_on_dirichlet_domain_internal_dof_numbering_,
                        0,
                        neumann_data_on_dirichlet_domain_internal_dof_numbering_
                          .size());
                      copy_vector(
                        solution_on_combined_domain_internal_dof_numbering_,
                        neumann_data_on_dirichlet_domain_internal_dof_numbering_
                          .size(),
                        dirichlet_data_on_neumann_domain_internal_dof_numbering_,
                        0,
                        dirichlet_data_on_neumann_domain_internal_dof_numbering_
                          .size());

                      break;
                    }
                    case PreconditionerType::Jacobi: {
                      // TODO
                      Assert(false, ExcNotImplemented());
                      break;
                    }
                    default: {
                      Assert(false, ExcInternalError());
                      break;
                    }
                }

              neumann_space_on_dirichlet_domain_->convert_vector_i2e(
                neumann_data_on_dirichlet_domain_internal_dof_numbering_,
                neumann_data_on_dirichlet_domain_);
              dirichlet_space_on_neumann_domain_->convert_vector_i2e(
                dirichlet_data_on_neumann_domain_internal_dof_numbering_,
                dirichlet_data_on_neumann_domain_);

              // Combine the Dirichlet solution on the Neumann domain in the
              // external DoF numbering and the Dirichlet boundary condition
              // vector to form the complete Dirichlet data.
              dirichlet_space_on_neumann_domain_
                ->assemble_selected_dofs_into_full_dofs(
                  dirichlet_data_on_neumann_domain_, dirichlet_data_);
              dirichlet_space_on_dirichlet_domain_
                ->assemble_selected_dofs_into_full_dofs(
                  dirichlet_bc_on_selected_dofs_, dirichlet_data_);

              // Combine the Neumann solution on the Dirichlet domain in the
              // external DoF numbering and the Neumann boundary condition
              // vector to form the complete Neumann data.
              neumann_space_on_dirichlet_domain_
                ->assemble_selected_dofs_into_full_dofs(
                  neumann_data_on_dirichlet_domain_, neumann_data_);
              neumann_space_on_neumann_domain_
                ->assemble_selected_dofs_into_full_dofs(
                  neumann_bc_on_selected_dofs_, neumann_data_);

              break;
            }
            default: {
              Assert(false, ExcInternalError());
              break;
            }
        }
    }
}


template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  output_results() const
{
  std::cout << "=== Output results ===" << std::endl;

  std::ofstream          vtk_output;
  DataOut<dim, spacedim> data_out;
  std::ofstream          data_file(project_name_ + std::string(".output"));

  switch (problem_type_)
    {
        case DirichletBCProblem: {
          vtk_output.open(project_name_ + std::string(".vtk"),
                          std::ofstream::out);

          if constexpr (numbers::NumberTraits<RangeNumberType>::is_complex)
            {
              ComplexOutputDataVector<Vector, real_type> neumann_data_vector(
                neumann_data_);
              ComplexOutputDataVector<Vector, real_type> dirichlet_data_vector(
                dirichlet_bc_);

              add_complex_data_vector(data_out,
                                      dof_handler_for_neumann_space_,
                                      neumann_data_vector,
                                      "neumann_data");
              add_complex_data_vector(data_out,
                                      dof_handler_for_dirichlet_space_,
                                      dirichlet_data_vector,
                                      "dirichlet_data");

              data_out.build_patches();
              data_out.write_vtk(vtk_output);
            }
          else
            {
              data_out.add_data_vector(dof_handler_for_neumann_space_,
                                       neumann_data_,
                                       "neumann_data");
              data_out.add_data_vector(dof_handler_for_dirichlet_space_,
                                       dirichlet_bc_,
                                       "dirichlet_data");

              data_out.build_patches();
              data_out.write_vtk(vtk_output);
            }

          print_vector_to_mat(data_file, "solution", neumann_data_, false);

          break;
        }
        case NeumannBCProblem: {
          vtk_output.open(project_name_ + std::string(".vtk"),
                          std::ofstream::out);

          if constexpr (numbers::NumberTraits<RangeNumberType>::is_complex)
            {
              ComplexOutputDataVector<Vector, real_type> dirichlet_data_vector(
                dirichlet_data_);
              ComplexOutputDataVector<Vector, real_type> neumann_data_vector(
                neumann_bc_);

              add_complex_data_vector(data_out,
                                      dof_handler_for_dirichlet_space_,
                                      dirichlet_data_vector,
                                      "dirichlet_data");
              add_complex_data_vector(data_out,
                                      dof_handler_for_neumann_space_,
                                      neumann_data_vector,
                                      "neumann_data");

              data_out.build_patches();
              data_out.write_vtk(vtk_output);
            }
          else
            {
              data_out.add_data_vector(dof_handler_for_dirichlet_space_,
                                       dirichlet_data_,
                                       "dirichlet_data");
              data_out.add_data_vector(dof_handler_for_neumann_space_,
                                       neumann_bc_,
                                       "neumann_data");

              data_out.build_patches();
              data_out.write_vtk(vtk_output);
            }

          print_vector_to_mat(data_file, "solution", dirichlet_data_, false);

          break;
        }
        case MixedBCProblem: {
          vtk_output.open(project_name_ + std::string(".vtk"),
                          std::ofstream::out);

          if constexpr (numbers::NumberTraits<RangeNumberType>::is_complex)
            {
              ComplexOutputDataVector<Vector, real_type> dirichlet_data_vector(
                dirichlet_data_);
              ComplexOutputDataVector<Vector, real_type> neumann_data_vector(
                neumann_data_);

              add_complex_data_vector(data_out,
                                      dof_handler_for_dirichlet_space_,
                                      dirichlet_data_vector,
                                      "dirichlet_data");
              add_complex_data_vector(data_out,
                                      dof_handler_for_neumann_space_,
                                      neumann_data_vector,
                                      "neumann_data");

              data_out.build_patches();
              data_out.write_vtk(vtk_output);
            }
          else
            {
              data_out.add_data_vector(dof_handler_for_dirichlet_space_,
                                       dirichlet_data_,
                                       "dirichlet_data");
              data_out.add_data_vector(dof_handler_for_neumann_space_,
                                       neumann_data_,
                                       "neumann_data");

              data_out.build_patches();
              data_out.write_vtk(vtk_output);
            }

          constexpr unsigned int field_width =
            numbers::NumberTraits<RangeNumberType>::is_complex ? 35 : 25;
          print_vector_to_mat(
            data_file,
            "solution_on_combined_domain_internal_dof_numbering",
            solution_on_combined_domain_internal_dof_numbering_,
            false,
            15,
            field_width);
          print_vector_to_mat(
            data_file, "neumann_data", neumann_data_, false, 15, field_width);
          print_vector_to_mat(data_file,
                              "dirichlet_data",
                              dirichlet_data_,
                              false,
                              15,
                              field_width);

          break;
        }
        default: {
          Assert(false, ExcInternalError());
          break;
        }
    }

  vtk_output.close();
  data_file.close();
}


template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  output_results_on_target_tria(const std::string                  &vtk_file,
                                const Triangulation<dim, spacedim> &target_tria,
                                const unsigned int mapping_order) const
{
  // Define volume integral operators, which will be evaluated on CPU.
  SingleLayerKernel<spacedim, KernelNumberType> V;
  DoubleLayerKernel<spacedim, KernelNumberType> K;

  AdjointDoubleLayerKernel<spacedim, KernelNumberType> K_prime;
  HyperSingularKernel<spacedim, KernelNumberType>      D;

  // Evaluate potentials on the target triangulation.
  DoFHandler<dim, spacedim> dof_handler_target_potential(target_tria);
  dof_handler_target_potential.distribute_dofs(fe_for_dirichlet_space_);
  Vector<RangeNumberType> potentials(dof_handler_target_potential.n_dofs());

  evaluate_representation_formula_for_potential(
    V,
    K,
    dof_handler_for_dirichlet_space_,
    dof_handler_for_neumann_space_,
    dirichlet_data_,
    neumann_data_,
    dof_handler_target_potential,
    mapping_order,
    potentials,
    is_interior_problem_);

  // Evaluate conormal traces on the target triangulation.
  DoFHandler<dim, spacedim> dof_handler_target_conormal_trace(target_tria);
  dof_handler_target_conormal_trace.distribute_dofs(fe_for_neumann_space_);
  Vector<RangeNumberType> conormal_traces(
    dof_handler_target_conormal_trace.n_dofs());

  evaluate_representation_formula_for_conormal_trace(
    K_prime,
    D,
    dof_handler_for_dirichlet_space_,
    dof_handler_for_neumann_space_,
    dirichlet_data_,
    neumann_data_,
    dof_handler_target_conormal_trace,
    mapping_order,
    conormal_traces,
    is_interior_problem_);

  std::ofstream          vtk_out(vtk_file);
  DataOut<dim, spacedim> data_out;

  if constexpr (numbers::NumberTraits<RangeNumberType>::is_complex)
    {
      ComplexOutputDataVector<Vector, real_type> potentials_vector(potentials);
      add_complex_data_vector(data_out,
                              dof_handler_target_potential,
                              potentials_vector,
                              "potentials");
      ComplexOutputDataVector<Vector, real_type> conormal_traces_vector(
        conormal_traces);
      add_complex_data_vector(data_out,
                              dof_handler_target_conormal_trace,
                              conormal_traces_vector,
                              "conormal_traces");
      data_out.build_patches();
    }
  else
    {
      data_out.add_data_vector(dof_handler_target_potential,
                               potentials,
                               "potentials");
      data_out.add_data_vector(dof_handler_target_conormal_trace,
                               conormal_traces,
                               "conormal_traces");
      data_out.build_patches();
    }

  data_out.write_vtk(vtk_out);
  vtk_out.close();
}


template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  output_results_on_target_tria(
    const std::string                      &vtk_file,
    const Triangulation<dim + 1, spacedim> &target_tria,
    const unsigned int                      mapping_order) const
{
  // Define volume integral operators, which will be evaluated on CPU.
  SingleLayerKernel<spacedim, KernelNumberType> V;
  DoubleLayerKernel<spacedim, KernelNumberType> K;

  // Evaluate potential on the target triangulation.
  DoFHandler<3, spacedim> dof_handler_target_potential(target_tria);
  FE_Q<3, spacedim>       fe_dirichlet_target(fe_order_for_dirichlet_space_);
  dof_handler_target_potential.distribute_dofs(fe_dirichlet_target);
  Vector<RangeNumberType> potentials(dof_handler_target_potential.n_dofs());

  evaluate_representation_formula_for_potential(
    V,
    K,
    dof_handler_for_dirichlet_space_,
    dof_handler_for_neumann_space_,
    dirichlet_data_,
    neumann_data_,
    dof_handler_target_potential,
    mapping_order,
    potentials,
    is_interior_problem_);

  std::ofstream        vtk_out(vtk_file);
  DataOut<3, spacedim> data_out;

  if constexpr (numbers::NumberTraits<RangeNumberType>::is_complex)
    {
      ComplexOutputDataVector<Vector, real_type> potentials_vector(potentials);
      add_complex_data_vector(data_out,
                              dof_handler_target_potential,
                              potentials_vector,
                              "potentials");
      data_out.build_patches();
    }
  else
    {
      data_out.add_data_vector(dof_handler_target_potential,
                               potentials,
                               "potentials");
      data_out.build_patches();
    }

  data_out.write_vtk(vtk_out);
  vtk_out.close();
}


template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  run()
{
  LogStream::Prefix prefix_string("run");
#if ENABLE_NVTX == 1
  HierBEM::CUDAWrappers::NVTXRange nvtx_range("run");
#endif

  Timer timer;
  setup_system();
  timer.stop();
  print_wall_time(deallog, timer, "setup system");

  if (!use_hmat_)
    {
      timer.start();
      assemble_full_matrix_system();
      timer.stop();
      print_wall_time(deallog, timer, "assemble full matrix system");
    }
  else
    {
      timer.start();
      assemble_hmatrix_system();
      timer.stop();
      print_wall_time(deallog, timer, "assemble H-matrix system");

      timer.start();
      assemble_hmatrix_preconditioner();
      timer.stop();
      print_wall_time(deallog, timer, "assemble H-matrix preconditioner");
    }

  timer.start();
  solve();
  timer.stop();
  print_wall_time(deallog, timer, "solve equation");

  timer.start();
  output_results();
  timer.stop();
  print_wall_time(deallog, timer, "output results");
}


template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::Priv::
  print_memory_consumption_table(std::ostream &out) const
{
  memory_consumption_table_.write_text(
    out, TableHandler::TextOutputFormat::org_mode_table);
}

