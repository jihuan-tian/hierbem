          typename KernelNumberType>
inline void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::
  set_use_hmat(bool useHmat)
{
  priv_->use_hmat_ = useHmat;
}

template <int dim,
          int spacedim,
          typename RangeNumberType,
          typename KernelNumberType>
inline void
HelmholtzAcousticBEM<dim, spacedim, RangeNumberType, KernelNumberType>::
  set_iterative_solver_vmult_type(const IterativeSolverVmultType type)
{
  priv_->vmult_type_ = type;
  // When the H-matrix/vector multiplication type is task-parallel, we should
  // iterate over the leaf set of each H-matrix by following the Hilbert space
  // curve.
  if (type == IterativeSolverVmultType::TaskParallel)
    {
      HMatrix<spacedim, RangeNumberType>::set_leaf_set_traversal_method(
        HMatrix<spacedim, RangeNumberType>::SpaceFillingCurveType::Hilbert);
    }
}

