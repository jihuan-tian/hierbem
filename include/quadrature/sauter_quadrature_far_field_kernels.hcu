/**
 * @file sauter_quadrature_far_field_kernels.hcu
 * @brief CUDA kernel functions related to Sauter quadrature used for assembling
 * far field H-matrix blocks.
 * @ingroup sauter_quadrature
 *
 * @date 2026-03-14
 * @author Jihuan Tian
 */
#ifndef HIERBEM_INCLUDE_QUADRATURE_SAUTER_QUADRATURE_FAR_FIELD_KERNELS_H_
#define HIERBEM_INCLUDE_QUADRATURE_SAUTER_QUADRATURE_FAR_FIELD_KERNELS_H_

#include <deal.II/base/numbers.h>
#include <deal.II/base/point.h>
#include <deal.II/base/tensor.h>

#include <cuda_runtime.h>

#include "bem/cu_bem_values.hcu"
#include "bem/types.h"
#include "config.h"
#include "platform_shared/tensor.h"
#include "platform_shared/utilities.h"
#include "sauter_quadrature_task_scalar_data_far_field.h"
#include "utilities/number_traits.h"

HBEM_NS_OPEN

using namespace dealii;

namespace CUDAWrappers
{
  /**
   * Process all Sauter quadrature tasks in the buffer which is used for
   * assembling a row or column vector in a far field \hmat.
   */
  template <int dim,
            int spacedim,
            template <int, typename>
            typename KernelFunctionType,
            typename CUDAKernelNumberType = double>
  __global__ void
  process_sauter_tasks_in_buffer_for_far_field_hmat_vector(
    const KernelFunctionType<spacedim, CUDAKernelNumberType> kernel,
    const CUDAKernelNumberType                               kernel_factor,
    SauterQuadratureTaskScalarDataFarField *scalar_data_buffer_gpu,
    CUDAKernelNumberType                   *values_at_all_quad_points_gpu,
    const unsigned int                      task_num,
    const CUDABEMValues<
      dim,
      spacedim,
      typename numbers::NumberTraits<CUDAKernelNumberType>::real_type>
      bem_values)
  {
    using real_type =
      typename numbers::NumberTraits<CUDAKernelNumberType>::real_type;

    /**
     * @internal We use a 2D thread block, the first dimension represents task
     * index, while the second dimension represents quadrature point index.
     */
    const unsigned int task_index = blockIdx.x * blockDim.x + threadIdx.x;
    const unsigned int quad_no    = blockIdx.y * blockDim.y + threadIdx.y;

    const unsigned int n_quad_points = bem_values.quad_rule_for_regular.size();
    const unsigned int n_quad_points_4d =
      HierBEM::PlatformShared::Utilities::fixed_power<2>(n_quad_points);

    if (task_index < task_num && quad_no < n_quad_points_4d)
      {
        // Convert the 4D quadrature point index to two 2D quadrature
        // indices, which are used for accessing precomputed data tables for
        // the regular cell neighboring type.
        const unsigned int kx_quad_no = quad_no % n_quad_points;
        const unsigned int ky_quad_no = quad_no / n_quad_points;

        CUDAKernelNumberType     quad_value;
        types::global_cell_index kx_cell_index_local =
          scalar_data_buffer_gpu[task_index].kx_cell_index_local;
        types::global_cell_index ky_cell_index_local =
          scalar_data_buffer_gpu[task_index].ky_cell_index_local;

        if (kernel.kernel_type == KernelType::HyperSingularRegular)
          {
            quad_value =
              kernel.value(
                bem_values.quad_points_for_regular(kx_cell_index_local,
                                                   kx_quad_no),
                bem_values.quad_points_for_regular(ky_cell_index_local,
                                                   ky_quad_no),
                bem_values.normals_at_quad_points_for_regular(
                  kx_cell_index_local, kx_quad_no),
                bem_values.normals_at_quad_points_for_regular(
                  ky_cell_index_local, ky_quad_no)) *
              bem_values.JxW_at_quad_points_for_regular(kx_cell_index_local,
                                                        kx_quad_no) *
              bem_values.JxW_at_quad_points_for_regular(ky_cell_index_local,
                                                        ky_quad_no) *
              HierBEM::PlatformShared::scalar_product(
                bem_values.kx_shape_curls_at_quad_points_for_regular(
                  kx_cell_index_local,
                  scalar_data_buffer_gpu[task_index].i_local_index,
                  kx_quad_no),
                bem_values.ky_shape_curls_at_quad_points_for_regular(
                  ky_cell_index_local,
                  scalar_data_buffer_gpu[task_index].j_local_index,
                  ky_quad_no));
          }
        else
          {
            quad_value =
              kernel.value(
                bem_values.quad_points_for_regular(kx_cell_index_local,
                                                   kx_quad_no),
                bem_values.quad_points_for_regular(ky_cell_index_local,
                                                   ky_quad_no),
                bem_values.normals_at_quad_points_for_regular(
                  kx_cell_index_local, kx_quad_no),
                bem_values.normals_at_quad_points_for_regular(
                  ky_cell_index_local, ky_quad_no)) *
              bem_values.JxW_at_quad_points_for_regular(kx_cell_index_local,
                                                        kx_quad_no) *
              bem_values.JxW_at_quad_points_for_regular(ky_cell_index_local,
                                                        ky_quad_no) *
              bem_values.kx_shape_value_table_for_regular(
                scalar_data_buffer_gpu[task_index].i_local_index, kx_quad_no) *
              bem_values.ky_shape_value_table_for_regular(
                scalar_data_buffer_gpu[task_index].j_local_index, ky_quad_no);
          }

        /**
         * @internal Save the scaled quadrature value to the result buffer.
         */
        values_at_all_quad_points_gpu[task_index * n_quad_points_4d + quad_no] =
          quad_value * kernel_factor;
      }
  }


  /**
   * Accumulate quadrature values at all quadrature points for all tasks
   * associated with each vector element.
   *
   * @param n_vector_entries
   * @param n_quad_points_4d Number of 4D quadrature points
   * @param starting_task_indices_for_dof_pairs_gpu
   * @param values_at_all_quad_points_gpu
   * @param vector_element_values_gpu
   */
  template <typename CUDARangeNumberType, typename CUDAKernelNumberType>
  __global__ void
  accumulate_quadrature_values_into_vector(
    const unsigned int          n_vector_entries,
    const unsigned int          n_quad_points_4d,
    unsigned int               *starting_task_indices_for_dof_pairs_gpu,
    const CUDAKernelNumberType *values_at_all_quad_points_gpu,
    CUDARangeNumberType        *vector_element_values_gpu)
  {
    /**
     * @internal Here we use 1D thread block and the thread index @p idx is
     * used as the element index in the vector.
     */
    const unsigned int idx = blockIdx.x * blockDim.x + threadIdx.x;

    if (idx < n_vector_entries)
      {
        /**
         * @internal Accumulation of results into a register variable.
         */
        CUDARangeNumberType vector_element = CUDARangeNumberType();

        for (unsigned int task_index =
               starting_task_indices_for_dof_pairs_gpu[idx];
             task_index < starting_task_indices_for_dof_pairs_gpu[idx + 1];
             task_index++)
          {
            const unsigned int starting_index_in_result_vector =
              task_index * n_quad_points_4d;
            for (unsigned int q = 0; q < n_quad_points_4d; q++)
              {
                vector_element += values_at_all_quad_points_gpu
                  [starting_index_in_result_vector + q];
              }
          }

        /**
         * @internal Copy the accumulated results from the register to the
         * buffer in the global memory.
         */
        vector_element_values_gpu[idx] = vector_element;
      }
  }
} // namespace CUDAWrappers

HBEM_NS_CLOSE

#endif // HIERBEM_INCLUDE_QUADRATURE_SAUTER_QUADRATURE_FAR_FIELD_KERNELS_H_
