/**
 * @file sauter_quadrature_near_field_kernels.hcu
 * @brief CUDA kernel functions related to Sauter quadrature used for assembling
 * near field H-matrix blocks.
 * @ingroup sauter_quadrature
 *
 * @date 2026-03-15
 * @author Jihuan Tian
 */
#ifndef HIERBEM_INCLUDE_QUADRATURE_SAUTER_QUADRATURE_NEAR_FIELD_KERNELS_H_
#define HIERBEM_INCLUDE_QUADRATURE_SAUTER_QUADRATURE_NEAR_FIELD_KERNELS_H_

#include <deal.II/base/numbers.h>
#include <deal.II/base/point.h>
#include <deal.II/base/tensor.h>

#include "bem/cu_bem_values.hcu"
#include "bem/types.h"
#include "config.h"
#include "linear_algebra/cu_table.hcu"
#include "platform_shared/bem_tools.h"
#include "platform_shared/full_matrix_wrapper.h"
#include "platform_shared/tensor.h"
#include "platform_shared/utilities.h"
#include "sauter_quadrature_task_scalar_data_near_field.h"
#include "utilities/number_traits.h"

HBEM_NS_OPEN

namespace CUDAWrappers
{
  /**
   * Compute Sauter quadratures of a task batch for the same panel cell
   * neighboring type during near field H-matrix block assembly.
   *
   * Each quadrature task corresponds to a pair of shape functions associated
   * with a pair of global DoF indices.
   */
  template <int dim,
            int spacedim,
            template <int, typename>
            typename KernelFunctionType,
            typename CUDAKernelNumberType = double>
  __global__ void
  process_near_field_sauter_task_batch_same_panel(
    const KernelFunctionType<spacedim, CUDAKernelNumberType> kernel,
    const CUDAKernelNumberType                               kernel_factor,
    const unsigned int                                       capacity,
    SauterQuadratureTaskScalarDataNearField *scalar_data_ring_buffer_gpu,
    CUDAKernelNumberType                    *quadrature_value_ring_buffer_gpu,
    const unsigned int                       start_task_index,
    const unsigned int                       fetched_task_num,
    const CUDABEMValues<
      dim,
      spacedim,
      typename numbers::NumberTraits<CUDAKernelNumberType>::real_type>
      bem_values)
  {
    using real_type =
      typename numbers::NumberTraits<CUDAKernelNumberType>::real_type;

    /**
     * @internal For simplicity, we use 1D linear thread grid.
     */
    const unsigned int thread_idx = blockIdx.x * blockDim.x + threadIdx.x;

    real_type                      kx_jacobian, ky_jacobian;
    Tensor<1, spacedim, real_type> kx_normal, ky_normal;
    Point<spacedim, real_type>     kx_quad_point, ky_quad_point;

    /**
     * @internal Get the list of quadrature points in the Sauter
     * parametric space.
     */
    const CUDATable<2, double> &quad_points =
      bem_values.quad_rule_for_same_panel.get_points();

    /**
     * @internal The number of allocated CUDA threads for executing this
     * kernel function is always enough to hold the fetched tasks. Hence,
     * those threads with linear IDs less than @p fetched_task_num actually
     * perform the computation.
     */
    if (thread_idx < fetched_task_num)
      {
        /**
         * @internal Calculate the task index in the ring buffer.
         */
        const unsigned int task_index =
          (thread_idx + start_task_index) >= capacity ?
            (thread_idx + start_task_index - capacity) :
            (thread_idx + start_task_index);

        /**
         * @internal Initialize the quadrature value stored in the register,
         * which is efficient for accumulating values contributed from all
         * \f$k_3\f$ terms and quadrature points.
         */
        CUDAKernelNumberType quad_value = CUDAKernelNumberType();

        /**
         * @internal Iterate over each quadrature point.
         */
        for (unsigned int quad_no = 0;
             quad_no < bem_values.quad_rule_for_same_panel.size();
             quad_no++)
          {
            /**
             * @internal Initialize the register variable for storing the
             * kernel function value at the current quadrature point, which is
             * also multiplied by Jacobians from unit cells to real cells as
             * well as shape function values in \f$K_x\f$ and \f$K_y\f$.
             *
             * \mynote{When the kernel function is @p HyperSingularRegular,
             * the scalar product of surface curls in \f$K_x\f$ and \f$K_y\f$
             * will be multiplied to @p kernel_value instead of the shape
             * function values.}
             */
            CUDAKernelNumberType kernel_value = CUDAKernelNumberType();
            /**
             * @internal Iterate over each k3 term.
             */
#pragma unroll
            for (unsigned int k3_index = 0; k3_index < 8; k3_index++)
              {
                BEMTools::PlatformShared::
                  transform_quad_point_from_unit_to_permuted_real_cell(
                    &bem_values.kx_mapping_shape_value_table_for_same_panel(
                      k3_index,
                      quad_no,
                      scalar_data_ring_buffer_gpu[task_index].kx_mapping_index,
                      0),
                    &bem_values.mapping_support_point_table(
                      scalar_data_ring_buffer_gpu[task_index]
                        .kx_cell_index_global,
                      0),
                    scalar_data_ring_buffer_gpu[task_index]
                      .kx_mapping_n_shape_functions,
                    kx_quad_point);

                BEMTools::PlatformShared::
                  transform_quad_point_from_unit_to_permuted_real_cell(
                    &bem_values.ky_mapping_shape_value_table_for_same_panel(
                      k3_index,
                      quad_no,
                      scalar_data_ring_buffer_gpu[task_index].ky_mapping_index,
                      0),
                    &bem_values.mapping_support_point_table(
                      scalar_data_ring_buffer_gpu[task_index]
                        .ky_cell_index_global,
                      0),
                    scalar_data_ring_buffer_gpu[task_index]
                      .ky_mapping_n_shape_functions,
                    ky_quad_point);

                if (bem_values.is_surface_curl_needed)
                  {
                    assert(kernel.kernel_type ==
                           KernelType::HyperSingularRegular);

                    real_type kx_covariant_matrix_data[spacedim * dim];
                    real_type ky_covariant_matrix_data[spacedim * dim];
                    HierBEM::PlatformShared::FullMatrixWrapper<real_type>
                      kx_covariant_matrix(kx_covariant_matrix_data,
                                          spacedim,
                                          dim);
                    HierBEM::PlatformShared::FullMatrixWrapper<real_type>
                      ky_covariant_matrix(ky_covariant_matrix_data,
                                          spacedim,
                                          dim);

                    kx_jacobian = BEMTools::PlatformShared::
                      surface_jacobian_det_normal_vector_and_covariant(
                        &bem_values
                           .kx_mapping_shape_grad_matrix_table_for_same_panel(
                             scalar_data_ring_buffer_gpu[task_index]
                               .kx_mapping_index,
                             k3_index,
                             quad_no,
                             0),
                        &bem_values.mapping_support_point_table(
                          scalar_data_ring_buffer_gpu[task_index]
                            .kx_cell_index_global,
                          0),
                        scalar_data_ring_buffer_gpu[task_index]
                          .kx_mapping_n_shape_functions,
                        kx_normal,
                        kx_covariant_matrix,
                        scalar_data_ring_buffer_gpu[task_index]
                          .is_kx_normal_inward);

                    ky_jacobian = BEMTools::PlatformShared::
                      surface_jacobian_det_normal_vector_and_covariant(
                        &bem_values
                           .ky_mapping_shape_grad_matrix_table_for_same_panel(
                             scalar_data_ring_buffer_gpu[task_index]
                               .ky_mapping_index,
                             k3_index,
                             quad_no,
                             0),
                        &bem_values.mapping_support_point_table(
                          scalar_data_ring_buffer_gpu[task_index]
                            .ky_cell_index_global,
                          0),
                        scalar_data_ring_buffer_gpu[task_index]
                          .ky_mapping_n_shape_functions,
                        ky_normal,
                        ky_covariant_matrix,
                        scalar_data_ring_buffer_gpu[task_index]
                          .is_ky_normal_inward);

                    Tensor<1, spacedim, real_type> kx_shape_surface_curl;
                    BEMTools::PlatformShared::
                      surface_curl<dim, spacedim, real_type>(
                        scalar_data_ring_buffer_gpu[task_index].i_local_index,
                        &bem_values.kx_shape_grad_matrix_table_for_same_panel(
                          k3_index, quad_no, 0, 0),
                        bem_values.kx_shape_value_table_for_same_panel.size(0),
                        kx_covariant_matrix,
                        kx_normal,
                        kx_shape_surface_curl);

                    Tensor<1, spacedim, real_type> ky_shape_surface_curl;
                    BEMTools::PlatformShared::
                      surface_curl<dim, spacedim, real_type>(
                        scalar_data_ring_buffer_gpu[task_index].j_local_index,
                        &bem_values.ky_shape_grad_matrix_table_for_same_panel(
                          k3_index, quad_no, 0, 0),
                        bem_values.ky_shape_value_table_for_same_panel.size(0),
                        ky_covariant_matrix,
                        ky_normal,
                        ky_shape_surface_curl);

                    kernel_value +=
                      kernel.value(kx_quad_point,
                                   ky_quad_point,
                                   kx_normal,
                                   ky_normal) *
                      kx_jacobian * ky_jacobian *
                      HierBEM::PlatformShared::scalar_product(
                        kx_shape_surface_curl, ky_shape_surface_curl);
                  }
                else
                  {
                    kx_jacobian = BEMTools::PlatformShared::
                      surface_jacobian_det_and_normal_vector(
                        &bem_values
                           .kx_mapping_shape_grad_matrix_table_for_same_panel(
                             scalar_data_ring_buffer_gpu[task_index]
                               .kx_mapping_index,
                             k3_index,
                             quad_no,
                             0),
                        &bem_values.mapping_support_point_table(
                          scalar_data_ring_buffer_gpu[task_index]
                            .kx_cell_index_global,
                          0),
                        scalar_data_ring_buffer_gpu[task_index]
                          .kx_mapping_n_shape_functions,
                        kx_normal,
                        scalar_data_ring_buffer_gpu[task_index]
                          .is_kx_normal_inward);

                    ky_jacobian = BEMTools::PlatformShared::
                      surface_jacobian_det_and_normal_vector(
                        &bem_values
                           .ky_mapping_shape_grad_matrix_table_for_same_panel(
                             scalar_data_ring_buffer_gpu[task_index]
                               .ky_mapping_index,
                             k3_index,
                             quad_no,
                             0),
                        &bem_values.mapping_support_point_table(
                          scalar_data_ring_buffer_gpu[task_index]
                            .ky_cell_index_global,
                          0),
                        scalar_data_ring_buffer_gpu[task_index]
                          .ky_mapping_n_shape_functions,
                        ky_normal,
                        scalar_data_ring_buffer_gpu[task_index]
                          .is_ky_normal_inward);

                    kernel_value +=
                      kernel.value(kx_quad_point,
                                   ky_quad_point,
                                   kx_normal,
                                   ky_normal) *
                      kx_jacobian * ky_jacobian *
                      bem_values.kx_shape_value_table_for_same_panel(
                        scalar_data_ring_buffer_gpu[task_index].i_local_index,
                        k3_index,
                        quad_no) *
                      bem_values.ky_shape_value_table_for_same_panel(
                        scalar_data_ring_buffer_gpu[task_index].j_local_index,
                        k3_index,
                        quad_no);
                  }
              }

            // The Jacobian determinant from the Sauter parameter space to the
            // product unit cell space and the quadrature weight are finally
            // applied here.
            quad_value +=
              kernel_value *
              static_cast<real_type>(
                quad_points(quad_no, 0) * (1.0 - quad_points(quad_no, 0)) *
                (1.0 - quad_points(quad_no, 0) * quad_points(quad_no, 1)) *
                bem_values.quad_rule_for_same_panel.get_weights()[quad_no]);
          }

        /**
         * @internal Save the scaled quadrature value to the ring buffer.
         */
        quadrature_value_ring_buffer_gpu[task_index] =
          quad_value * kernel_factor;
      }
  }


  /**
   * Compute Sauter quadratures of a task batch for the common edge cell
   * neighboring type during near field H-matrix block assembly.
   *
   * Each quadrature task corresponds to a pair of shape functions associated
   * with a pair of global DoF indices.
   */
  template <int dim,
            int spacedim,
            template <int, typename>
            typename KernelFunctionType,
            typename CUDAKernelNumberType = double>
  __global__ void
  process_near_field_sauter_task_batch_common_edge(
    const KernelFunctionType<spacedim, CUDAKernelNumberType> kernel,
    const CUDAKernelNumberType                               kernel_factor,
    const unsigned int                                       capacity,
    CUDATable<
      2,
      Point<spacedim,
            typename numbers::NumberTraits<CUDAKernelNumberType>::real_type>>
      kx_mapping_support_points_permuted_ring_buffer,
    CUDATable<
      2,
      Point<spacedim,
            typename numbers::NumberTraits<CUDAKernelNumberType>::real_type>>
      ky_mapping_support_points_permuted_ring_buffer,
    SauterQuadratureTaskScalarDataNearField *scalar_data_ring_buffer_gpu,
    CUDAKernelNumberType                    *quadrature_value_ring_buffer_gpu,
    const unsigned int                       start_task_index,
    const unsigned int                       fetched_task_num,
    const CUDABEMValues<
      dim,
      spacedim,
      typename numbers::NumberTraits<CUDAKernelNumberType>::real_type>
      bem_values)
  {
    using real_type =
      typename numbers::NumberTraits<CUDAKernelNumberType>::real_type;

    /**
     * @internal For simplicity, we use 1D linear thread grid.
     */
    const unsigned int thread_idx = blockIdx.x * blockDim.x + threadIdx.x;

    real_type                      kx_jacobian, ky_jacobian;
    Tensor<1, spacedim, real_type> kx_normal, ky_normal;
    Point<spacedim, real_type>     kx_quad_point, ky_quad_point;

    /**
     * @internal Get the list of quadrature points in the Sauter
     * parametric space.
     */
    const CUDATable<2, double> &quad_points =
      bem_values.quad_rule_for_common_edge.get_points();

    /**
     * @internal The number of allocated CUDA threads for executing this
     * kernel function is always enough to hold the fetched tasks. Hence,
     * those threads with linear IDs less than @p fetched_task_num actually
     * perform the computation.
     */
    if (thread_idx < fetched_task_num)
      {
        /**
         * @internal Calculate the task index in the ring buffer.
         */
        const unsigned int task_index =
          (thread_idx + start_task_index) >= capacity ?
            (thread_idx + start_task_index - capacity) :
            (thread_idx + start_task_index);

        /**
         * @internal Initialize the quadrature value stored in the register,
         * which is efficient for accumulating values contributed from all
         * \f$k_3\f$ terms and quadrature points.
         */
        CUDAKernelNumberType quad_value = CUDAKernelNumberType();

        /**
         * @internal Iterate over each quadrature point.
         */
        for (unsigned int quad_no = 0;
             quad_no < bem_values.quad_rule_for_common_edge.size();
             quad_no++)
          {
            // Compute the Jacobian determinant from the Sauter parametric space
            // to the product unit cell space. N.B. There are two different
            // Jacobian determinants. The first one is applied to the first two
            // k3 terms and the other is applied to the remaining four k3 terms.
            real_type jacobian_det1 = static_cast<real_type>(
              quad_points(quad_no, 0) * quad_points(quad_no, 0) *
              (1 - quad_points(quad_no, 0)));
            real_type jacobian_det2 = static_cast<real_type>(
              quad_points(quad_no, 0) * quad_points(quad_no, 0) *
              (1 - quad_points(quad_no, 0) * quad_points(quad_no, 1)));

            /**
             * @internal Initialize the register variable for storing the
             * kernel function value at the current quadrature point, which is
             * also multiplied by Jacobians from unit cells to real cells as
             * well as shape function values in \f$K_x\f$ and \f$K_y\f$.
             *
             * \mynote{When the kernel function is @p HyperSingularRegular,
             * the scalar product of surface curls in \f$K_x\f$ and \f$K_y\f$
             * will be multiplied to @p kernel_value instead of the shape
             * function values.}
             */
            CUDAKernelNumberType kernel_value = CUDAKernelNumberType();
            /**
             * @internal Iterate over each k3 term.
             */
#pragma unroll
            for (unsigned int k3_index = 0; k3_index < 6; k3_index++)
              {
                BEMTools::PlatformShared::
                  transform_quad_point_from_unit_to_permuted_real_cell(
                    &bem_values.kx_mapping_shape_value_table_for_common_edge(
                      k3_index,
                      quad_no,
                      scalar_data_ring_buffer_gpu[task_index].kx_mapping_index,
                      0),
                    &kx_mapping_support_points_permuted_ring_buffer(task_index,
                                                                    0),
                    scalar_data_ring_buffer_gpu[task_index]
                      .kx_mapping_n_shape_functions,
                    kx_quad_point);

                BEMTools::PlatformShared::
                  transform_quad_point_from_unit_to_permuted_real_cell(
                    &bem_values.ky_mapping_shape_value_table_for_common_edge(
                      k3_index,
                      quad_no,
                      scalar_data_ring_buffer_gpu[task_index].ky_mapping_index,
                      0),
                    &ky_mapping_support_points_permuted_ring_buffer(task_index,
                                                                    0),
                    scalar_data_ring_buffer_gpu[task_index]
                      .ky_mapping_n_shape_functions,
                    ky_quad_point);

                if (bem_values.is_surface_curl_needed)
                  {
                    assert(kernel.kernel_type ==
                           KernelType::HyperSingularRegular);

                    real_type kx_covariant_matrix_data[spacedim * dim];
                    real_type ky_covariant_matrix_data[spacedim * dim];
                    HierBEM::PlatformShared::FullMatrixWrapper<real_type>
                      kx_covariant_matrix(kx_covariant_matrix_data,
                                          spacedim,
                                          dim);
                    HierBEM::PlatformShared::FullMatrixWrapper<real_type>
                      ky_covariant_matrix(ky_covariant_matrix_data,
                                          spacedim,
                                          dim);

                    kx_jacobian = BEMTools::PlatformShared::
                      surface_jacobian_det_normal_vector_and_covariant(
                        &bem_values
                           .kx_mapping_shape_grad_matrix_table_for_common_edge(
                             scalar_data_ring_buffer_gpu[task_index]
                               .kx_mapping_index,
                             k3_index,
                             quad_no,
                             0),
                        &kx_mapping_support_points_permuted_ring_buffer(
                          task_index, 0),
                        scalar_data_ring_buffer_gpu[task_index]
                          .kx_mapping_n_shape_functions,
                        kx_normal,
                        kx_covariant_matrix,
                        scalar_data_ring_buffer_gpu[task_index]
                          .is_kx_normal_inward);

                    ky_jacobian = BEMTools::PlatformShared::
                      surface_jacobian_det_normal_vector_and_covariant(
                        &bem_values
                           .ky_mapping_shape_grad_matrix_table_for_common_edge(
                             scalar_data_ring_buffer_gpu[task_index]
                               .ky_mapping_index,
                             k3_index,
                             quad_no,
                             0),
                        &ky_mapping_support_points_permuted_ring_buffer(
                          task_index, 0),
                        scalar_data_ring_buffer_gpu[task_index]
                          .ky_mapping_n_shape_functions,
                        ky_normal,
                        ky_covariant_matrix,
                        !scalar_data_ring_buffer_gpu[task_index]
                           .is_ky_normal_inward);

                    Tensor<1, spacedim, real_type> kx_shape_surface_curl;
                    BEMTools::PlatformShared::
                      surface_curl<dim, spacedim, real_type>(
                        scalar_data_ring_buffer_gpu[task_index].i_local_index,
                        &bem_values.kx_shape_grad_matrix_table_for_common_edge(
                          k3_index, quad_no, 0, 0),
                        bem_values.kx_shape_value_table_for_common_edge.size(0),
                        kx_covariant_matrix,
                        kx_normal,
                        kx_shape_surface_curl);

                    Tensor<1, spacedim, real_type> ky_shape_surface_curl;
                    BEMTools::PlatformShared::
                      surface_curl<dim, spacedim, real_type>(
                        scalar_data_ring_buffer_gpu[task_index].j_local_index,
                        &bem_values.ky_shape_grad_matrix_table_for_common_edge(
                          k3_index, quad_no, 0, 0),
                        bem_values.ky_shape_value_table_for_common_edge.size(0),
                        ky_covariant_matrix,
                        ky_normal,
                        ky_shape_surface_curl);

                    // Apply the Jacobian determinant from the Sauter parametric
                    // space to the product unit cell space, which depends on
                    // the k3 index.
                    kernel_value +=
                      kernel.value(kx_quad_point,
                                   ky_quad_point,
                                   kx_normal,
                                   ky_normal) *
                      kx_jacobian * ky_jacobian *
                      HierBEM::PlatformShared::scalar_product(
                        kx_shape_surface_curl, ky_shape_surface_curl) *
                      (k3_index <= 1 ? jacobian_det1 : jacobian_det2);
                  }
                else
                  {
                    kx_jacobian = BEMTools::PlatformShared::
                      surface_jacobian_det_and_normal_vector(
                        &bem_values
                           .kx_mapping_shape_grad_matrix_table_for_common_edge(
                             scalar_data_ring_buffer_gpu[task_index]
                               .kx_mapping_index,
                             k3_index,
                             quad_no,
                             0),
                        &kx_mapping_support_points_permuted_ring_buffer(
                          task_index, 0),
                        scalar_data_ring_buffer_gpu[task_index]
                          .kx_mapping_n_shape_functions,
                        kx_normal,
                        scalar_data_ring_buffer_gpu[task_index]
                          .is_kx_normal_inward);

                    ky_jacobian = BEMTools::PlatformShared::
                      surface_jacobian_det_and_normal_vector(
                        &bem_values
                           .ky_mapping_shape_grad_matrix_table_for_common_edge(
                             scalar_data_ring_buffer_gpu[task_index]
                               .ky_mapping_index,
                             k3_index,
                             quad_no,
                             0),
                        &ky_mapping_support_points_permuted_ring_buffer(
                          task_index, 0),
                        scalar_data_ring_buffer_gpu[task_index]
                          .ky_mapping_n_shape_functions,
                        ky_normal,
                        !scalar_data_ring_buffer_gpu[task_index]
                           .is_ky_normal_inward);

                    // Apply the Jacobian determinant from the Sauter parametric
                    // space to the product unit cell space, which depends on
                    // the k3 index.
                    kernel_value +=
                      kernel.value(kx_quad_point,
                                   ky_quad_point,
                                   kx_normal,
                                   ky_normal) *
                      kx_jacobian * ky_jacobian *
                      bem_values.kx_shape_value_table_for_common_edge(
                        scalar_data_ring_buffer_gpu[task_index].i_local_index,
                        k3_index,
                        quad_no) *
                      bem_values.ky_shape_value_table_for_common_edge(
                        scalar_data_ring_buffer_gpu[task_index].j_local_index,
                        k3_index,
                        quad_no) *
                      (k3_index <= 1 ? jacobian_det1 : jacobian_det2);
                  }
              }

            // Apply the quadrature weight.
            quad_value +=
              kernel_value *
              static_cast<real_type>(
                bem_values.quad_rule_for_common_edge.get_weights()[quad_no]);
          }

        /**
         * @internal Save the scaled quadrature value to the ring buffer.
         */
        quadrature_value_ring_buffer_gpu[task_index] =
          quad_value * kernel_factor;
      }
  }


  /**
   * Compute Sauter quadratures of a task batch for the common vertex cell
   * neighboring type during near field H-matrix block assembly.
   *
   * Each quadrature task corresponds to a pair of shape functions associated
   * with a pair of global DoF indices.
   */
  template <int dim,
            int spacedim,
            template <int, typename>
            typename KernelFunctionType,
            typename CUDAKernelNumberType = double>
  __global__ void
  process_near_field_sauter_task_batch_common_vertex(
    const KernelFunctionType<spacedim, CUDAKernelNumberType> kernel,
    const CUDAKernelNumberType                               kernel_factor,
    const unsigned int                                       capacity,
    CUDATable<
      2,
      Point<spacedim,
            typename numbers::NumberTraits<CUDAKernelNumberType>::real_type>>
      kx_mapping_support_points_permuted_ring_buffer,
    CUDATable<
      2,
      Point<spacedim,
            typename numbers::NumberTraits<CUDAKernelNumberType>::real_type>>
      ky_mapping_support_points_permuted_ring_buffer,
    SauterQuadratureTaskScalarDataNearField *scalar_data_ring_buffer_gpu,
    CUDAKernelNumberType                    *quadrature_value_ring_buffer_gpu,
    const unsigned int                       start_task_index,
    const unsigned int                       fetched_task_num,
    const CUDABEMValues<
      dim,
      spacedim,
      typename numbers::NumberTraits<CUDAKernelNumberType>::real_type>
      bem_values)
  {
    using real_type =
      typename numbers::NumberTraits<CUDAKernelNumberType>::real_type;

    /**
     * @internal For simplicity, we use 1D linear thread grid.
     */
    const unsigned int thread_idx = blockIdx.x * blockDim.x + threadIdx.x;

    real_type                      kx_jacobian, ky_jacobian;
    Tensor<1, spacedim, real_type> kx_normal, ky_normal;
    Point<spacedim, real_type>     kx_quad_point, ky_quad_point;

    /**
     * @internal Get the list of quadrature points in the Sauter
     * parametric space.
     */
    const CUDATable<2, double> &quad_points =
      bem_values.quad_rule_for_common_vertex.get_points();

    /**
     * @internal The number of allocated CUDA threads for executing this
     * kernel function is always enough to hold the fetched tasks. Hence,
     * those threads with linear IDs less than @p fetched_task_num actually
     * perform the computation.
     */
    if (thread_idx < fetched_task_num)
      {
        /**
         * @internal Calculate the task index in the ring buffer.
         */
        const unsigned int task_index =
          (thread_idx + start_task_index) >= capacity ?
            (thread_idx + start_task_index - capacity) :
            (thread_idx + start_task_index);

        /**
         * @internal Initialize the quadrature value stored in the register,
         * which is efficient for accumulating values contributed from all
         * \f$k_3\f$ terms and quadrature points.
         */
        CUDAKernelNumberType quad_value = CUDAKernelNumberType();

        /**
         * @internal Iterate over each quadrature point.
         */
        for (unsigned int quad_no = 0;
             quad_no < bem_values.quad_rule_for_common_vertex.size();
             quad_no++)
          {
            /**
             * @internal Initialize the register variable for storing the
             * kernel function value at the current quadrature point, which is
             * also multiplied by Jacobians from unit cells to real cells as
             * well as shape function values in \f$K_x\f$ and \f$K_y\f$.
             *
             * \mynote{When the kernel function is @p HyperSingularRegular,
             * the scalar product of surface curls in \f$K_x\f$ and \f$K_y\f$
             * will be multiplied to @p kernel_value instead of the shape
             * function values.}
             */
            CUDAKernelNumberType kernel_value = CUDAKernelNumberType();
            /**
             * @internal Iterate over each k3 term.
             */
#pragma unroll
            for (unsigned int k3_index = 0; k3_index < 4; k3_index++)
              {
                BEMTools::PlatformShared::
                  transform_quad_point_from_unit_to_permuted_real_cell(
                    &bem_values.kx_mapping_shape_value_table_for_common_vertex(
                      k3_index,
                      quad_no,
                      scalar_data_ring_buffer_gpu[task_index].kx_mapping_index,
                      0),
                    &kx_mapping_support_points_permuted_ring_buffer(task_index,
                                                                    0),
                    scalar_data_ring_buffer_gpu[task_index]
                      .kx_mapping_n_shape_functions,
                    kx_quad_point);

                BEMTools::PlatformShared::
                  transform_quad_point_from_unit_to_permuted_real_cell(
                    &bem_values.ky_mapping_shape_value_table_for_common_vertex(
                      k3_index,
                      quad_no,
                      scalar_data_ring_buffer_gpu[task_index].ky_mapping_index,
                      0),
                    &ky_mapping_support_points_permuted_ring_buffer(task_index,
                                                                    0),
                    scalar_data_ring_buffer_gpu[task_index]
                      .ky_mapping_n_shape_functions,
                    ky_quad_point);

                if (bem_values.is_surface_curl_needed)
                  {
                    assert(kernel.kernel_type ==
                           KernelType::HyperSingularRegular);

                    real_type kx_covariant_matrix_data[spacedim * dim];
                    real_type ky_covariant_matrix_data[spacedim * dim];
                    HierBEM::PlatformShared::FullMatrixWrapper<real_type>
                      kx_covariant_matrix(kx_covariant_matrix_data,
                                          spacedim,
                                          dim);
                    HierBEM::PlatformShared::FullMatrixWrapper<real_type>
                      ky_covariant_matrix(ky_covariant_matrix_data,
                                          spacedim,
                                          dim);

                    kx_jacobian = BEMTools::PlatformShared::
                      surface_jacobian_det_normal_vector_and_covariant(
                        &bem_values
                           .kx_mapping_shape_grad_matrix_table_for_common_vertex(
                             scalar_data_ring_buffer_gpu[task_index]
                               .kx_mapping_index,
                             k3_index,
                             quad_no,
                             0),
                        &kx_mapping_support_points_permuted_ring_buffer(
                          task_index, 0),
                        scalar_data_ring_buffer_gpu[task_index]
                          .kx_mapping_n_shape_functions,
                        kx_normal,
                        kx_covariant_matrix,
                        scalar_data_ring_buffer_gpu[task_index]
                          .is_kx_normal_inward);

                    ky_jacobian = BEMTools::PlatformShared::
                      surface_jacobian_det_normal_vector_and_covariant(
                        &bem_values
                           .ky_mapping_shape_grad_matrix_table_for_common_vertex(
                             scalar_data_ring_buffer_gpu[task_index]
                               .ky_mapping_index,
                             k3_index,
                             quad_no,
                             0),
                        &ky_mapping_support_points_permuted_ring_buffer(
                          task_index, 0),
                        scalar_data_ring_buffer_gpu[task_index]
                          .ky_mapping_n_shape_functions,
                        ky_normal,
                        ky_covariant_matrix,
                        scalar_data_ring_buffer_gpu[task_index]
                          .is_ky_normal_inward);

                    Tensor<1, spacedim, real_type> kx_shape_surface_curl;
                    BEMTools::PlatformShared::surface_curl<dim,
                                                           spacedim,
                                                           real_type>(
                      scalar_data_ring_buffer_gpu[task_index].i_local_index,
                      &bem_values.kx_shape_grad_matrix_table_for_common_vertex(
                        k3_index, quad_no, 0, 0),
                      bem_values.kx_shape_value_table_for_common_vertex.size(0),
                      kx_covariant_matrix,
                      kx_normal,
                      kx_shape_surface_curl);

                    Tensor<1, spacedim, real_type> ky_shape_surface_curl;
                    BEMTools::PlatformShared::surface_curl<dim,
                                                           spacedim,
                                                           real_type>(
                      scalar_data_ring_buffer_gpu[task_index].j_local_index,
                      &bem_values.ky_shape_grad_matrix_table_for_common_vertex(
                        k3_index, quad_no, 0, 0),
                      bem_values.ky_shape_value_table_for_common_vertex.size(0),
                      ky_covariant_matrix,
                      ky_normal,
                      ky_shape_surface_curl);

                    kernel_value +=
                      kernel.value(kx_quad_point,
                                   ky_quad_point,
                                   kx_normal,
                                   ky_normal) *
                      kx_jacobian * ky_jacobian *
                      HierBEM::PlatformShared::scalar_product(
                        kx_shape_surface_curl, ky_shape_surface_curl);
                  }
                else
                  {
                    kx_jacobian = BEMTools::PlatformShared::
                      surface_jacobian_det_and_normal_vector(
                        &bem_values
                           .kx_mapping_shape_grad_matrix_table_for_common_vertex(
                             scalar_data_ring_buffer_gpu[task_index]
                               .kx_mapping_index,
                             k3_index,
                             quad_no,
                             0),
                        &kx_mapping_support_points_permuted_ring_buffer(
                          task_index, 0),
                        scalar_data_ring_buffer_gpu[task_index]
                          .kx_mapping_n_shape_functions,
                        kx_normal,
                        scalar_data_ring_buffer_gpu[task_index]
                          .is_kx_normal_inward);

                    ky_jacobian = BEMTools::PlatformShared::
                      surface_jacobian_det_and_normal_vector(
                        &bem_values
                           .ky_mapping_shape_grad_matrix_table_for_common_vertex(
                             scalar_data_ring_buffer_gpu[task_index]
                               .ky_mapping_index,
                             k3_index,
                             quad_no,
                             0),
                        &ky_mapping_support_points_permuted_ring_buffer(
                          task_index, 0),
                        scalar_data_ring_buffer_gpu[task_index]
                          .ky_mapping_n_shape_functions,
                        ky_normal,
                        scalar_data_ring_buffer_gpu[task_index]
                          .is_ky_normal_inward);

                    kernel_value +=
                      kernel.value(kx_quad_point,
                                   ky_quad_point,
                                   kx_normal,
                                   ky_normal) *
                      kx_jacobian * ky_jacobian *
                      bem_values.kx_shape_value_table_for_common_vertex(
                        scalar_data_ring_buffer_gpu[task_index].i_local_index,
                        k3_index,
                        quad_no) *
                      bem_values.ky_shape_value_table_for_common_vertex(
                        scalar_data_ring_buffer_gpu[task_index].j_local_index,
                        k3_index,
                        quad_no);
                  }
              }

            // The Jacobian determinant from the Sauter parameter space to the
            // product unit cell space and the quadrature weight are finally
            // applied here.
            quad_value +=
              kernel_value *
              static_cast<real_type>(
                HierBEM::PlatformShared::Utilities::fixed_power<3>(
                  quad_points(quad_no, 0)) *
                bem_values.quad_rule_for_common_vertex.get_weights()[quad_no]);
          }

        /**
         * @internal Save the scaled quadrature value to the ring buffer.
         */
        quadrature_value_ring_buffer_gpu[task_index] =
          quad_value * kernel_factor;
      }
  }


  /**
   * Compute Sauter quadratures of a task batch for the regular cell neighboring
   * type during near field H-matrix block assembly.
   *
   * Each quadrature task corresponds to a pair of shape functions associated
   * with a pair of global DoF indices.
   */
  template <int dim,
            int spacedim,
            template <int, typename>
            typename KernelFunctionType,
            typename CUDAKernelNumberType = double>
  __global__ void
  process_near_field_sauter_task_batch_regular(
    const KernelFunctionType<spacedim, CUDAKernelNumberType> kernel,
    const CUDAKernelNumberType                               kernel_factor,
    const unsigned int                                       capacity,
    SauterQuadratureTaskScalarDataNearField *scalar_data_ring_buffer_gpu,
    CUDAKernelNumberType                    *quadrature_value_ring_buffer_gpu,
    const unsigned int                       start_task_index,
    const unsigned int                       fetched_task_num,
    const CUDABEMValues<
      dim,
      spacedim,
      typename numbers::NumberTraits<CUDAKernelNumberType>::real_type>
      bem_values)
  {
    using real_type =
      typename numbers::NumberTraits<CUDAKernelNumberType>::real_type;

    /**
     * @internal For simplicity, we use 1D linear thread grid.
     */
    const unsigned int thread_idx = blockIdx.x * blockDim.x + threadIdx.x;

    /**
     * @internal The number of allocated CUDA threads for executing this
     * kernel function is always enough to hold the fetched tasks. Hence,
     * those threads with linear IDs less than @p fetched_task_num actually
     * perform the computation.
     */
    if (thread_idx < fetched_task_num)
      {
        /**
         * @internal Calculate the task index in the ring buffer.
         */
        const unsigned int task_index =
          (thread_idx + start_task_index) >= capacity ?
            (thread_idx + start_task_index - capacity) :
            (thread_idx + start_task_index);

        /**
         * @internal Initialize the quadrature value stored in the register,
         * which is efficient for accumulating values contributed from all
         * \f$k_3\f$ terms and quadrature points.
         */
        CUDAKernelNumberType     quad_value = CUDAKernelNumberType();
        types::global_cell_index kx_cell_index_local =
          scalar_data_ring_buffer_gpu[task_index].kx_cell_index_local;
        types::global_cell_index ky_cell_index_local =
          scalar_data_ring_buffer_gpu[task_index].ky_cell_index_local;

        // Number of quadrature point in the 2D quadrature object.
        const unsigned int n_quad_points =
          bem_values.quad_rule_for_regular.size();
        // Iterate over each quadrature point in the tensor product of two 2D
        // quadrature objects.
        for (unsigned int kx_quad_no = 0; kx_quad_no < n_quad_points;
             kx_quad_no++)
          {
            for (unsigned int ky_quad_no = 0; ky_quad_no < n_quad_points;
                 ky_quad_no++)
              {
                if (kernel.kernel_type == HyperSingularRegular)
                  {
                    quad_value +=
                      kernel.value(
                        bem_values.quad_points_for_regular(kx_cell_index_local,
                                                           kx_quad_no),
                        bem_values.quad_points_for_regular(ky_cell_index_local,
                                                           ky_quad_no),
                        bem_values.normals_at_quad_points_for_regular(
                          kx_cell_index_local, kx_quad_no),
                        bem_values.normals_at_quad_points_for_regular(
                          ky_cell_index_local, ky_quad_no)) *
                      bem_values.JxW_at_quad_points_for_regular(
                        kx_cell_index_local, kx_quad_no) *
                      bem_values.JxW_at_quad_points_for_regular(
                        ky_cell_index_local, ky_quad_no) *
                      HierBEM::PlatformShared::scalar_product(
                        bem_values.kx_shape_curls_at_quad_points_for_regular(
                          kx_cell_index_local,
                          scalar_data_ring_buffer_gpu[task_index].i_local_index,
                          kx_quad_no),
                        bem_values.ky_shape_curls_at_quad_points_for_regular(
                          ky_cell_index_local,
                          scalar_data_ring_buffer_gpu[task_index].j_local_index,
                          ky_quad_no));
                  }
                else
                  {
                    quad_value +=
                      kernel.value(
                        bem_values.quad_points_for_regular(kx_cell_index_local,
                                                           kx_quad_no),
                        bem_values.quad_points_for_regular(ky_cell_index_local,
                                                           ky_quad_no),
                        bem_values.normals_at_quad_points_for_regular(
                          kx_cell_index_local, kx_quad_no),
                        bem_values.normals_at_quad_points_for_regular(
                          ky_cell_index_local, ky_quad_no)) *
                      bem_values.JxW_at_quad_points_for_regular(
                        kx_cell_index_local, kx_quad_no) *
                      bem_values.JxW_at_quad_points_for_regular(
                        ky_cell_index_local, ky_quad_no) *
                      bem_values.kx_shape_value_table_for_regular(
                        scalar_data_ring_buffer_gpu[task_index].i_local_index,
                        kx_quad_no) *
                      bem_values.ky_shape_value_table_for_regular(
                        scalar_data_ring_buffer_gpu[task_index].j_local_index,
                        ky_quad_no);
                  }
              }
          }

        // Save the scaled quadrature value to the ring buffer. N.B. With the
        // regular cell neighboring type, there is no coordinate transformation
        // from the Sauter parameter space to the product unit cell space
        // anymore; hence there is no such Jacobian determinant. Meanwhile,
        // quadrature weights have been multiplied into Jacobian values,
        // therefore they do not appear here.
        quadrature_value_ring_buffer_gpu[task_index] =
          quad_value * kernel_factor;
      }
  }
} // namespace CUDAWrappers

HBEM_NS_CLOSE

#endif // HIERBEM_INCLUDE_QUADRATURE_SAUTER_QUADRATURE_NEAR_FIELD_KERNELS_H_
