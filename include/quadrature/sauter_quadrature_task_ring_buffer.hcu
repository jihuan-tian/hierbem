 */
#ifndef HIERBEM_INCLUDE_QUADRATURE_SAUTER_QUADRATURE_TASK_RING_BUFFER_H_
#define HIERBEM_INCLUDE_QUADRATURE_SAUTER_QUADRATURE_TASK_RING_BUFFER_H_

#include <deal.II/base/exceptions.h>
#include <deal.II/base/logstream.h>
#include <deal.II/base/numbers.h>
#include <deal.II/base/point.h>
#include <deal.II/base/table.h>
#include <deal.II/base/table_indices.h>
#if ENABLE_HMAT_ASSEMBLY_PROFILE == 1
#  include <deal.II/base/timer.h>
#endif

#include <cuda_runtime.h>

#include <atomic>
#include <condition_variable>
#include <memory>
#include <mutex>
#include <string>
#include <type_traits>
#include <vector>

#include "bem/cell_neighboring_type.h"
#include "bem/cu_bem_values.hcu"
#include "config.h"
#include "hmatrix/hmatrix_assembly_profile.h"
#include "linear_algebra/cu_table.hcu"
#include "linear_algebra/lapack_full_matrix_ext.h"
#include "sauter_quadrature_near_field_kernels.hcu"
#include "sauter_quadrature_task_producer_buffer.h"
#include "sauter_quadrature_task_scalar_data_near_field.h"
#include "utilities/cu_profile.hcu"
#include "utilities/number_traits.h"

HBEM_NS_OPEN

using namespace dealii;

namespace CUDAWrappers
{
  enum SauterQuadratureTaskStatus
  {
    before_creation,
    during_creation,
    created,
    during_processing
  };

  /**
   * Ring buffer for holding Sauter quadrature tasks, which is used in the
   * producer-consumer model for building near field \hmatrices.
   *
   * @tparam dim
   * @tparam spacedim
   * @tparam RangeNumberType
   * @tparam KernelNumberType
   */
  template <int dim,
            int spacedim,
            typename RangeNumberType,
            typename KernelNumberType>
  class SauterQuadratureTaskRingBuffer
  {
  public:
    using real_type =
      typename numbers::NumberTraits<RangeNumberType>::real_type;
    using CUDAKernelNumberType = DeviceNumberType<KernelNumberType>;

    /**
     * Allocate memory for the ring buffer on the host and device.
     *
     * @param cell_neighboring_type Cell neighboring type to be handled in
     * this queue
     * @param batch_size_ The number of quadrature tasks, which are treated
     * as a batch for being processed by a consumer thread.
     * @param batch_num Number of batches in the ring buffer.
     * @param max_mapping_n_shape_functions Number of shape functions in the
     * mapping object with the highest order.
     */
    HBEM_ATTR_HOST void
    allocate(const CellNeighboringType neighboring_type,
             const unsigned int        batch_size_,
             const unsigned int        batch_num,
             const unsigned int        max_mapping_n_shape_functions);

    /**
     * Release the memory on the host and device.
     */
    HBEM_ATTR_HOST void
    release();

    HBEM_ATTR_HOST unsigned int
    task_num_during_creation() const;

    HBEM_ATTR_HOST unsigned int
    task_num_ready_for_processing() const;

    HBEM_ATTR_HOST unsigned int
    task_num_during_processing() const;

    HBEM_ATTR_HOST unsigned int
    task_num_total() const;

    HBEM_ATTR_HOST unsigned int
    empty_slot_num() const;

    HBEM_ATTR_HOST bool
    is_full() const;

    HBEM_ATTR_HOST bool
    is_not_full() const;

    HBEM_ATTR_HOST bool
    is_empty() const;

    /**
     * Add a Sauter quadrature task to the ring buffer with mapping support
     * points, which is called by a producer thread.
     *
     * @param fullmat Full matrix within a near field \hmatrix node
     * @param fullmat_row_index Row index of the entry in the full matrix
     * @param fullmat_col_index Column index of the entry in the full matrix
     * @param scalar_data A collection of scalar values to be transferred to the
     * device.
     * @param mass_matrix_entry Value of the mass matrix entry, if there is
     * any.
     * @param kx_mapping_support_points_permuted_ptr
     * @param ky_mapping_support_points_permuted_ptr
     * @param hmat_profile
     */
    HBEM_ATTR_HOST void
    add_task(
      LAPACKFullMatrixExt<RangeNumberType>          *fullmat,
      const unsigned int                             fullmat_row_index,
      const unsigned int                             fullmat_col_index,
      const SauterQuadratureTaskScalarDataNearField &scalar_data,
      const real_type                                mass_matrix_entry,
      const Point<spacedim, real_type> *kx_mapping_support_points_permuted_ptr =
        nullptr,
      const Point<spacedim, real_type> *ky_mapping_support_points_permuted_ptr =
        nullptr,
      HMatrixAssemblyProfile *hmat_profile = nullptr);

    /**
     * Copy a batch of Sauter quadrature tasks from the producer's task buffer
     * to this ring buffer.
     */
    HBEM_ATTR_HOST void
    add_tasks_from_producer_buffer(
      SauterQuadratureTaskProducerBuffer<dim, spacedim, RangeNumberType>
                &producer_buffer,
      const bool has_mass_matrix_entries);

    /**
     * Fetch and process quadrature tasks from the ring buffer in batch.
     */
    template <template <int, typename> typename KernelFunctionType>
    HBEM_ATTR_HOST bool
    fetch_and_process_task_batch(
      const KernelFunctionType<spacedim, CUDAKernelNumberType> &kernel,
      const CUDAKernelNumberType                                kernel_factor,
      const unsigned int                                        block_size,
      const CUDABEMValues<dim, spacedim, real_type>            &bem_values,
      const cudaStream_t      cuda_stream_handle,
      HMatrixAssemblyProfile *hmat_profile = nullptr);

    /**
     * Print the current values of all ring buffer pointers. For debugging
     * purpose only.
     *
     * @param log_stream
     */
    HBEM_ATTR_HOST void
    print_pointers(LogStream &log_stream) const;

    /**
     * @brief Capacity of the ring buffer, which is <tt>batch_size * batch_num +
     * 1</tt>.
     */
    unsigned int capacity;

    /**
     * The cell neighboring type for the quadrature tasks in the current ring
     * buffer.
     *
     * \mynote{Within a ring buffer, all quadrature tasks have a same cell
     * neighboring type, so that the CUDA threads can run in lockstep without
     * branching.}
     */
    CellNeighboringType cell_neighboring_type;

    /**
     * Mutex for protecting multi-threaded accesses to the ring buffer
     * properties, but not the actual task data.
     */
    std::mutex buffer_lock;

    /**
     * Condition variable indicating the ring buffer not being full, i.e. a
     * new task is allowed to be added from a producer thread.
     */
    std::condition_variable buffer_not_full;

    /**
     * Condition variable indicating the ring buffer not being empty and
     * having enough number of tasks to be fetched and processed as a batch by
     * a consumer thread. Then a consumer thread can start to wait for
     * processing a batch of contiguous tasks (starting from the task pointed by
     * @p head_pending) having been created.
     */
    std::condition_variable batch_task_ready;

    /**
     * Array of atomic variables storing the task status in the ring buffer.
     * Because
     * @p std::atomic is not moveable, it cannot be saved in <tt>std::vector</tt>.
     */
    std::unique_ptr<std::atomic<SauterQuadratureTaskStatus>[]>
      task_status_ring_buffer;

    /**
     * List of permuted mapping support points in \f$K_x\f$, which are stored
     * on the host.
     *
     * 1. First dimension: task index in the ring buffer.
     * 2. Second dimension: coordinates of the permuted mapping support points
     * in \f$K_x\f$.
     *
     * The size of the second dimension of this table is allocated with respect
     * to the highest order mapping adopted.
     */
    Table<2, Point<spacedim, real_type>>
      kx_mapping_support_points_permuted_ring_buffer_cpu;

    /**
     * List of permuted mapping support points in \f$K_y\f$, which are stored
     * on the host.
     *
     * 1. First dimension: task index in the ring buffer.
     * 2. Second dimension: coordinate of the permuted mapping support points
     * in \f$K_y\f$.
     *
     * The size of the second dimension of this table is allocated with respect
     * to the highest order mapping adopted.
     */
    Table<2, Point<spacedim, real_type>>
      ky_mapping_support_points_permuted_ring_buffer_cpu;

    /**
     * List of permuted mapping support points in \f$K_x\f$, which are stored
     * on the device.
     *
     * 1. First dimension: task index in the ring buffer.
     * 2. Second dimension: coordinates of the permuted mapping support points
     * in \f$K_x\f$.
     *
     * The size of the second dimension of this table is allocated with respect
     * to the highest order mapping adopted.
     */
    CUDATable<2, Point<spacedim, real_type>>
      kx_mapping_support_points_permuted_ring_buffer_gpu;

    /**
     * List of permuted mapping support points in \f$K_y\f$, which are stored
     * on the device.
     *
     * 1. First dimension: task index in the ring buffer.
     * 2. Second dimension: coordinates of the permuted mapping support points
     * in \f$K_y\f$.
     *
     * The size of the second dimension of this table is allocated with respect
     * to the highest order mapping adopted.
     */
    CUDATable<2, Point<spacedim, real_type>>
      ky_mapping_support_points_permuted_ring_buffer_gpu;

    /**
     * Array of pointers to the full matrices held within the near field
     * \hmatrix leaf nodes.
     *
     * \mynote{This array is located on the host, since it is only related to
     * quadrature result assembly.}
     */
    std::vector<LAPACKFullMatrixExt<RangeNumberType> *> fullmat_ring_buffer_cpu;

    /**
     * Array of row indices for the entries in the corresponding full matrix.
     *
     * \mynote{This array is located on the host, since it is only related to
     * quadrature result assembly.}
     */
    std::vector<unsigned int> fullmat_row_index_ring_buffer_cpu;

    /**
     * Array of column indices for the entries in the corresponding full
     * matrix.
     *
     * \mynote{This array is located on the host, since it is only related to
     * quadrature result assembly.}
     */
    std::vector<unsigned int> fullmat_col_index_ring_buffer_cpu;

    /**
     * Array of scalar data collections on the host.
     */
    SauterQuadratureTaskScalarDataNearField *scalar_data_ring_buffer_cpu;

    /**
     * Array of scalar data collections on the device.
     */
    SauterQuadratureTaskScalarDataNearField *scalar_data_ring_buffer_gpu;

    /**
     * Mass matrix entries
     */
    std::vector<real_type> mass_matrix_entries_ring_buffer_cpu;

    /**
     * Array of quadrature values on the host.
     */
    KernelNumberType *quadrature_value_ring_buffer_cpu;

    /**
     * Array of quadrature values on the device.
     */
    CUDAKernelNumberType *quadrature_value_ring_buffer_gpu;

    /**
     * Flag indicating if all matrix entries in all near filed \hmatrices have
     * been added as tasks to the ring buffer. If it is true, even though the
     * number of tasks in the buffer (@p task_num) is less than the total
     * number of GPU threads specified to compute the Sauter quadrature, the
     * consumer threads will get all of them directly and perform the
     * computation.
     *
     * \mynote{This flag will be set to true when all producer threads have
     * exited. After that, the consumer threads will be notified to fetch and
     * process the remaining tasks in the buffer, the number of which may be
     * smaller than the batch size.}
     */
    bool if_all_near_field_hmat_entries_added;

    /**
     * Number of tasks in a batch for fetching.
     */
    unsigned int batch_size;

    /**
     * Index of the head position in the ring buffer, which points to the
     * first task being processed.
     */
    unsigned int head_committed;

    /**
     * Index of the head position in the ring buffer, from where a task can
     * be claimed to fetch.
     */
    unsigned int head_pending;

    /**
     * Index of the tail position in the ring buffer, which points to the
     * first task being created.
     */
    unsigned int tail_committed;

    /**
     * Index of the tail position in the ring buffer, at which a new task can
     * be claimed to add.
     */
    unsigned int tail_pending;
  };

  template <int dim,
            int spacedim,
            typename RangeNumberType,
            typename KernelNumberType>
  HBEM_ATTR_HOST void
  SauterQuadratureTaskRingBuffer<dim,
                                 spacedim,
                                 RangeNumberType,
                                 KernelNumberType>::
    allocate(const CellNeighboringType neighboring_type,
             const unsigned int        batch_size_,
             const unsigned int        batch_num,
             const unsigned int        max_mapping_n_shape_functions)
  {
    static_assert(
      is_number_larger_or_equal<RangeNumberType, KernelNumberType>());
    static_assert(
      std::is_same<
        real_type,
        typename numbers::NumberTraits<KernelNumberType>::real_type>::value);

    cell_neighboring_type                = neighboring_type;
    if_all_near_field_hmat_entries_added = false;
    head_pending                         = 0;
    head_committed                       = 0;
    tail_pending                         = 0;
    tail_committed                       = 0;
    batch_size                           = batch_size_;
    capacity                             = batch_size * batch_num + 1;

    task_status_ring_buffer =
      std::make_unique<std::atomic<SauterQuadratureTaskStatus>[]>(capacity);
    fullmat_ring_buffer_cpu.resize(capacity);
    fullmat_row_index_ring_buffer_cpu.resize(capacity);
    fullmat_col_index_ring_buffer_cpu.resize(capacity);
    mass_matrix_entries_ring_buffer_cpu.resize(capacity);

    if (cell_neighboring_type != CellNeighboringType::SamePanel &&
        cell_neighboring_type != CellNeighboringType::Regular)
      {
        // Mapping support points do not need permutation when the cell
        // neighboring type is not same panel and regular.
        kx_mapping_support_points_permuted_ring_buffer_cpu.reinit(
          TableIndices<2>(capacity, max_mapping_n_shape_functions));
        AssertCuda(cudaHostRegister(
          (void *)&(kx_mapping_support_points_permuted_ring_buffer_cpu(0, 0)),
          kx_mapping_support_points_permuted_ring_buffer_cpu.n_elements() *
            sizeof(Point<spacedim, real_type>),
          cudaHostRegisterDefault));

        ky_mapping_support_points_permuted_ring_buffer_cpu.reinit(
          TableIndices<2>(capacity, max_mapping_n_shape_functions));
        AssertCuda(cudaHostRegister(
          (void *)&(ky_mapping_support_points_permuted_ring_buffer_cpu(0, 0)),
          ky_mapping_support_points_permuted_ring_buffer_cpu.n_elements() *
            sizeof(Point<spacedim, real_type>),
          cudaHostRegisterDefault));

        kx_mapping_support_points_permuted_ring_buffer_gpu.allocate(
          TableIndices<2>(capacity, max_mapping_n_shape_functions));
        ky_mapping_support_points_permuted_ring_buffer_gpu.allocate(
          TableIndices<2>(capacity, max_mapping_n_shape_functions));
      }

    AssertCuda(
      cudaMallocHost((void **)&scalar_data_ring_buffer_cpu,
                     capacity *
                       sizeof(SauterQuadratureTaskScalarDataNearField)));

    AssertCuda(
      cudaMalloc((void **)&scalar_data_ring_buffer_gpu,
                 capacity * sizeof(SauterQuadratureTaskScalarDataNearField)));

    /**
     * @internal Allocate pinned memory on the host for the quadrature values.
     */
    AssertCuda(cudaMallocHost((void **)&quadrature_value_ring_buffer_cpu,
                              capacity * sizeof(KernelNumberType)));


    AssertCuda(cudaMalloc((void **)&quadrature_value_ring_buffer_gpu,
                          capacity * sizeof(KernelNumberType)));

    /**
     * @internal Initialize task status array.
     */
    for (unsigned int i = 0; i < capacity; i++)
      {
        std::atomic_init(&task_status_ring_buffer[i],
                         SauterQuadratureTaskStatus::before_creation);
      }
  }


  template <int dim,
            int spacedim,
            typename RangeNumberType,
            typename KernelNumberType>
  HBEM_ATTR_HOST void
  SauterQuadratureTaskRingBuffer<dim,
                                 spacedim,
                                 RangeNumberType,
                                 KernelNumberType>::release()
  {
    task_status_ring_buffer.reset(nullptr);
    fullmat_ring_buffer_cpu.clear();
    fullmat_row_index_ring_buffer_cpu.clear();
    fullmat_col_index_ring_buffer_cpu.clear();
    mass_matrix_entries_ring_buffer_cpu.clear();

    if (cell_neighboring_type != CellNeighboringType::SamePanel &&
        cell_neighboring_type != CellNeighboringType::Regular)
      {
        AssertCuda(cudaHostUnregister(
          (void *)&(kx_mapping_support_points_permuted_ring_buffer_cpu(0, 0))));
        AssertCuda(cudaHostUnregister(
          (void *)&(ky_mapping_support_points_permuted_ring_buffer_cpu(0, 0))));
        kx_mapping_support_points_permuted_ring_buffer_cpu.clear();
        ky_mapping_support_points_permuted_ring_buffer_cpu.clear();
        kx_mapping_support_points_permuted_ring_buffer_gpu.release();
        ky_mapping_support_points_permuted_ring_buffer_gpu.release();
      }

    if (scalar_data_ring_buffer_cpu != nullptr)
      {
        AssertCuda(cudaFreeHost(scalar_data_ring_buffer_cpu));
      }

    if (scalar_data_ring_buffer_gpu != nullptr)
      {
        AssertCuda(cudaFree(scalar_data_ring_buffer_gpu));
      }

    if (quadrature_value_ring_buffer_cpu != nullptr)
      {
        AssertCuda(cudaFreeHost(quadrature_value_ring_buffer_cpu));
      }

    if (quadrature_value_ring_buffer_gpu != nullptr)
      {
        AssertCuda(cudaFree(quadrature_value_ring_buffer_gpu));
      }
  }


  template <int dim,
            int spacedim,
            typename RangeNumberType,
            typename KernelNumberType>
  HBEM_ATTR_HOST inline unsigned int
  SauterQuadratureTaskRingBuffer<dim,
                                 spacedim,
                                 RangeNumberType,
                                 KernelNumberType>::task_num_during_creation()
    const
  {
    /**
     * @internal Circular index should be used for computing.
     */
    return (tail_pending < tail_committed ? tail_pending + capacity :
                                            tail_pending) -
           tail_committed;
  }


  template <int dim,
            int spacedim,
            typename RangeNumberType,
            typename KernelNumberType>
  HBEM_ATTR_HOST inline unsigned int
  SauterQuadratureTaskRingBuffer<
    dim,
    spacedim,
    RangeNumberType,
    KernelNumberType>::task_num_ready_for_processing() const
  {
    return (tail_committed < head_pending ? tail_committed + capacity :
                                            tail_committed) -
           head_pending;
  }


  template <int dim,
            int spacedim,
            typename RangeNumberType,
            typename KernelNumberType>
  HBEM_ATTR_HOST inline unsigned int
  SauterQuadratureTaskRingBuffer<dim,
                                 spacedim,
                                 RangeNumberType,
                                 KernelNumberType>::task_num_during_processing()
    const
  {
    return (head_pending < head_committed ? head_pending + capacity :
                                            head_pending) -
           head_committed;
  }


  template <int dim,
            int spacedim,
            typename RangeNumberType,
            typename KernelNumberType>
  HBEM_ATTR_HOST inline unsigned int
  SauterQuadratureTaskRingBuffer<dim,
                                 spacedim,
                                 RangeNumberType,
                                 KernelNumberType>::task_num_total() const
  {
    return (tail_pending < head_committed ? tail_pending + capacity :
                                            tail_pending) -
           head_committed;
  }


  template <int dim,
            int spacedim,
            typename RangeNumberType,
            typename KernelNumberType>
  HBEM_ATTR_HOST inline unsigned int
  SauterQuadratureTaskRingBuffer<dim,
                                 spacedim,
                                 RangeNumberType,
                                 KernelNumberType>::empty_slot_num() const
  {
    return capacity - 1 - task_num_total();
  }


  template <int dim,
            int spacedim,
            typename RangeNumberType,
            typename KernelNumberType>
  HBEM_ATTR_HOST inline bool
  SauterQuadratureTaskRingBuffer<dim,
                                 spacedim,
                                 RangeNumberType,
                                 KernelNumberType>::is_full() const
  {
    return ((tail_pending + 1) >= capacity ?
              (tail_pending + 1 - capacity) :
              (tail_pending + 1)) == head_committed;
  }


  template <int dim,
            int spacedim,
            typename RangeNumberType,
            typename KernelNumberType>
  HBEM_ATTR_HOST inline bool
  SauterQuadratureTaskRingBuffer<dim,
                                 spacedim,
                                 RangeNumberType,
                                 KernelNumberType>::is_not_full() const
  {
    return ((tail_pending + 1) >= capacity ?
              (tail_pending + 1 - capacity) :
              (tail_pending + 1)) != head_committed;
  }


  template <int dim,
            int spacedim,
            typename RangeNumberType,
            typename KernelNumberType>
  HBEM_ATTR_HOST inline bool
  SauterQuadratureTaskRingBuffer<dim,
                                 spacedim,
                                 RangeNumberType,
                                 KernelNumberType>::is_empty() const
  {
    return tail_pending == head_committed;
  }


  template <int dim,
            int spacedim,
            typename RangeNumberType,
            typename KernelNumberType>
  HBEM_ATTR_HOST void
  SauterQuadratureTaskRingBuffer<dim,
                                 spacedim,
                                 RangeNumberType,
                                 KernelNumberType>::
    add_task(
      LAPACKFullMatrixExt<RangeNumberType>          *fullmat,
      const unsigned int                             fullmat_row_index,
      const unsigned int                             fullmat_col_index,
      const SauterQuadratureTaskScalarDataNearField &scalar_data,
      const real_type                                mass_matrix_entry,
      const Point<spacedim, real_type> *kx_mapping_support_points_permuted_ptr,
      const Point<spacedim, real_type> *ky_mapping_support_points_permuted_ptr,
      [[maybe_unused]] HMatrixAssemblyProfile *hmat_profile)
  {
#if ENABLE_DEBUG == 1 && MESSAGE_LEVEL >= 3
    LogStream::Prefix prefix_string(
      std::string("add_task in ") +
      std::string(cell_neighboring_type_name(cell_neighboring_type)));
#endif
#if ENABLE_NVTX == 1
    HierBEM::CUDAWrappers::NVTXRange nvtx_range(
      std::string("add_task_") +
      std::string(cell_neighboring_type_name(cell_neighboring_type)));
#endif

    /**
     * @internal The index for the task to be added.
     */
    unsigned int task_index;

    {
#if ENABLE_NVTX == 1
      HierBEM::CUDAWrappers::NVTXRange nvtx_range("wait_buffer_not_full");
#endif

      std::unique_lock<std::mutex> ul(buffer_lock);

      /**
       * @internal Wait until the number of tasks in the ring buffer is
       * smaller than its capacity minus one, i.e. there is empty space for
       * adding a new task.
       */
      buffer_not_full.wait(ul, [this]() { return this->is_not_full(); });
      task_index   = tail_pending;
      tail_pending = (tail_pending + 1) >= capacity ?
                       (tail_pending + 1 - capacity) :
                       (tail_pending + 1);

#if ENABLE_DEBUG == 1 && MESSAGE_LEVEL >= 3
      print_pointers(deallog);
#endif
    } // Release lock on the ring buffer

#if ENABLE_HMAT_ASSEMBLY_PROFILE == 1
    Timer timer;
#endif

    {
#if ENABLE_NVTX == 1
      HierBEM::CUDAWrappers::NVTXRange nvtx_range("create_task");
#endif

      /**
       * @internal Set the new task's status to @p during_creation using atomic
       * operation.
       */
      task_status_ring_buffer[task_index].store(
        SauterQuadratureTaskStatus::during_creation);

      /**
       * Create the new task:
       * 1. Copy the pointer to the current full matrix, matrix row and column
       * indices and mass matrix entry.
       * 2. Copy permuted mapping support points in \f$K_x\f$ into ring buffer
       * on the host.
       * 3. Copy permuted mapping support points in \f$K_y\f$ into ring buffer
       * on the host.
       * 4. Copy other scalar data.
       */

      /**
       * @internal Generate task data on the host, among which the full matrix
       * pointer, row and column indices of the current matrix entry and mass
       * matrix entry will only be used during quadrature result assembly,
       * hence they are only stored on the host; for local DoF indices and
       * permuted mapping support points, they exist on both the host and
       * device.
       */
      fullmat_ring_buffer_cpu[task_index]             = fullmat;
      fullmat_row_index_ring_buffer_cpu[task_index]   = fullmat_row_index;
      fullmat_col_index_ring_buffer_cpu[task_index]   = fullmat_col_index;
      mass_matrix_entries_ring_buffer_cpu[task_index] = mass_matrix_entry;
      scalar_data_ring_buffer_cpu[task_index]         = scalar_data;

      if (kx_mapping_support_points_permuted_ptr != nullptr)
        {
          for (unsigned int i = 0; i < scalar_data.kx_mapping_n_shape_functions;
               i++)
            kx_mapping_support_points_permuted_ring_buffer_cpu(task_index, i) =
              kx_mapping_support_points_permuted_ptr[i];
        }

      if (ky_mapping_support_points_permuted_ptr != nullptr)
        {
          for (unsigned int i = 0; i < scalar_data.ky_mapping_n_shape_functions;
               i++)
            ky_mapping_support_points_permuted_ring_buffer_cpu(task_index, i) =
              ky_mapping_support_points_permuted_ptr[i];
        }

      /**
       * @internal Up to now, the new task has been created on the host, set
       * its status to @p created using atomic operation, which can then be
       * fetched and processed by a consumer.
       */
      task_status_ring_buffer[task_index].store(
        SauterQuadratureTaskStatus::created);
    }

    /**
     * @internal Update ring buffer properties and notify consumer threads.
     */
    bool if_notify_consumers;

    {
#if ENABLE_NVTX == 1
      HierBEM::CUDAWrappers::NVTXRange nvtx_range("move_tail_committed");
#endif

      std::lock_guard<std::mutex> lg(buffer_lock);

      if (task_index == tail_committed)
        {
          /**
           * @internal Increment the pointer @p tail_committed until a task
           * not having been created is met or there are no added tasks either
           * during creation or created. Otherwise, do nothing.
           */
          do
            {
              tail_committed = (tail_committed + 1) >= capacity ?
                                 (tail_committed + 1 - capacity) :
                                 (tail_committed + 1);
          } while (tail_committed != tail_pending &&
                   task_status_ring_buffer[tail_committed].load() ==
                     SauterQuadratureTaskStatus::created);
        }

      /**
       * @internal When the current task is not the last one, do not
       * notify consumer threads until the number of tasks reaches the
       * batch size.
       */
      const unsigned int task_num_to_fetch = task_num_ready_for_processing();
      if (task_num_to_fetch >= batch_size ||
          (this->is_full() && task_num_to_fetch > 0))
        {
          if_notify_consumers = true;
        }
      else
        {
          if_notify_consumers = false;
        }

#if ENABLE_DEBUG == 1 && MESSAGE_LEVEL >= 3
      deallog << "Task " << task_index << " created" << std::endl;
      print_pointers(deallog);
#endif
    } // Release the ring buffer lock

    if (if_notify_consumers)
      {
        batch_task_ready.notify_all();
      }

#if ENABLE_HMAT_ASSEMBLY_PROFILE == 1
    timer.stop();
    Assert(hmat_profile != nullptr, ExcInternalError());
    hmat_profile->producer_time_per_type[cell_neighboring_type].fetch_add(
      timer.last_wall_time());
#endif
  }


  template <int dim,
            int spacedim,
            typename RangeNumberType,
            typename KernelNumberType>
  HBEM_ATTR_HOST void
  SauterQuadratureTaskRingBuffer<dim,
                                 spacedim,
                                 RangeNumberType,
                                 KernelNumberType>::
    add_tasks_from_producer_buffer(
      SauterQuadratureTaskProducerBuffer<dim, spacedim, RangeNumberType>
                &producer_buffer,
      const bool has_mass_matrix_entries)
  {
    Assert(producer_buffer.cell_neighboring_type == cell_neighboring_type,
           ExcInternalError());
    Assert(producer_buffer.capacity < capacity, ExcInternalError());

#if ENABLE_DEBUG == 1 && MESSAGE_LEVEL >= 3
    LogStream::Prefix prefix_string(std::string("transfer_tasks in ") +
                                    std::string(cell_neighboring_type_name(
                                      producer_buffer.cell_neighboring_type)));
#endif
#if ENABLE_NVTX == 1
    HierBEM::CUDAWrappers::NVTXRange nvtx_range(
      std::string("transfer_tasks_") +
      std::string(
        cell_neighboring_type_name(producer_buffer.cell_neighboring_type)));
#endif

    if (producer_buffer.task_num > 0)
      {
        unsigned int task_index_in_ring_buffer;
        {
#if ENABLE_NVTX == 1
          HierBEM::CUDAWrappers::NVTXRange nvtx_range("wait_buffer_slots");
#endif

          std::unique_lock<std::mutex> ul(buffer_lock);

          /**
           * @internal Wait for enough empty slots.
           */
          buffer_not_full.wait(ul, [this, &producer_buffer]() {
            return this->empty_slot_num() >= producer_buffer.task_num;
          });
          task_index_in_ring_buffer = tail_pending;
          tail_pending =
            (tail_pending + producer_buffer.task_num) >= capacity ?
              (tail_pending + producer_buffer.task_num - capacity) :
              (tail_pending + producer_buffer.task_num);

#if ENABLE_DEBUG == 1 && MESSAGE_LEVEL >= 3
          print_pointers(deallog);
#endif
        } // Release lock on the ring buffer

        // Transfer task data.
        unsigned int number_of_data_until_ring_buffer_end  = 0;
        unsigned int number_of_data_from_ring_buffer_start = 0;
        const bool   is_task_batch_before_ring_buffer_end =
          (task_index_in_ring_buffer + producer_buffer.task_num) <= capacity;
        if (is_task_batch_before_ring_buffer_end)
          {
            // Set tasks status to @p during_creation.
            for (unsigned int i = task_index_in_ring_buffer;
                 i < task_index_in_ring_buffer + producer_buffer.task_num;
                 i++)
              task_status_ring_buffer[i].store(
                SauterQuadratureTaskStatus::during_creation);

            std::copy(producer_buffer.fullmat_buffer.begin(),
                      producer_buffer.fullmat_buffer.begin() +
                        producer_buffer.task_num,
                      fullmat_ring_buffer_cpu.begin() +
                        task_index_in_ring_buffer);
            std::copy(producer_buffer.fullmat_row_index_buffer.begin(),
                      producer_buffer.fullmat_row_index_buffer.begin() +
                        producer_buffer.task_num,
                      fullmat_row_index_ring_buffer_cpu.begin() +
                        task_index_in_ring_buffer);
            std::copy(producer_buffer.fullmat_col_index_buffer.begin(),
                      producer_buffer.fullmat_col_index_buffer.begin() +
                        producer_buffer.task_num,
                      fullmat_col_index_ring_buffer_cpu.begin() +
                        task_index_in_ring_buffer);
            std::memcpy(scalar_data_ring_buffer_cpu + task_index_in_ring_buffer,
                        producer_buffer.scalar_data_buffer,
                        producer_buffer.task_num *
                          sizeof(SauterQuadratureTaskScalarDataNearField));

            // Mapping support points are only permuted and copied when the cell
            // neighboring type is not same panel and regular.
            if (cell_neighboring_type != CellNeighboringType::SamePanel &&
                cell_neighboring_type != CellNeighboringType::Regular)
              {
                // No matter which mapping order is used, we copy the whole
                // memory which can contain support points of the maximum
                // mapping order.
                std::memcpy(
                  &kx_mapping_support_points_permuted_ring_buffer_cpu(
                    task_index_in_ring_buffer, 0),
                  &producer_buffer.kx_mapping_support_points_permuted_buffer(0,
                                                                             0),
                  producer_buffer.task_num *
                    producer_buffer.kx_mapping_support_points_permuted_buffer
                      .size(1) *
                    sizeof(Point<spacedim, real_type>));
                std::memcpy(
                  &ky_mapping_support_points_permuted_ring_buffer_cpu(
                    task_index_in_ring_buffer, 0),
                  &producer_buffer.ky_mapping_support_points_permuted_buffer(0,
                                                                             0),
                  producer_buffer.task_num *
                    producer_buffer.ky_mapping_support_points_permuted_buffer
                      .size(1) *
                    sizeof(Point<spacedim, real_type>));
              }

            if (has_mass_matrix_entries)
              {
                std::copy(producer_buffer.mass_matrix_entries_buffer.begin(),
                          producer_buffer.mass_matrix_entries_buffer.begin() +
                            producer_buffer.task_num,
                          mass_matrix_entries_ring_buffer_cpu.begin() +
                            task_index_in_ring_buffer);
              }

            // Set tasks status to @p created.
            for (unsigned int i = task_index_in_ring_buffer;
                 i < task_index_in_ring_buffer + producer_buffer.task_num;
                 i++)
              task_status_ring_buffer[i].store(
                SauterQuadratureTaskStatus::created);
          }
        else
          {
            number_of_data_until_ring_buffer_end =
              capacity - task_index_in_ring_buffer;
            number_of_data_from_ring_buffer_start =
              producer_buffer.task_num - number_of_data_until_ring_buffer_end;

            // Set tasks status to @p during_creation.
            for (unsigned int i = task_index_in_ring_buffer; i < capacity; i++)
              task_status_ring_buffer[i].store(
                SauterQuadratureTaskStatus::during_creation);
            for (unsigned int i = 0; i < number_of_data_from_ring_buffer_start;
                 i++)
              task_status_ring_buffer[i].store(
                SauterQuadratureTaskStatus::during_creation);

            std::copy(producer_buffer.fullmat_buffer.begin(),
                      producer_buffer.fullmat_buffer.begin() +
                        number_of_data_until_ring_buffer_end,
                      fullmat_ring_buffer_cpu.begin() +
                        task_index_in_ring_buffer);
            std::copy(producer_buffer.fullmat_buffer.begin() +
                        number_of_data_until_ring_buffer_end,
                      producer_buffer.fullmat_buffer.begin() +
                        producer_buffer.task_num,
                      fullmat_ring_buffer_cpu.begin());

            std::copy(producer_buffer.fullmat_row_index_buffer.begin(),
                      producer_buffer.fullmat_row_index_buffer.begin() +
                        number_of_data_until_ring_buffer_end,
                      fullmat_row_index_ring_buffer_cpu.begin() +
                        task_index_in_ring_buffer);
            std::copy(producer_buffer.fullmat_row_index_buffer.begin() +
                        number_of_data_until_ring_buffer_end,
                      producer_buffer.fullmat_row_index_buffer.begin() +
                        producer_buffer.task_num,
                      fullmat_row_index_ring_buffer_cpu.begin());

            std::copy(producer_buffer.fullmat_col_index_buffer.begin(),
                      producer_buffer.fullmat_col_index_buffer.begin() +
                        number_of_data_until_ring_buffer_end,
                      fullmat_col_index_ring_buffer_cpu.begin() +
                        task_index_in_ring_buffer);
            std::copy(producer_buffer.fullmat_col_index_buffer.begin() +
                        number_of_data_until_ring_buffer_end,
                      producer_buffer.fullmat_col_index_buffer.begin() +
                        producer_buffer.task_num,
                      fullmat_col_index_ring_buffer_cpu.begin());

            std::memcpy(scalar_data_ring_buffer_cpu + task_index_in_ring_buffer,
                        producer_buffer.scalar_data_buffer,
                        number_of_data_until_ring_buffer_end *
                          sizeof(SauterQuadratureTaskScalarDataNearField));
            std::memcpy(scalar_data_ring_buffer_cpu,
                        producer_buffer.scalar_data_buffer +
                          number_of_data_until_ring_buffer_end,
                        number_of_data_from_ring_buffer_start *
                          sizeof(SauterQuadratureTaskScalarDataNearField));

            // Mapping support points are only permuted and copied when the cell
            // neighboring type is not same panel and regular.
            if (cell_neighboring_type != CellNeighboringType::SamePanel &&
                cell_neighboring_type != CellNeighboringType::Regular)
              {
                // No matter which mapping order is used, we copy the whole
                // memory which can contain support points of the maximum
                // mapping order.
                std::memcpy(
                  &kx_mapping_support_points_permuted_ring_buffer_cpu(
                    task_index_in_ring_buffer, 0),
                  &producer_buffer.kx_mapping_support_points_permuted_buffer(0,
                                                                             0),
                  number_of_data_until_ring_buffer_end *
                    producer_buffer.kx_mapping_support_points_permuted_buffer
                      .size(1) *
                    sizeof(Point<spacedim, real_type>));
                std::memcpy(
                  &kx_mapping_support_points_permuted_ring_buffer_cpu(0, 0),
                  &producer_buffer.kx_mapping_support_points_permuted_buffer(
                    number_of_data_until_ring_buffer_end, 0),
                  number_of_data_from_ring_buffer_start *
                    producer_buffer.kx_mapping_support_points_permuted_buffer
                      .size(1) *
                    sizeof(Point<spacedim, real_type>));

                std::memcpy(
                  &ky_mapping_support_points_permuted_ring_buffer_cpu(
                    task_index_in_ring_buffer, 0),
                  &producer_buffer.ky_mapping_support_points_permuted_buffer(0,
                                                                             0),
                  number_of_data_until_ring_buffer_end *
                    producer_buffer.ky_mapping_support_points_permuted_buffer
                      .size(1) *
                    sizeof(Point<spacedim, real_type>));
                std::memcpy(
                  &ky_mapping_support_points_permuted_ring_buffer_cpu(0, 0),
                  &producer_buffer.ky_mapping_support_points_permuted_buffer(
                    number_of_data_until_ring_buffer_end, 0),
                  number_of_data_from_ring_buffer_start *
                    producer_buffer.ky_mapping_support_points_permuted_buffer
                      .size(1) *
                    sizeof(Point<spacedim, real_type>));
              }

            if (has_mass_matrix_entries)
              {
                std::copy(producer_buffer.mass_matrix_entries_buffer.begin(),
                          producer_buffer.mass_matrix_entries_buffer.begin() +
                            number_of_data_until_ring_buffer_end,
                          mass_matrix_entries_ring_buffer_cpu.begin() +
                            task_index_in_ring_buffer);
                std::copy(producer_buffer.mass_matrix_entries_buffer.begin() +
                            number_of_data_until_ring_buffer_end,
                          producer_buffer.mass_matrix_entries_buffer.begin() +
                            producer_buffer.task_num,
                          mass_matrix_entries_ring_buffer_cpu.begin());
              }

            // Set tasks status to @p created.
            for (unsigned int i = task_index_in_ring_buffer; i < capacity; i++)
              task_status_ring_buffer[i].store(
                SauterQuadratureTaskStatus::created);
            for (unsigned int i = 0; i < number_of_data_from_ring_buffer_start;
                 i++)
              task_status_ring_buffer[i].store(
                SauterQuadratureTaskStatus::created);
          }

        bool if_notify_consumers;
        {
          std::lock_guard<std::mutex> lg(buffer_lock);

          // We use the following predicate to ensure that the pointer
          // @p tail_committed is within the batch handled by the current
          // producer.
          bool if_moving_tail_committed;
          if (is_task_batch_before_ring_buffer_end)
            {
              if (tail_committed >= task_index_in_ring_buffer &&
                  tail_committed <
                    task_index_in_ring_buffer + producer_buffer.task_num)
                if_moving_tail_committed = true;
              else
                if_moving_tail_committed = false;
            }
          else
            {
              if (tail_committed >= task_index_in_ring_buffer ||
                  tail_committed < number_of_data_from_ring_buffer_start)
                if_moving_tail_committed = true;
              else
                if_moving_tail_committed = false;
            }

          if (if_moving_tail_committed)
            {
              tail_committed =
                (task_index_in_ring_buffer + producer_buffer.task_num) >=
                    capacity ?
                  (task_index_in_ring_buffer + producer_buffer.task_num -
                   capacity) :
                  (task_index_in_ring_buffer + producer_buffer.task_num);

              while (tail_committed != tail_pending &&
                     task_status_ring_buffer[tail_committed].load() ==
                       SauterQuadratureTaskStatus::created)
                {
                  tail_committed = (tail_committed + 1) >= capacity ?
                                     (tail_committed + 1 - capacity) :
                                     (tail_committed + 1);
                }
            }

          const unsigned int task_num_to_fetch =
            task_num_ready_for_processing();
          if (task_num_to_fetch >= batch_size ||
              (is_full() && task_num_to_fetch > 0))
            {
              if_notify_consumers = true;
            }
          else
            {
              if_notify_consumers = false;
            }

#if ENABLE_DEBUG == 1 && MESSAGE_LEVEL >= 3
          deallog << "Tasks [" << task_index_in_ring_buffer << ", "
                  << task_index_in_ring_buffer + producer_buffer.task_num
                  << ") are created" << std::endl;
          print_pointers(deallog);
#endif
        } // Release the buffer lock

        if (if_notify_consumers)
          {
            batch_task_ready.notify_all();
          }
      }
  }


  template <int dim,
            int spacedim,
            typename RangeNumberType,
            typename KernelNumberType>
  template <template <int, typename> typename KernelFunctionType>
  HBEM_ATTR_HOST bool
  SauterQuadratureTaskRingBuffer<dim,
                                 spacedim,
                                 RangeNumberType,
                                 KernelNumberType>::
    fetch_and_process_task_batch(
      const KernelFunctionType<spacedim, CUDAKernelNumberType> &kernel,
      const CUDAKernelNumberType                                kernel_factor,
      const unsigned int                                        block_size,
      const CUDABEMValues<dim, spacedim, real_type>            &bem_values,
      const cudaStream_t                       cuda_stream_handle,
      [[maybe_unused]] HMatrixAssemblyProfile *hmat_profile)
  {
#if ENABLE_DEBUG == 1 && MESSAGE_LEVEL >= 3
    LogStream::Prefix prefix_string(
      std::string("process_task in ") +
      std::string(cell_neighboring_type_name(cell_neighboring_type)));
#endif
#if ENABLE_NVTX == 1
    HierBEM::CUDAWrappers::NVTXRange nvtx_range(
      std::string("fetch_and_process_task_batch_") +
      std::string(cell_neighboring_type_name(cell_neighboring_type)));
#endif

    bool         is_finished;
    unsigned int task_num_to_fetch;
    unsigned int task_start_index_to_fetch = 0;

    {
#if ENABLE_NVTX == 1
      HierBEM::CUDAWrappers::NVTXRange nvtx_range("wait_task_batch_ready");
#endif

      std::unique_lock<std::mutex> ul(buffer_lock);

      batch_task_ready.wait(ul, [&task_num_to_fetch, this]() {
        task_num_to_fetch = task_num_ready_for_processing();
        if (if_all_near_field_hmat_entries_added ||
            (task_num_to_fetch >= batch_size) ||
            (this->is_full() && task_num_to_fetch > 0))
          {
            /**
             * @internal When all quadrature tasks have been added, the
             * consumer does not wait for a whole batch of tasks but will
             * directly process the remaining tasks in the buffer.
             *
             * If all quadrature tasks have not been added, only when the
             * number of ready tasks is larger than or equal to the batch
             * size, they will be fetched and processed by the consumer
             * thread.
             */
            return true;
          }
        else
          {
            return false;
          }
      });

      if (task_num_to_fetch > batch_size)
        {
          task_num_to_fetch = batch_size;
        }

      if (if_all_near_field_hmat_entries_added && task_num_to_fetch == 0)
        {
          /**
           * @internal When all tasks have been added and there are no more
           * tasks to be fetched, the current consumer thread should exit.
           */
          is_finished = true;
        }
      else
        {
          is_finished = false;

          task_start_index_to_fetch = head_pending;
          head_pending = (head_pending + task_num_to_fetch) >= capacity ?
                           (head_pending + task_num_to_fetch - capacity) :
                           (head_pending + task_num_to_fetch);
        }

#if ENABLE_DEBUG == 1 && MESSAGE_LEVEL >= 3
      print_pointers(deallog);
#endif
    } // Release the buffer lock

#if ENABLE_HMAT_ASSEMBLY_PROFILE == 1
    Timer timer;
#endif

    if (is_finished)
      {
        return is_finished;
      }
    else
      {
#if ENABLE_NVTX == 1
        HierBEM::CUDAWrappers::NVTXRange nvtx_range("process_task_batch");
#endif

        /**
         * @internal When the data in the ring buffer are not
         * contiguous, we should perform two times of memory copy.
         */
        unsigned int number_of_data_until_ring_buffer_end  = 0;
        unsigned int number_of_data_from_ring_buffer_start = 0;
        const bool   is_task_batch_before_buffer_end =
          (task_start_index_to_fetch + task_num_to_fetch) <= capacity;

        /**
         * Set task status to be @p during_processing.
         */
        if (is_task_batch_before_buffer_end)
          {
            for (unsigned int i = task_start_index_to_fetch;
                 i < task_start_index_to_fetch + task_num_to_fetch;
                 i++)
              {
                Assert(task_status_ring_buffer[i].load() ==
                         SauterQuadratureTaskStatus::created,
                       ExcInternalError());

                task_status_ring_buffer[i].store(
                  SauterQuadratureTaskStatus::during_processing);
              }
          }
        else
          {
            number_of_data_until_ring_buffer_end =
              capacity - task_start_index_to_fetch;
            number_of_data_from_ring_buffer_start =
              task_num_to_fetch - number_of_data_until_ring_buffer_end;

            for (unsigned int i = task_start_index_to_fetch; i < capacity; i++)
              {
                Assert(task_status_ring_buffer[i].load() ==
                         SauterQuadratureTaskStatus::created,
                       ExcInternalError());

                task_status_ring_buffer[i].store(
                  SauterQuadratureTaskStatus::during_processing);
              }

            for (unsigned int i = 0; i < number_of_data_from_ring_buffer_start;
                 i++)
              {
                Assert(task_status_ring_buffer[i].load() ==
                         SauterQuadratureTaskStatus::created,
                       ExcInternalError());

                task_status_ring_buffer[i].store(
                  SauterQuadratureTaskStatus::during_processing);
              }
          }

        /**
         * @internal Copy task data in batch from host to device.
         */
        if (is_task_batch_before_buffer_end)
          {
            // Mapping support points are only permuted and copied when the cell
            // neighboring type is not same panel and regular.
            if (cell_neighboring_type != CellNeighboringType::SamePanel &&
                cell_neighboring_type != CellNeighboringType::Regular)
              {
                // The mapping orders of kx or ky may be different in different
                // quadrature tasks, hence the numbers of mapping support points
                // in these tasks may also be different.
                // @p kx_mapping_support_points_permuted_ring_buffer_cpu is
                // allocated enough memory to hold the support points of the
                // highest order of mapping, here we copy this whole memory from
                // the host to device.
                kx_mapping_support_points_permuted_ring_buffer_gpu
                  .assign_from_host(
                    &(kx_mapping_support_points_permuted_ring_buffer_cpu(
                      task_start_index_to_fetch, 0)),
                    kx_mapping_support_points_permuted_ring_buffer_gpu.offset(
                      task_start_index_to_fetch, 0),
                    task_num_to_fetch *
                      kx_mapping_support_points_permuted_ring_buffer_cpu.size(
                        1),
                    cuda_stream_handle);

                ky_mapping_support_points_permuted_ring_buffer_gpu
                  .assign_from_host(
                    &(ky_mapping_support_points_permuted_ring_buffer_cpu(
                      task_start_index_to_fetch, 0)),
                    ky_mapping_support_points_permuted_ring_buffer_gpu.offset(
                      task_start_index_to_fetch, 0),
                    task_num_to_fetch *
                      ky_mapping_support_points_permuted_ring_buffer_cpu.size(
                        1),
                    cuda_stream_handle);
              }

            AssertCuda(cudaMemcpyAsync(
              (void *)(scalar_data_ring_buffer_gpu + task_start_index_to_fetch),
              (const void *)(scalar_data_ring_buffer_cpu +
                             task_start_index_to_fetch),
              sizeof(SauterQuadratureTaskScalarDataNearField) *
                task_num_to_fetch,
              cudaMemcpyHostToDevice,
              cuda_stream_handle));
          }
        else
          {
            // Mapping support points are only permuted and copied when the cell
            // neighboring type is not same panel and regular.
            if (cell_neighboring_type != CellNeighboringType::SamePanel &&
                cell_neighboring_type != CellNeighboringType::Regular)
              {
                kx_mapping_support_points_permuted_ring_buffer_gpu
                  .assign_from_host(
                    &(kx_mapping_support_points_permuted_ring_buffer_cpu(
                      task_start_index_to_fetch, 0)),
                    kx_mapping_support_points_permuted_ring_buffer_gpu.offset(
                      task_start_index_to_fetch, 0),
                    number_of_data_until_ring_buffer_end *
                      kx_mapping_support_points_permuted_ring_buffer_cpu.size(
                        1),
                    cuda_stream_handle);

                ky_mapping_support_points_permuted_ring_buffer_gpu
                  .assign_from_host(
                    &(ky_mapping_support_points_permuted_ring_buffer_cpu(
                      task_start_index_to_fetch, 0)),
                    ky_mapping_support_points_permuted_ring_buffer_gpu.offset(
                      task_start_index_to_fetch, 0),
                    number_of_data_until_ring_buffer_end *
                      ky_mapping_support_points_permuted_ring_buffer_cpu.size(
                        1),
                    cuda_stream_handle);

                kx_mapping_support_points_permuted_ring_buffer_gpu
                  .assign_from_host(
                    &(kx_mapping_support_points_permuted_ring_buffer_cpu(0, 0)),
                    kx_mapping_support_points_permuted_ring_buffer_gpu.offset(
                      0, 0),
                    number_of_data_from_ring_buffer_start *
                      kx_mapping_support_points_permuted_ring_buffer_cpu.size(
                        1),
                    cuda_stream_handle);

                ky_mapping_support_points_permuted_ring_buffer_gpu
                  .assign_from_host(
                    &(ky_mapping_support_points_permuted_ring_buffer_cpu(0, 0)),
                    ky_mapping_support_points_permuted_ring_buffer_gpu.offset(
                      0, 0),
                    number_of_data_from_ring_buffer_start *
                      ky_mapping_support_points_permuted_ring_buffer_cpu.size(
                        1),
                    cuda_stream_handle);
              }

            AssertCuda(cudaMemcpyAsync(
              (void *)(scalar_data_ring_buffer_gpu + task_start_index_to_fetch),
              (const void *)(scalar_data_ring_buffer_cpu +
                             task_start_index_to_fetch),
              sizeof(SauterQuadratureTaskScalarDataNearField) *
                number_of_data_until_ring_buffer_end,
              cudaMemcpyHostToDevice,
              cuda_stream_handle));

            AssertCuda(
              cudaMemcpyAsync((void *)scalar_data_ring_buffer_gpu,
                              (const void *)scalar_data_ring_buffer_cpu,
                              sizeof(SauterQuadratureTaskScalarDataNearField) *
                                number_of_data_from_ring_buffer_start,
                              cudaMemcpyHostToDevice,
                              cuda_stream_handle));
          }

        /**
         * @internal Recalculate the number of thread blocks to be used,
         * since the actual number of tasks may be smaller than the
         * originally expected.
         */
        const unsigned int block_num =
          (task_num_to_fetch + block_size - 1) / block_size;

        /**
         * Perform Sauter quadrature.
         *
         * N.B. In reality, because four ring buffers have been created
         * for the four cell neighboring types, the current cell
         * neighboring type is definite and only one case below is
         * reachable.
         */
        switch (cell_neighboring_type)
          {
              case CellNeighboringType::SamePanel: {
                process_near_field_sauter_task_batch_same_panel<<<
                  block_num,
                  block_size,
                  0,
                  cuda_stream_handle>>>(kernel,
                                        kernel_factor,
                                        capacity,
                                        scalar_data_ring_buffer_gpu,
                                        quadrature_value_ring_buffer_gpu,
                                        task_start_index_to_fetch,
                                        task_num_to_fetch,
                                        bem_values);

                break;
              }
              case CellNeighboringType::CommonEdge: {
                process_near_field_sauter_task_batch_common_edge<<<
                  block_num,
                  block_size,
                  0,
                  cuda_stream_handle>>>(
                  kernel,
                  kernel_factor,
                  capacity,
                  kx_mapping_support_points_permuted_ring_buffer_gpu,
                  ky_mapping_support_points_permuted_ring_buffer_gpu,
                  scalar_data_ring_buffer_gpu,
                  quadrature_value_ring_buffer_gpu,
                  task_start_index_to_fetch,
                  task_num_to_fetch,
                  bem_values);

                break;
              }
              case CellNeighboringType::CommonVertex: {
                process_near_field_sauter_task_batch_common_vertex<<<
                  block_num,
                  block_size,
                  0,
                  cuda_stream_handle>>>(
                  kernel,
                  kernel_factor,
                  capacity,
                  kx_mapping_support_points_permuted_ring_buffer_gpu,
                  ky_mapping_support_points_permuted_ring_buffer_gpu,
                  scalar_data_ring_buffer_gpu,
                  quadrature_value_ring_buffer_gpu,
                  task_start_index_to_fetch,
                  task_num_to_fetch,
                  bem_values);

                break;
              }
              case CellNeighboringType::Regular: {
                process_near_field_sauter_task_batch_regular<<<
                  block_num,
                  block_size,
                  0,
                  cuda_stream_handle>>>(kernel,
                                        kernel_factor,
                                        capacity,
                                        scalar_data_ring_buffer_gpu,
                                        quadrature_value_ring_buffer_gpu,
                                        task_start_index_to_fetch,
                                        task_num_to_fetch,
                                        bem_values);

                break;
              }
              default: {
                Assert(false, ExcInternalError());

                break;
              }
          }

            // Copy the quadrature result data from the device to the host.
#if ENABLE_NVTX == 1
        nvtxRangePush("assemble_quad");
#endif
        if (is_task_batch_before_buffer_end)
          {
            /**
             * @internal When the data in the ring buffer are in a
             * contiguous block, perform one time of memory copy.
             */
            AssertCuda(
              cudaMemcpyAsync((void *)(quadrature_value_ring_buffer_cpu +
                                       task_start_index_to_fetch),
                              (const void *)(quadrature_value_ring_buffer_gpu +
                                             task_start_index_to_fetch),
                              task_num_to_fetch * sizeof(KernelNumberType),
                              cudaMemcpyDeviceToHost,
                              cuda_stream_handle));


            /**
             * @internal This synchronize ensures the completion of all memory
             * operations and kernel executions in the current CUDA stream.
             */
            AssertCuda(cudaStreamSynchronize(cuda_stream_handle));

            /**
             * Assemble the result to full matrix in \hmatrix node.
             */
            for (unsigned int i = task_start_index_to_fetch;
                 i < task_start_index_to_fetch + task_num_to_fetch;
                 i++)
              {
                RangeNumberType &entry = (*fullmat_ring_buffer_cpu[i])(
                  fullmat_row_index_ring_buffer_cpu[i],
                  fullmat_col_index_ring_buffer_cpu[i]);

                if constexpr (numbers::NumberTraits<
                                RangeNumberType>::is_complex)
                  {
                    real_type *raw_ptr = reinterpret_cast<real_type *>(&entry);
                    std::atomic_ref<real_type> real_part(raw_ptr[0]);

                    if constexpr (numbers::NumberTraits<
                                    KernelNumberType>::is_complex)
                      {
                        KernelNumberType update_value =
                          quadrature_value_ring_buffer_cpu[i] +
                          mass_matrix_entries_ring_buffer_cpu[i];
                        std::atomic_ref<real_type> imag_part(raw_ptr[1]);
                        real_part.fetch_add(update_value.real(),
                                            std::memory_order_relaxed);
                        imag_part.fetch_add(update_value.imag(),
                                            std::memory_order_relaxed);
                      }
                    else
                      {
                        real_type update_value =
                          quadrature_value_ring_buffer_cpu[i] +
                          mass_matrix_entries_ring_buffer_cpu[i];
                        real_part.fetch_add(update_value,
                                            std::memory_order_relaxed);
                      }
                  }
                else
                  {
                    std::atomic_ref<RangeNumberType> atomic_entry(entry);
                    RangeNumberType                  update_value =
                      quadrature_value_ring_buffer_cpu[i] +
                      mass_matrix_entries_ring_buffer_cpu[i];
                    atomic_entry.fetch_add(update_value);
                  }

                /**
                 * @internal Reset the task status to @p before_creation.
                 */
                task_status_ring_buffer[i].store(
                  SauterQuadratureTaskStatus::before_creation);
              }
          }
        else
          {
            AssertCuda(
              cudaMemcpyAsync((void *)(quadrature_value_ring_buffer_cpu +
                                       task_start_index_to_fetch),
                              (const void *)(quadrature_value_ring_buffer_gpu +
                                             task_start_index_to_fetch),
                              number_of_data_until_ring_buffer_end *
                                sizeof(KernelNumberType),
                              cudaMemcpyDeviceToHost,
                              cuda_stream_handle));


            AssertCuda(
              cudaMemcpyAsync((void *)(quadrature_value_ring_buffer_cpu),
                              (const void *)(quadrature_value_ring_buffer_gpu),
                              number_of_data_from_ring_buffer_start *
                                sizeof(KernelNumberType),
                              cudaMemcpyDeviceToHost,
                              cuda_stream_handle));


            /**
             * @internal This synchronize ensures the completion of all memory
             * operations and kernel executions in the current CUDA stream.
             */
            AssertCuda(cudaStreamSynchronize(cuda_stream_handle));

            /**
             * Assemble the result to full matrix in \hmatrix node.
             */
            for (unsigned int i = task_start_index_to_fetch; i < capacity; i++)
              {
                RangeNumberType &entry = (*fullmat_ring_buffer_cpu[i])(
                  fullmat_row_index_ring_buffer_cpu[i],
                  fullmat_col_index_ring_buffer_cpu[i]);

                if constexpr (numbers::NumberTraits<
                                RangeNumberType>::is_complex)
                  {
                    real_type *raw_ptr = reinterpret_cast<real_type *>(&entry);
                    std::atomic_ref<real_type> real_part(raw_ptr[0]);

                    if constexpr (numbers::NumberTraits<
                                    KernelNumberType>::is_complex)
                      {
                        KernelNumberType update_value =
                          quadrature_value_ring_buffer_cpu[i] +
                          mass_matrix_entries_ring_buffer_cpu[i];
                        std::atomic_ref<real_type> imag_part(raw_ptr[1]);
                        real_part.fetch_add(update_value.real(),
                                            std::memory_order_relaxed);
                        imag_part.fetch_add(update_value.imag(),
                                            std::memory_order_relaxed);
                      }
                    else
                      {
                        real_type update_value =
                          quadrature_value_ring_buffer_cpu[i] +
                          mass_matrix_entries_ring_buffer_cpu[i];
                        real_part.fetch_add(update_value,
                                            std::memory_order_relaxed);
                      }
                  }
                else
                  {
                    std::atomic_ref<RangeNumberType> atomic_entry(entry);
                    RangeNumberType                  update_value =
                      quadrature_value_ring_buffer_cpu[i] +
                      mass_matrix_entries_ring_buffer_cpu[i];
                    atomic_entry.fetch_add(update_value);
                  }

                /**
                 * @internal Reset the task status to @p before_creation.
                 */
                task_status_ring_buffer[i].store(
                  SauterQuadratureTaskStatus::before_creation);
              }

            for (unsigned int i = 0; i < number_of_data_from_ring_buffer_start;
                 i++)
              {
                RangeNumberType &entry = (*fullmat_ring_buffer_cpu[i])(
                  fullmat_row_index_ring_buffer_cpu[i],
                  fullmat_col_index_ring_buffer_cpu[i]);

                if constexpr (numbers::NumberTraits<
                                RangeNumberType>::is_complex)
                  {
                    real_type *raw_ptr = reinterpret_cast<real_type *>(&entry);
                    std::atomic_ref<real_type> real_part(raw_ptr[0]);

                    if constexpr (numbers::NumberTraits<
                                    KernelNumberType>::is_complex)
                      {
                        KernelNumberType update_value =
                          quadrature_value_ring_buffer_cpu[i] +
                          mass_matrix_entries_ring_buffer_cpu[i];
                        std::atomic_ref<real_type> imag_part(raw_ptr[1]);
                        real_part.fetch_add(update_value.real(),
                                            std::memory_order_relaxed);
                        imag_part.fetch_add(update_value.imag(),
                                            std::memory_order_relaxed);
                      }
                    else
                      {
                        real_type update_value =
                          quadrature_value_ring_buffer_cpu[i] +
                          mass_matrix_entries_ring_buffer_cpu[i];
                        real_part.fetch_add(update_value,
                                            std::memory_order_relaxed);
                      }
                  }
                else
                  {
                    std::atomic_ref<RangeNumberType> atomic_entry(entry);
                    RangeNumberType                  update_value =
                      quadrature_value_ring_buffer_cpu[i] +
                      mass_matrix_entries_ring_buffer_cpu[i];
                    atomic_entry.fetch_add(update_value);
                  }

                /**
                 * @internal Reset the task status to @p before_creation.
                 */
                task_status_ring_buffer[i].store(
                  SauterQuadratureTaskStatus::before_creation);
              }
          }
#if ENABLE_NVTX == 1
        nvtxRangePop(); // NVTX range: assemble_quad
#endif

        {
          std::lock_guard<std::mutex> lg(buffer_lock);

          // We use the following predicate to ensure that the pointer
          // @p head_committed is within the batch handled by the current
          // consumer.
          bool if_moving_head_committed;
          if (is_task_batch_before_buffer_end)
            {
              if (head_committed >= task_start_index_to_fetch &&
                  head_committed <
                    task_start_index_to_fetch + task_num_to_fetch)
                if_moving_head_committed = true;
              else
                if_moving_head_committed = false;
            }
          else
            {
              if (head_committed >= task_start_index_to_fetch ||
                  head_committed < number_of_data_from_ring_buffer_start)
                if_moving_head_committed = true;
              else
                if_moving_head_committed = false;
            }


          if (if_moving_head_committed)
            {
              // When @p head_committed is in the range of the current batch and
              // all @p task_num_to_fetch tasks in this batch have been
              // processed by the current consumer, we can set the pointer
              // @p head_committed directly to one index pass the final task in
              // this batch.
              head_committed =
                (task_start_index_to_fetch + task_num_to_fetch) >= capacity ?
                  (task_start_index_to_fetch + task_num_to_fetch - capacity) :
                  (task_start_index_to_fetch + task_num_to_fetch);

              // Then we increment the pointer @p head_committed one step at a
              // time to check the task status, since we're now entering the
              // batch which is during processing or has been fully or partially
              // processed by another consumer.
              while (head_committed != head_pending &&
                     task_status_ring_buffer[head_committed].load() ==
                       SauterQuadratureTaskStatus::before_creation)
                {
                  head_committed = (head_committed + 1) >= capacity ?
                                     (head_committed + 1 - capacity) :
                                     (head_committed + 1);
                }
            }

#if ENABLE_DEBUG == 1 && MESSAGE_LEVEL >= 3
          deallog << "Tasks [" << task_start_index_to_fetch << ", "
                  << task_start_index_to_fetch + task_num_to_fetch
                  << ") are processed" << std::endl;
          print_pointers(deallog);
#endif
        } // Release the buffer lock
      }

    /**
     * @internal When a batch of tasks have been processed by a consumer
     * thread, there are a large amount of empty spaces into which new tasks
     * can be inserted. Therefore, we use notify all producer threads to try to
     * start working.
     */
    buffer_not_full.notify_all();

#if ENABLE_HMAT_ASSEMBLY_PROFILE == 1
    timer.stop();
    Assert(hmat_profile != nullptr, ExcInternalError());
    hmat_profile->consumer_time_per_type[cell_neighboring_type].fetch_add(
      timer.last_wall_time());
#endif

    return is_finished;
  }


  template <int dim,
            int spacedim,
            typename RangeNumberType,
            typename KernelNumberType>
  void
  SauterQuadratureTaskRingBuffer<
    dim,
    spacedim,
    RangeNumberType,
    KernelNumberType>::print_pointers(LogStream &log_stream) const
  {
    log_stream << "head_committed=" << head_committed
               << ", head_pending=" << head_pending
               << ", tail_committed=" << tail_committed
               << ", tail_pending=" << tail_pending << std::endl;
  }
} // namespace CUDAWrappers

HBEM_NS_CLOSE

#endif // HIERBEM_INCLUDE_QUADRATURE_SAUTER_QUADRATURE_TASK_RING_BUFFER_H_
