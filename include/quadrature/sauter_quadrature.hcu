            threadIdx.y, current_quad_point_index, 0, 0)),
          spacedim,
          dim);
        BEMTools::CUDAWrappers::surface_covariant_transformation(
          threadIdx.y,
          current_quad_point_index,
          bem_values.kx_mapping_shape_grad_matrix_table_for_common_vertex,
          kx_mapping_index,
